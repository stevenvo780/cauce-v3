#!/usr/bin/env bash
# cauce-tmux-panel <alias> — crea la sesión tmux compartida de un alias de contenedor.
#
# Por qué existe: arrancar el adaptador NO crea la TUI. Sin TUI, su preflight deja al alias en
# `tui_absent` y todo lo que llegue por Telegram o por el bus cae en una conversación que el dueño
# no ve. Hasta hoy la sesión sólo nacía cuando alguien entraba con `cauce <alias>`, así que tras un
# reinicio de la torre los catorce alias de contenedor subían degradados y nadie se enteraba.
#
# Es idempotente: `ensure` no toca la sesión si ya existe.
set -uo pipefail
A=${1:?uso: cauce-tmux-panel <alias>}
OPS=$HOME/.local/share/cauce-v3/ops
CONFIG=$HOME/.config/cauce-v3/container-aliases

grep -qx 'SHARED_SESSION=1' "$CONFIG/$A.env" 2>/dev/null || {
  echo "$A no tiene sesión compartida configurada: no hay panel que crear"; exit 0; }

LINE=$(PYTHONDONTWRITEBYTECODE=1 python3 "$OPS/scripts/container-alias-query.py" "$A" 2>/dev/null) || {
  echo "alias desconocido: $A" >&2; exit 1; }
IFS=$'\t' read -r _ _ CTR CUSER _ _ HARNESS _ <<<"$LINE"

RELEASE=$(sed -n 's/^BUNDLE_RELEASE=//p' "$CONFIG/$A.env" | head -1)
[ -n "$RELEASE" ] || { echo "$A sin BUNDLE_RELEASE" >&2; exit 1; }
HELPER="/opt/cauce-v3-adapter/$A/releases/$RELEASE/packages/adapter-sdk/dist/src/bin/shared-session.js"
WS=$(sed -n 's/^SHARED_SESSION_WORKSPACE=//p' "$CONFIG/$A.env" | head -1)

# El bundle lo copia el supervisor al arrancar. En un arranque en frío puede tardar: se espera,
# porque fallar aquí deja al alias sin panel el resto del día.
for _ in $(seq 1 30); do
  docker exec --user "$CUSER" "$CTR" test -f "$HELPER" 2>/dev/null && break
  sleep 2
done
docker exec --user "$CUSER" "$CTR" test -f "$HELPER" 2>/dev/null || {
  echo "$A: el helper no aparecio en 60s ($HELPER)" >&2; exit 1; }

docker exec --user "$CUSER" "$CTR" node "$HELPER" ensure \
  --alias "$A" --harness "$HARNESS" --workspace "${WS:-/workspace}"
