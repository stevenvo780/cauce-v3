{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/telegram-manual-replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "phase", "generatedAt", "appliedCount", "alreadyApplied", "replaySequence", "effectSha256", "evidenceSha256", "duplicateRisk", "warning"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "cauce-v3-telegram-manual-replay" },
    "phase": { "const": "scheduled" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "appliedCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "alreadyApplied": { "type": "boolean" },
    "replaySequence": { "type": "integer", "minimum": 1 },
    "effectSha256": { "$ref": "#/$defs/sha256" },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "duplicateRisk": { "type": "boolean" },
    "warning": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
