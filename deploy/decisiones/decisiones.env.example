# /etc/cauce-v3/decisiones.env (root:root 0600). desplegar.sh lo genera desde prod.env la primera vez.
# Sólo rutas y parámetros: ningún secreto va escrito en este fichero.
CAUCE_DECISIONES_IMAGE=cauce-decisiones:<commit>
CAUCE_PRIVATE_BIND_IP=100.64.0.11
CAUCE_DECISIONES_TLS_PORT=8447
CAUCE_GATEWAY_TLS_CERT_PATH=/etc/cauce-v3/pki/gateway.crt
CAUCE_GATEWAY_TLS_KEY_PATH=/etc/cauce-v3/pki/gateway.key
CAUCE_GATEWAY_CLIENT_CA_PATH=/etc/cauce-v3/pki/ca.crt
CAUCE_GATEWAY_IDENTITY_DIR=/etc/cauce-v3/secrets/identities
CAUCE_TYPESAFE_JEV_KEY_PATH=/etc/cauce-v3/secrets/typesafe-jev.key
# Piloto: sólo estos alias pueden preguntar. Ampliar de a uno. Vacío = nadie; `*` = todos los de los tenants de abajo.
CAUCE_DECISIONES_ALIASES=zeus
# Tenants cuyos agentes gastan la clave de Jev de Steven y mandan su state a TypeSafe. Uno por uno, sin comodín.
CAUCE_DECISIONES_TENANTS=Steven
# Plantillas que exigen visto bueno explícito (datos que salen a TypeSafe). Vacío = apagadas.
CAUCE_DECISIONES_HABILITAR_PLANTILLAS=
CAUCE_DECISIONES_JEV_MODEL=jev-latest
