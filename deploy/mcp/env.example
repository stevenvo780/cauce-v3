# Copy to a private file outside the repository and fill only with approved values.
# These placeholders intentionally fail configuration validation; do not deploy this file.
CAUCE_GATEWAY_ORIGIN=REPLACE_WITH_HTTPS_GATEWAY_ORIGIN
CAUCE_MCP_PUBLIC_ORIGIN=REPLACE_WITH_HTTPS_PUBLIC_ORIGIN
CAUCE_MCP_TENANT_ID=REPLACE_WITH_ALLOWED_TENANT
CAUCE_MCP_AUTH_MODE=oauth
CAUCE_MCP_OAUTH_ISSUER=REPLACE_WITH_HTTPS_OAUTH_ISSUER
CAUCE_MCP_OAUTH_JWKS_URI=REPLACE_WITH_HTTPS_OAUTH_JWKS_URI
CAUCE_MCP_OAUTH_SUBJECT=REPLACE_WITH_ONE_AUTHORIZED_SUBJECT
CAUCE_GATEWAY_CERT_FILE=/run/mcp-gateway/tls/client.crt
CAUCE_GATEWAY_KEY_FILE=/run/mcp-gateway/tls/client.key
CAUCE_GATEWAY_CA_FILE=/run/mcp-gateway/tls/ca.crt
CAUCE_MCP_PORT=3101
