#!/usr/bin/env bash
# Shared terminals use the same native session as their adapter.
set -uo pipefail
cli_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
[[ -n "$cli_home" && -d "$cli_home" ]] || cli_home=$HOME
OPS=$cli_home/.local/share/cauce-v3/ops
BIN=$cli_home/.local/bin
CONFIG=$cli_home/.config/cauce-v3/container-aliases
TMUX_SOCKET=cauce

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_dim=$'\033[90m'
c_ok=$'\033[32m'; c_warn=$'\033[33m'; c_err=$'\033[31m'
alias_info() {  # $1=alias -> "tenant\troom\tcontenedor\tusuario\thome\tstate\tharness"
  PYTHONDONTWRITEBYTECODE=1 python3 "$OPS/scripts/container-alias-query.py" "$1" 2>/dev/null
}
todos_los_alias() {
  for f in "$CONFIG"/*.env; do
    [ -e "$f" ] || continue; basename "$f" .env
  done | sort
}
adaptador_activo() {
  local e
  e=$(systemctl --user is-active "cauce-v3-container-$1.service" 2>/dev/null)
  if [ "$e" != active ] && systemctl --user cat "cauce-v3-host-$1.service" >/dev/null 2>&1; then
    systemctl --user is-active "cauce-v3-host-$1.service" 2>/dev/null
  else
    printf '%s\n' "$e"
  fi
}
compartida_configurada() {
  [ -f "$CONFIG/$1.env" ] && grep -qx 'SHARED_SESSION=1' "$CONFIG/$1.env" && return 0
  # kant es host-native: no tiene contenedor y su interruptor vive en la UNIT, no en el .env.
  # Sin esta rama el CLI lo daba por "aparte" teniendo la sesion compartida encendida y andando.
  es_host_native "$1" && systemctl --user show "cauce-v3-host-$1.service" -p Environment --value 2>/dev/null \
    | tr ' ' '\n' | grep -qx 'CAUCE_SHARED_SESSION=1'
}
es_host_native() {
  systemctl --user cat "cauce-v3-host-$1.service" >/dev/null 2>&1
}
helper_en_contenedor() {  # $1=alias
  if es_host_native "$1"; then
    systemctl --user cat "cauce-v3-host-$1.service" 2>/dev/null \
      | sed -n 's|^ExecStart=.*node \(.*\)/packages/adapter-sdk/dist/src/bin/.*|\1/packages/adapter-sdk/dist/src/bin/shared-session.js|p' \
      | head -1 | sed "s|^~|$cli_home|; s|^%h|$cli_home|"
    return 0
  fi
  local release
  release=$(sed -n 's/^BUNDLE_RELEASE=//p' "$CONFIG/$1.env" 2>/dev/null | head -1)
  [ -n "$release" ] || return 1
  printf '/opt/cauce-v3-adapter/%s/releases/%s/packages/adapter-sdk/dist/src/bin/shared-session.js\n' "$1" "$release"
}
credencial_env_de() {  # $1=alias $2=harness  -> "VAR=valor", o nada
  local h key
  case "$2" in codex) key=CODEX_HOME ;; claude) key=CLAUDE_CONFIG_DIR ;; *) return 0 ;; esac
  if es_host_native "$1"; then
    h=$(systemctl --user show "cauce-v3-host-$1.service" -p Environment --value 2>/dev/null | python3 -c 'import shlex,sys; values=dict(item.split("=",1) for item in shlex.split(sys.stdin.read())); sys.stdout.write(values.get(sys.argv[1],""))' "$key") || return 1
    [ -n "$h" ] && printf '%s=%s\n' "$key" "$h"
    return 0
  fi
  h=$(sed -n 's/^CREDENTIAL_HOME=//p' "$CONFIG/$1.env" 2>/dev/null | head -1)
  [ -n "$h" ] || return 0
  printf '%s=%s\n' "$key" "$h"
}
modo_permisos_de() {  # $1=alias $2=harness  -> "VAR=valor", o nada
  local m
  [ "$2" = claude ] || return 0
  m=$(sed -n 's/^CLAUDE_PERMISSION_MODE=//p' "$CONFIG/$1.env" 2>/dev/null | head -1)
  [ -n "$m" ] || return 0
  printf 'CAUCE_CLAUDE_PERMISSION_MODE=%s\n' "$m"
}
sesion() {  # $1=accion $2=alias $3=contenedor $4=usuario $5=harness $6=state
  local helper ws panel cred modo
  local -a env_cred=()
  helper=$(helper_en_contenedor "$2") || return 3
  if es_host_native "$2"; then
    [ -f "$helper" ] || return 3
    if [ "$1" = ensure ]; then
      panel=$(systemctl --user show "cauce-v3-tmux-$2.service" -p ExecStart --value 2>/dev/null \
              | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -1)
      if [ -n "$panel" ] && [ -x "$panel" ]; then
        "$panel"
        return $?
      fi
    fi
    ws=$(systemctl --user show "cauce-v3-host-$2.service" -p Environment --value 2>/dev/null \
         | tr ' ' '\n' | sed -n 's/^CAUCE_SHARED_SESSION_WORKSPACE=//p' | head -1)
    cred=$(credencial_env_de "$2" "$5"); [ -n "$cred" ] && env_cred=("$cred")
    modo=$(modo_permisos_de "$2" "$5"); [ -n "$modo" ] && env_cred+=("$modo")
    env "${env_cred[@]}" node "$helper" "$1" --alias "$2" --harness "$5" \
      --workspace "${ws:-$HOME}" --state "$6"
    return $?
  fi
  docker exec --user "$4" "$3" test -f "$helper" || return 3
  # El `docker exec` NO hereda el entorno del supervisor: sin este `-e` el helper resuelve el home
  # del harness con el `process.env` de dentro del contenedor y el panel nace en el sitio equivocado.
  cred=$(credencial_env_de "$2" "$5")
  [ -n "$cred" ] && env_cred=(-e "$cred")
  modo=$(modo_permisos_de "$2" "$5")
  [ -n "$modo" ] && env_cred+=(-e "$modo")
  ws=$(sed -n 's/^SHARED_SESSION_WORKSPACE=//p' "$CONFIG/$2.env" 2>/dev/null | head -1)  # misma fuente que la rama host-native de arriba
  docker exec --user "$4" "${env_cred[@]}" "$3" node "$helper" "$1" --alias "$2" \
    --harness "$5" --workspace "${ws:-/workspace}" --state "$6"
}
# Los avisos de caída que quedaron registrados mientras el dueño no estaba mirando.
avisos() {  # $1=alias $2=contenedor $3=usuario $4=state $5=harness
  local helper
  helper=$(helper_en_contenedor "$1") || return 0
  if es_host_native "$1"; then
    node "$helper" degradations --alias "$1" --harness "$5" --state "$4" 2>/dev/null
    return 0
  fi
  docker exec --user "$3" "$2" node "$helper" degradations \
    --alias "$1" --harness "$5" --state "$4" 2>/dev/null
}

uso() {
  cat <<EOF
${c_b}cauce${c_reset} — operar la flota Cauce V3

  ${c_b}cauce${c_reset}                    estado de toda la flota
  ${c_b}cauce <alias>${c_reset}            entrar a hablarle (elige solo el mejor modo)
  ${c_b}cauce <alias> ver${c_reset}        mirar en vivo lo que le llega, sin entrar
  ${c_b}cauce <alias> estado${c_reset}     detalle de un agente
  ${c_b}cauce <alias> sesiones${c_reset}   que conversaciones tiene y cual comparte
  ${c_b}cauce <alias> on|off${c_reset}     encender / apagar su adaptador
  ${c_b}cauce <alias> login${c_reset}      renovar su credencial (elige solo claude o codex)
  ${c_b}cauce <alias> login --ver${c_reset} solo mirar que credencial tiene, sin tocar nada
  ${c_b}cauce <alias> aprovisionar${c_reset} [--dry-run]  alta de credenciales (docs/operacion.md (alta y baja))
  ${c_b}cauce <alias> retirar${c_reset}    baja: para la unit y revoca lo que se pueda
  ${c_b}cauce ver [alias...]${c_reset}     mirar varios a la vez

Al entrar con ${c_b}cauce <alias>${c_reset} te dice en la cabecera cual de los tres modos te toco:
  ${c_ok}compartida${c_reset}  la TUI REAL del agente, y la MISMA conversacion que Telegram.
  ${c_warn}aparte${c_reset}      TUI real pero conversacion nueva: NO comparte con Telegram.
  ${c_err}exclusiva${c_reset}   el adaptador esta parado; lo de Telegram se encola.
EOF
}

# ---------- estado de la flota ----------
cmd_flota() {
  printf "\n  %s%-9s %-22s %-9s %-9s %-9s %s%s\n" "$c_b" ALIAS CONTENEDOR HARNESS ADAPTADOR TUI MODO "$c_reset"
  printf "  %s\n" "$(printf '─%.0s' $(seq 1 76))"
  local a line ctr cuser state harness ad modo color term
  local -a sin_gateway=()
  for a in $(todos_los_alias); do
    # Un alias que vive en el VPS no se puede pintar desde aca: su docker y su systemd son otros.
    # Mostrarlo igual lo dibujaba como "parado" cuando esta perfectamente vivo del otro lado, que
    # es peor que no mostrarlo. Va en su propia tabla, mas abajo, preguntada al host que si lo ve.
    [ "$(sitio "$a")" = vps ] && continue
    line=$(alias_info "$a") || continue
    IFS=$'\t' read -r _ _ ctr cuser _ state harness _ <<<"$line"
    ad=$(adaptador_activo "$a")
    if compartida_configurada "$a" && sesion status "$a" "$ctr" "$cuser" "$harness" "$state" >/dev/null 2>&1; then
      modo=compartida; color=$c_ok; term="${c_ok}si${c_reset}"
    elif [[ $harness == openclaw ]] && openclaw_gateway_vivo "$ctr"; then
      # En openclaw la sesión compartida no tiene interruptor propio: la da el gateway. Si acepta
      # conexiones, la TUI y el turno del bus son dos clientes de la MISMA conversación.
      modo=compartida; color=$c_ok; term="${c_ok}si${c_reset}"
    elif [[ $harness == openclaw && $ad == active ]]; then
      # El caso que no se puede pintar como "aparte" sin mentir: el alias SIGUE contestando el bus,
      # pero por el camino embebido, dentro del propio puente. El dueño no ve NADA de eso, y hoy
      # nada se lo dice en el chat. Que al menos se lo diga acá, y en rojo.
      modo="SIN GATEWAY"; color=$c_err; term="${c_err}NO${c_reset}"; sin_gateway+=("$a")
    elif [[ $ad == active ]]; then
      modo=aparte; color=$c_warn; term="${c_dim}no${c_reset}"
    else
      modo="—"; color=$c_dim; term="${c_dim}no${c_reset}"
    fi
    [[ $ad == active ]] && ad="${c_ok}activo${c_reset}" || ad="${c_dim}parado${c_reset}"
    local ctr_txt="$ctr"
    es_host_native "$a" && ctr_txt="torre (sin docker)"
    printf "  %-9s %-22s %-9s %-18s %-18s %s%s%s\n" "$a" "$ctr_txt" "$harness" "$ad" "$term" "$color" "$modo" "$c_reset"
  done
  if [ ${#sin_gateway[@]} -gt 0 ]; then
    printf "\n  %s%sSIN GATEWAY: %s%s\n" "$c_err" "$c_b" "${sin_gateway[*]}" "$c_reset"
    printf "  %ssiguen contestando Telegram por el camino embebido, en una conversacion que vos NO ves.%s\n" "$c_dim" "$c_reset"
    printf "  %slevantar:  systemctl --user start cauce-v3-openclaw-gateway@<alias>%s\n" "$c_dim" "$c_reset"
  fi
  if [ -r "$MAPA_HOST" ] && awk '$2=="vps"{f=1} END{exit !f}' "$MAPA_HOST"; then
    printf "\n  %s--- en el VPS (100.64.0.11) ---%s\n" "$c_dim" "$c_reset"
    if ! ssh -n -o BatchMode=yes -o ConnectTimeout=10 vps "U=\$(id -u stev); sudo -u stev XDG_RUNTIME_DIR=/run/user/\$U HOME=/home/stev /home/stev/.local/bin/cauce flota" 2>/dev/null | sed -n '/ALIAS/,/entrar:/p' | grep -v 'entrar:'; then
      printf "  %sno pude preguntarle al VPS%s\n" "$c_err" "$c_reset"
    fi
  fi
  printf "\n  %sentrar:  cauce <alias>      mirar:  cauce <alias> ver%s\n\n" "$c_dim" "$c_reset"
}

openclaw_sesiones() {  # $1=alias $2=contenedor $3=usuario $4=stateDirectory
  docker exec --user "$3" "$2" python3 -c '
import json, os, subprocess, sys
alias = sys.argv[1]
state = sys.argv[2]
home = os.path.expanduser("~")

# 1) las sesiones que Cauce le abrio a este alias, una por conversacion
try:
    with open("%s/sessions.json" % state) as fh:
        cauce = json.load(fh)
except Exception:
    raise SystemExit(0)

def donde_y_rango(v):
    o = v.get("origin")
    if not isinstance(o, dict):
        return ("sin origen (consola o publicacion)", 9)
    canal = o.get("channel") or o.get("adapter") or "?"
    conv = str(o.get("conversation_id") or "")
    if canal == "telegram":
        if conv.lstrip("-").isdigit() and not conv.startswith("-"):
            return ("DM Telegram %s" % conv, 0)
        return ("Grupo Telegram %s" % conv, 1)
    if conv.startswith("operator:"):
        return ("consola/publicacion (%s)" % conv.split(":", 1)[1], 3)
    if conv.startswith("agents:"):
        return ("agente-a-agente (tenant %s)" % conv.split(":", 1)[1], 4)
    return ("%s %s" % (canal, conv), 2)

mias = []
for k, v in (cauce.get("sessions") or {}).items():
    if not k.startswith("openclaw:%s:" % alias) or not (v or {}).get("native_id"):
        continue
    d, r = donde_y_rango(v)
    # El carril de agentes no es una conversacion del dueno: nunca puede quedar primero. El
    # prefijo va ADELANTE: la columna se trunca y un sufijo se perdia en las filas mas largas.
    if k.endswith(".agent-lane"):
        r = max(r, 5)
        d = "[agentes] %s" % d
    mias.append((r, v["native_id"], d))
if not mias:
    raise SystemExit(0)
mias.sort(key=lambda t: t[0])

# 2) lo que sabe el gestor de sesiones de openclaw: edad, tokens, y el id del transcript
porclave = {}
try:
    out = subprocess.run(["openclaw", "sessions", "list", "--json", "--limit", "all"],
                         capture_output=True, text=True, timeout=25).stdout
    lista = json.loads(out)
    if isinstance(lista, dict):
        lista = lista.get("sessions") or lista.get("items") or []
    for s in lista:
        k = s.get("key", "")
        if ":" in k:
            porclave[k.rsplit(":", 1)[-1]] = s
except Exception:
    pass

def edad(ms):
    if not ms: return "?"
    m = ms // 60000
    if m < 60: return "%dm" % m
    if m < 1440: return "%dh" % (m // 60)
    return "%dd" % (m // 1440)

# 3) el ultimo turno del DUEÑO identifica la conversacion mejor que la respuesta. En la del bus
#    ese turno es el sobre de protocolo entero, asi que se extrae el pedido real de adentro.
def adelanto(sid):
    if not sid: return ""
    f = "%s/.openclaw/agents/main/sessions/%s.jsonl" % (home, sid)
    if not os.path.exists(f): return ""
    ult = ""
    try:
        with open(f, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                try: e = json.loads(ln)
                except Exception: continue
                m = e.get("message") or {}
                if m.get("role") != "user": continue
                c = m.get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c
                                 if isinstance(x, dict) and x.get("type") == "text")
                if isinstance(c, str) and c.strip(): ult = c.strip()
    except Exception:
        return ""
    for ini_m, fin_m in (("BEGIN REQUEST", "END REQUEST"), ("BEGIN IDENTITY", "END IDENTITY")):
        if ini_m in ult and fin_m in ult:
            ult = ult.split(ini_m, 1)[1].split(fin_m, 1)[0]
            break
    return " ".join(ult.split()).strip("- ")[:64]

for _r, n, d in mias:
    s = porclave.get(n, {})
    tok = "%dk" % (s.get("totalTokens", 0) // 1000) if s.get("totalTokens") else "?"
    print("%s\t%s\t%s\t%s\t%s" % (n, edad(s.get("ageMs")), tok, adelanto(s.get("sessionId")), d))
' "$1" "$4" 2>/dev/null
}

# El gateway de openclaw acepta conexiones? Sin el no hay a que engancharse: el alias corre por
# el fallback embebido dentro del propio puente y la TUI no comparte nada.
openclaw_gateway_vivo() {  # $1=contenedor
  docker exec "$1" node -e '
const net=require("net"), fs=require("fs");
// El puerto NO es siempre 18789: sale de gateway.port de openclaw.json (janus usa 18790).
let puerto=18789;
for (const p of ["/home/claw/.openclaw/openclaw.json","/home/dev/.openclaw/openclaw.json"]) {
  try { const g=(JSON.parse(fs.readFileSync(p,"utf8")).gateway)||{}; if (g.port) { puerto=g.port; break; } } catch (e) {}
}
const s=net.connect(puerto,"127.0.0.1");
s.setTimeout(2500);
s.on("connect",()=>{s.destroy();process.exit(0)});
s.on("error",()=>process.exit(1));
s.on("timeout",()=>process.exit(1));
' >/dev/null 2>&1
}

cmd_entrar() {
  local a=$1 line ctr cuser chome state harness ad salida
  line=$(alias_info "$a") || { echo "alias desconocido: $a"; exit 2; }
  IFS=$'\t' read -r _ _ ctr cuser chome state harness _ <<<"$line"
  ad=$(adaptador_activo "$a")

  printf "\n  %s%s%s · %s · %s\n" "$c_b" "$a" "$c_reset" "$harness" "$ctr"

  # 1) sesion compartida: la TUI real, y la misma conversacion que Telegram.
  if compartida_configurada "$a"; then
    if salida=$(sesion ensure "$a" "$ctr" "$cuser" "$harness" "$state" 2>&1); then
      printf "  modo: %s%sCOMPARTIDA%s — la TUI real, y la misma conversacion que Telegram.\n" "$c_ok" "$c_b" "$c_reset"
      printf "  %slo que llegue por el bus aparece aca EN VIVO. salir sin cerrarla: Ctrl-b d%s\n" "$c_dim" "$c_reset"
      # Lo que se rompio mientras no estabas mirando. Si el bus tuvo que contestar por el camino
      # de siempre, se dice aca ANTES de entrar: una caida silenciosa es indistinguible del exito.
      local pendientes
      pendientes=$(avisos "$a" "$ctr" "$cuser" "$state" "$harness")
      if [ -n "$pendientes" ]; then
        printf "\n  %s%savisos de la sesion compartida:%s\n" "$c_err" "$c_b" "$c_reset"
        printf '%s\n' "$pendientes" | python3 -c '
import json,sys
for line in sys.stdin:
    line=line.strip()
    if not line: continue
    try: r=json.loads(line)
    except Exception: continue
    print("    \033[31m•\033[0m %s  %s: %s" % (r.get("occurredAt","")[:19], r.get("reason","?"), r.get("detail","")))
'
      fi
      printf "\n"
      if es_host_native "$a"; then
        # Su tmux es el del HOST: entrar por docker exec no lleva a ninguna parte.
        exec tmux -L "$TMUX_SOCKET" attach-session -t "cauce-$a:agente"
      fi
      exec docker exec -it --user "$cuser" "$ctr" \
        tmux -L "$TMUX_SOCKET" attach-session -t "cauce-$a:agente"
    fi
    printf "  %sla sesion compartida esta configurada pero NO se pudo abrir; no se lanzara una sesion aparte:%s\n" "$c_err" "$c_reset"
    printf "  %s%s%s\n" "$c_dim" "${salida:-sin detalle}" "$c_reset"
    return 1
  elif [[ $harness == openclaw ]]; then
    local lineas clave_oc n
    mapfile -t lineas < <(openclaw_sesiones "$a" "$ctr" "$cuser" "$state")
    if [[ ${#lineas[@]} -eq 0 ]]; then
      printf "  %stodavia no hay ninguna sesion del bus para %s: mandale algo y volve%s\n" "$c_dim" "$a" "$c_reset"
    elif ! openclaw_gateway_vivo "$ctr"; then
      printf "  %sel gateway de openclaw NO responde en %s (127.0.0.1:18789)%s\n" "$c_err" "$ctr" "$c_reset"
      printf "  %ssin gateway no hay a que engancharse: este alias corre por el camino embebido,%s\n" "$c_dim" "$c_reset"
      printf "  %sdentro del propio puente, asi que una TUI aca seria una conversacion aparte.%s\n" "$c_dim" "$c_reset"
    else
      local donde_oc
      if [[ ${#lineas[@]} -gt 1 ]]; then
        # openclaw abre una conversacion por canal (Telegram, consola, bus): hilos distintos
        # de verdad, y el dueño elige a cual entra. Las de Telegram van primeras y marcadas: es
        # la que el dueño casi siempre quiere y hasta hoy tenia que adivinar.
        printf "  %s%s conversaciones%s %s— openclaw abre una por canal. Elegi:%s\n\n" "$c_b" "${#lineas[@]}" "$c_reset" "$c_dim" "$c_reset"
        local hay_dm=0
        for i in "${!lineas[@]}"; do
          IFS=$'\t' read -r nid ed tk pre dnd <<<"${lineas[$i]}"
          local marca="  " color="$c_dim"
          if [[ $dnd == DM\ Telegram* ]]; then marca="${c_ok}${c_b}>>${c_reset}"; color="$c_ok"; hay_dm=1; fi
          printf "  %s %s%d)%s %-9s %s%-40s%s %shace %-5s · %-5s%s  %s\n" \
            "$marca" "$c_b" $((i+1)) "$c_reset" "${nid:0:8}" "$color" "${dnd:0:40}" "$c_reset" "$c_dim" "$ed" "$tk" "$c_reset" "${pre:0:38}"
        done
        # La leyenda sólo si hay algo que señalar. Un ">>" explicado y ausente hace buscar una
        # marca que no existe, y deja la duda de si la conversacion de Telegram esta o no.
        if [[ $hay_dm -eq 1 ]]; then
          printf "\n  %s>> = el DM de Telegram del dueño, segun lo que el adaptador anoto al abrirla.%s\n" "$c_dim" "$c_reset"
        else
          printf "\n  %sninguna conversacion consta como DM de Telegram.%s%s Las que dicen \"sin origen\"\n" "$c_warn" "$c_reset" "$c_dim"
          printf "  son anteriores al registro de origen: puede que una lo sea, pero no puedo decir cual.%s\n" "$c_reset"
        fi
        printf "  %snumero (Enter = 1, q = salir):%s " "$c_dim" "$c_reset"
        read -r n </dev/tty || n=""
        [[ $n == q ]] && { printf "\n"; exit 0; }
        [[ -z $n ]] && n=1
        if ! [[ $n =~ ^[0-9]+$ ]] || (( n < 1 || n > ${#lineas[@]} )); then
          printf "  %sopcion invalida%s\n\n" "$c_err" "$c_reset"; exit 2
        fi
      else
        n=1
      fi
      IFS=$'\t' read -r clave_oc _ _ _ donde_oc <<<"${lineas[$((n-1))]}"
      # El cartel dice QUE conversacion es, no solo que "es la misma que el bus". Cuando el
      # origen no consta, se dice que no consta, en vez de afirmar que es la de Telegram.
      printf "\n  modo: %s%sCOMPARTIDA%s — la TUI real de openclaw, la MISMA conversacion que el bus.\n" "$c_ok" "$c_b" "$c_reset"
      if [[ $donde_oc == *"sin origen"* || -z $donde_oc ]]; then
        printf "  %sconversacion: NO CONSTA de que canal salio%s%s (entrada anterior al registro de origen).\n" "$c_warn" "$c_reset" "$c_dim"
        printf "  no puedo afirmar que sea la de Telegram; si no es, salí y elegí otra.%s\n" "$c_reset"
      else
        printf "  %sconversacion: %s%s\n" "$c_dim" "$donde_oc" "$c_reset"
      fi
      printf "  %ssalir sin cerrarla: Ctrl-b d  ·  sesion %s%s\n" "$c_dim" "${clave_oc:0:8}" "$c_reset"
      printf "  %sojo, openclaw todavia NO esta endurecido%s%s — tres cosas medidas:\n" "$c_warn" "$c_reset" "$c_dim"
      printf "    · el PEDIDO del bus no se pinta en vivo (la respuesta si): veras respuestas sin pregunta\n"
      printf "    · veras el sobre JSON crudo y el prompt de protocolo entero\n"
      printf "    · el agente NO recuerda lo que EL te contesto a vos (lo que vos escribis si lo ve)%s\n\n" "$c_reset"
      exec docker exec -it --user "$cuser" -w "${chome:-/}" "$ctr" openclaw tui --session "$clave_oc"
    fi
  elif [[ $harness == claude || $harness == codex || $harness == grok || $harness == muse ]]; then
    printf "  %seste alias no tiene sesion compartida encendida (falta SHARED_SESSION=1 en su .env)%s\n" "$c_dim" "$c_reset"
  else
    printf "  %sel harness %s no tiene sesion compartida%s\n" "$c_dim" "$harness" "$c_reset"
  fi

  wsa=$(sed -n 's/^SHARED_SESSION_WORKSPACE=//p' "$CONFIG/$a.env" 2>/dev/null | head -1)
  if [[ $ad == active ]]; then
    printf "  modo: %s%sAPARTE%s — %s\n" "$c_warn" "$c_b" "$c_reset" "$([[ $harness == grok ]] && echo 'rama (--fork-session) del DM: lo que escribas NO vuelve a Telegram.' || echo 'TUI real, pero conversacion nueva: NO comparte con Telegram.')"
    printf "  %sel agente sigue respondiendo Telegram y el bus. salir: Ctrl-D%s\n\n" "$c_dim" "$c_reset"
    case "$harness" in
      claude|codex)
              local credential
              local -a launch=("$harness") native_environment=()
              if [[ $harness == claude ]]; then launch+=(--dangerously-skip-permissions --permission-mode bypassPermissions); else launch+=(--yolo); fi
              if es_host_native "$a"; then
                credential=$(credencial_env_de "$a" "$harness") || return 1
                [[ -z $credential ]] || native_environment+=("$credential")
                cd "${chome:-$cli_home}" || return 1
                exec env "HOME=${chome:-$cli_home}" "${native_environment[@]}" "${launch[@]}"
              fi
              exec docker exec -it --user "$cuser" -w "${wsa:-${chome:-/}}" "$ctr" "${launch[@]}" ;;
      openclaw)
              printf "  %sopenclaw SI tiene TUI propia, pero no te la abro aca: en modo local%s\n" "$c_dim" "$c_reset"
              printf "  %scomparte el ESTADO con el bus y aun asi el panel es CIEGO (el turno del%s\n" "$c_dim" "$c_reset"
              printf "  %sbus nunca aparece). La conversacion mutaria debajo tuyo sin dejar rastro.%s\n" "$c_dim" "$c_reset"
              printf "  %sTe abro un shell; para la TUI compartida hace falta gateway.%s\n\n" "$c_dim" "$c_reset"
              exec docker exec -it --user "$cuser" -w "${chome:-/}" "$ctr" bash -l ;;
      grok)   # Sin SHARED_SESSION=1 (que es la MISMA conversacion): una RAMA del DM, sin dos escritores.
              printf "  %sgrok: te abro una RAMA de la conversacion del DM; para la misma: SHARED_SESSION=1.%s\n\n" "$c_dim" "$c_reset"
              exec python3 "$BIN/cauce-attach" "$a" --dm --bifurcar ;;
      muse)   # Sin SHARED_SESSION=1: la TUI real de Muse en conversacion NUEVA (APARTE); la del bus corre
              # por `muse exec`. Con SHARED_SESSION=1 se entra arriba, a la MISMA. El login vive en ~/.local
              # (montado); el enlace ~/.config/muse se pierde si re-aplanan el contenedor: se repone.
              printf "  %smuse: te abro su TUI real (esfuerzo max), conversacion aparte.%s\n\n" "$c_dim" "$c_reset"
              exec docker exec -it --user "$cuser" -w "${wsa:-${chome:-/}}" "$ctr" bash -lc \
                'd="$HOME/.local/share/cauce-v3/config/'"$a"'/.config/muse"; if [ ! -e "$HOME/.config/muse" ] && [ -d "$d" ]; then mkdir -p "$HOME/.config" && ln -s "$d" "$HOME/.config/muse"; fi; exec "$HOME/.local/bin/muse" --yolo --trust-workspace --reasoning-effort max' ;;
      *)      printf "  %ssin TUI propia: te abro un shell%s\n\n" "$c_dim" "$c_reset"
              exec docker exec -it --user "$cuser" -w "${wsa:-${chome:-/}}" "$ctr" bash -l ;;
    esac
  fi

  printf "  modo: %s%sEXCLUSIVA%s — su adaptador esta parado.\n" "$c_err" "$c_b" "$c_reset"
  printf "  %slo que le escriban por Telegram se ENCOLA y entra cuando salgas.%s\n\n" "$c_dim" "$c_reset"
  if [[ -x $BIN/cauce-attach ]]; then exec python3 "$BIN/cauce-attach" "$a"; fi
  exec docker exec -it --user "$cuser" -w "${wsa:-${chome:-/}}" "$ctr" bash -l
}

# ---------- resto ----------
cmd_ver()      { exec "$BIN/ia-ver" "$@"; }
cmd_estado()   { if [ -n "${1:-}" ]; then exec "$BIN/cauce-estado" "$1"; fi; exec "$BIN/cauce-estado"; }
cmd_sesiones() { exec "$BIN/cauce-sesiones" "$1"; }
unit_del_alias() {
  es_host_native "$1" && printf 'cauce-v3-host-%s.service\n' "$1" || printf 'cauce-v3-container-%s.service\n' "$1"
}
systemctl_user_o_avisa() {  # $1=verbo(start|stop) $2=unit
  local verbo=$1 unit=$2 salida candidato; [ -z "${XDG_RUNTIME_DIR:-}" ] && { candidato="/run/user/$(id -u)"; [ -d "$candidato" ] && export XDG_RUNTIME_DIR="$candidato"; }; [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR:-}/bus" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"; salida=$(systemctl --user "$verbo" "$unit" 2>&1) && return 0; printf "  %ssystemctl --user %s %s fallo%s\n" "$c_err" "$verbo" "$unit" "$c_reset">&2; printf "  %s%s%s\n" "$c_dim" "$salida" "$c_reset">&2; printf "  %ssin XDG_RUNTIME_DIR se intento derivar de /run/user/\$(id -u); desde root: systemctl --user -M stev@ %s %s%s\n" "$c_dim" "$verbo" "$unit" "$c_reset">&2; return 1
}

# shellcheck disable=SC2016  # corre en otro shell (eval / docker exec): sus $ se expanden alla
BARRIDO='for p in /proc/[0-9]*; do c=$(tr "\0" " " < "$p/cmdline" 2>/dev/null); set -- $c; case "${1:-}" in *node*|*python*) ;; *) continue;; esac; h=""; e=$(tr "\0" "\n" < "$p/environ" 2>/dev/null | sed -n "s/^CAUCE_ALIAS=//p" | head -1); [ "$e" = "@@A@@" ] && h=1; case "$c" in *cauce-v3-adapter/@@A@@/*/cauce-mcp.js*) ;; *cauce-v3-adapter/@@A@@/*) h=1;; esac; [ -n "$h" ] && echo "${p#/proc/}"; done'  # The shared TUI's MCP bridge (cauce-mcp.js, no CAUCE_ALIAS) is the panel's, not the adapter's.

pids_del_alias() {  # $1=alias -> un PID por linea (vacio = de verdad no hay nada)
  local a=$1 line ctr cuser
  if es_host_native "$a"; then
    eval "${BARRIDO//@@A@@/$a}" 2>/dev/null
    return 0
  fi
  line=$(alias_info "$a") || return 0
  IFS=$'\t' read -r _ _ ctr cuser _ _ _ <<<"$line"
  [ -n "$ctr" ] || return 0
  docker exec "$ctr" sh -c "${BARRIDO//@@A@@/$a}" 2>/dev/null
}

cmd_on() {
  local a=$1 u; u=$(unit_del_alias "$a")
  systemctl_user_o_avisa start "$u"
  # El adaptador hace STAGING del bundle (docker cp + chmod -R + verificacion) ANTES de existir
  # el proceso real: medido 45-75s. Un `sleep 6` reporta "NO arranco" a mitad de copiar y el
  # operador le repone el panel, que le BORRA la conversacion. Se sondea la CONDICION (el proceso
  # vivo en /proc) con reintentos hasta un techo generoso, avisando que sigue.
  local techo=120 paso=5 transcurrido=0 pids
  pids=$(pids_del_alias "$a" | tr '\n' ' ')
  if [ -z "${pids// /}" ]; then
    printf "  %s%s arrancando… el staging del bundle puede tardar 45-75s; sondeando hasta %ss%s\n" "$c_dim" "$a" "$techo" "$c_reset"
    while (( transcurrido < techo )); do
      sleep "$paso"
      transcurrido=$((transcurrido + paso))
      pids=$(pids_del_alias "$a" | tr '\n' ' ')
      [ -n "${pids// /}" ] && break
      (( transcurrido % 20 == 0 )) && printf "  %s%s sigue esperando (%ss/%ss)…%s\n" "$c_dim" "$a" "$transcurrido" "$techo" "$c_reset"
    done
  fi
  local line ctr cuser state harness
  line=$(alias_info "$a") && IFS=$'\t' read -r _ _ ctr cuser _ state harness _ <<<"$line"
  if [ -z "${pids// /}" ]; then
    printf "  %s%s: todavia sin proceso vivo tras %ss%s  (systemd dice: %s)\n" "$c_err" "$a" "$techo" "$c_reset" "$(adaptador_activo "$a")"
    printf "  %scomprobado: ningun proceso con CAUCE_ALIAS=%s (ni cmdline .../cauce-v3-adapter/%s/) en su contenedor/host.%s\n" "$c_dim" "$a" "$a" "$c_reset"
    printf "  %spuede seguir en staging si el bundle es grande, o haber fallado de verdad — no asumas que esta muerto:%s\n" "$c_dim" "$c_reset"
    printf "  %s  journalctl --user -u %s -n 40 --no-pager%s\n" "$c_dim" "$u" "$c_reset"
    printf "  %s  cauce %s estado%s\n" "$c_dim" "$a" "$c_reset"
    return 1
  fi
  printf "  %s proceso vivo: %s%s procesos%s %s(PID %s...) tras %ss%s\n" \
    "$a" "$c_ok" "$(printf '%s' "$pids" | wc -w)" "$c_reset" "$c_dim" "$(printf '%s' "$pids" | cut -d" " -f1)" "$transcurrido" "$c_reset"
  if compartida_configurada "$a"; then
    # Misma logica que arriba: la sesion tmux se crea DESPUES del proceso y puede tardar unos
    # segundos mas en aparecer. `ensure` es idempotente, asi que reintentarlo no hace dano.
    local s_techo=30 s_paso=3 s_transcurrido=0 tui=''
    while :; do
      sesion ensure "$a" "$ctr" "$cuser" "$harness" "$state" >/dev/null 2>&1 || true
      tui=$(sesion status "$a" "$ctr" "$cuser" "$harness" "$state" 2>&1)
      printf '%s' "$tui" | grep -q '"present":true' && break
      (( s_transcurrido >= s_techo )) && break
      sleep "$s_paso"
      s_transcurrido=$((s_transcurrido + s_paso))
    done
    if printf '%s' "$tui" | grep -q '"present":true'; then
      printf "  %s sesion compartida: %slista%s\n" "$a" "$c_ok" "$c_reset"
    else
      printf "  %s%s: proceso VIVO pero SIN sesion compartida%s tras %ss de intentos — Telegram y tu TUI quedan separados\n" "$c_warn" "$a" "$c_reset" "$s_techo"
      printf "  %s%s%s\n" "$c_dim" "$(printf '%s' "$tui" | tail -2)" "$c_reset"
      printf "  %sya reintente 'ensure' solo varias veces; a mano: cauce %s%s\n" "$c_dim" "$a" "$c_reset"
    fi
  fi
  printf "  %sentrar: cauce %s%s\n" "$c_dim" "$a" "$c_reset"
}

cmd_off() {
  local a=$1 u; u=$(unit_del_alias "$a")
  systemctl_user_o_avisa stop "$u"
  sleep 3
  # No alcanza con parar la unit: hay un caso medido donde el alias siguio contestando el bus con
  # la unit en "inactive". Si sobrevivio algo, matarlo — "off" quiere decir off.
  local pids p vivo
  pids=$(pids_del_alias "$a")
  if [ -n "$pids" ]; then
    printf "  %s%s sobrevivio a systemd%s (PID %s) — lo mato\n" "$c_warn" "$a" "$c_reset" "$(echo "$pids" | tr '\n' ' ')"
    for p in $pids; do
      # Reconfirmar la identidad JUSTO antes de senalar: los PIDs se reciclan.
      if es_host_native "$a"; then
        vivo=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | sed -n 's/^CAUCE_ALIAS=//p' | head -1)
        [ "$vivo" = "$a" ] && kill "$p" 2>/dev/null
      else
        local line ctr; line=$(alias_info "$a") && IFS=$'\t' read -r _ _ ctr _ _ _ _ <<<"$line"
        vivo=$(docker exec "$ctr" sh -c "tr '\0' '\n' < /proc/$p/environ 2>/dev/null | sed -n 's/^CAUCE_ALIAS=//p' | head -1" 2>/dev/null)
        [ "$vivo" = "$a" ] && docker exec "$ctr" kill "$p" 2>/dev/null
      fi
    done
    sleep 2
    pids=$(pids_del_alias "$a")
  fi
  if [ -n "$pids" ]; then
    printf "  %s%s SIGUE VIVO%s (PID %s). No se murio solo: mirar a mano.\n" "$c_err" "$a" "$c_reset" "$(echo "$pids" | tr '\n' ' ')"
    return 1
  fi
  # Su servidor tmux arrastra la generacion del adaptador: si queda en pie, el proximo arranque
  # muere con 78/CONFIG. Matar la sesion tmux NO basta: el arnes puede sobrevivir sin panel (un
  # `claude --resume` sobrevivio 51 min a un `off`) reteniendo su session id — justo lo que produce
  # los dead_letters de "Session ID ... is already in use". El PID del panel se anota ANTES de
  # matar la sesion, porque despues ya no hay a quien preguntarle.
  local matar_panel; matar_panel="pids=$(tmux -L "$TMUX_SOCKET" list-panes -t "cauce-$a" -F '#{pane_pid}' 2>/dev/null); tmux -L $TMUX_SOCKET kill-session -t cauce-$a 2>/dev/null; for p in \$pids; do kill \$p 2>/dev/null; done; true"
  if es_host_native "$a"; then
    sh -lc "$matar_panel" >/dev/null 2>&1
  else
    local line2 ctr2; line2=$(alias_info "$a") && IFS=$'\t' read -r _ _ ctr2 _ _ _ _ <<<"$line2"
    [ -n "$ctr2" ] && docker exec "$ctr2" sh -lc "$matar_panel" >/dev/null 2>&1
  fi
  printf "  %s %sadaptador del bus apagado de verdad%s %s(su TUI tambien se fue, si no el proximo \"on\" falla con 78/CONFIG)%s\n" "$a" "$c_ok" "$c_reset" "$c_dim" "$c_reset"
  # "off" apaga el ADAPTADOR DEL BUS. El canal PTY es otro servicio con su propia unit, y sigue
  # en pie: el alias mantiene su TLS al relay y su terminal web sigue alcanzable — no es "off" total.
  if [ "$(systemctl --user is-active "cauce-v3-pty@$a.service" 2>/dev/null)" = active ]; then
    printf "  %sojo:%s su agente PTY sigue vivo y conectado al relay %s(cauce-v3-pty@%s)%s\n" "$c_warn" "$c_reset" "$c_dim" "$a" "$c_reset"
    printf "        %sel terminal web de %s sigue en pie. Para bajarlo tambien:%s\n" "$c_dim" "$a" "$c_reset"
    printf "        %ssystemctl --user stop cauce-v3-pty@%s%s\n" "$c_dim" "$a" "$c_reset"
  fi
}

# --- MULTI-HOST -------------------------------------------------------------------------------
# 11 alias se mudaron al VPS y este CLI hablaba SIEMPRE con el docker/systemd locales: `cauce
# argos estado` en la torre contestaba sobre un contenedor apagado — no falla, MIENTE, que es
# peor. El mapa se genera de la realidad: ~/.config/cauce-v3/alias-host.tsv ->
# <alias>\t<local|vps|ssh:usuario@host>.
# Para los remotos no se reimplementa nada: se reenvia el mismo comando al `cauce` del otro host.
MAPA_HOST=$cli_home/.config/cauce-v3/alias-host.tsv
sitio() {
  local alias_name=$1 route_record route match_count invalid_fields
  [ -e "$MAPA_HOST" ] || { echo local; return; }
  if [ ! -f "$MAPA_HOST" ] || [ ! -r "$MAPA_HOST" ] || ! route_record=$(awk -v a="$alias_name" '$1==a {n++; if(NF!=2) bad=1; r=$2} END{if(n) printf "%d\t%d\t%s",n,bad+0,r}' "$MAPA_HOST" 2>/dev/null); then
    printf 'no se pudo leer el mapa de rutas\n' >&2
    return 2
  fi
  [ -n "$route_record" ] || { echo local; return; }
  IFS=$'\t' read -r match_count invalid_fields route <<<"$route_record"
  [ "$match_count" -eq 1 ] && [ "$invalid_fields" -eq 0 ] || {
    printf 'ruta remota invalida para %s: el registro no es unico con dos campos\n' "$alias_name" >&2; return 2;
  }
  case "$route" in
    local|vps) ;;
    ssh:*)
      [[ ${route#ssh:} =~ ^[a-z_][a-z0-9_.-]*@[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || {
        printf 'ruta remota invalida para %s\n' "$alias_name" >&2; return 2;
      }
      ;;
    *) printf 'ruta remota invalida para %s\n' "$alias_name" >&2; return 2 ;;
  esac
  printf '%s\n' "$route"
}
quote_remote_argument() {  # $1=value; returns one remote-shell-safe word in REPLY
  printf -v REPLY "'%s'" "${1//\'/\'\\\'\'}"
}
build_remote_command() {  # $1=fixed script, remaining arguments=argv; returns command in REPLY
  local fixed_script=$1 argument; shift
  quote_remote_argument "$fixed_script"
  local command="/bin/sh -c $REPLY cauce"
  for argument in "$@"; do
    quote_remote_argument "$argument"
    command+=" $REPLY"
  done
  REPLY=$command
}
remoto_cauce() {  # $1=ruta $2=alias, resto=argumentos tal cual
  local route=$1 alias_name=$2 destination fixed_script; shift 2
  # Sin -t hay que pasar -n. Sin ninguno de los dos, el ssh se traga el stdin de quien invoco
  # a cauce: medido, un `cauce <alias> login --ver` dentro de un script se comio el resto del
  # script y las ordenes siguientes no llegaron a correr nunca.
  local tty=(-n); [ -t 0 ] && [ -t 1 ] && tty=(-t)
  case "$route" in
    vps)
      destination=vps
      # shellcheck disable=SC2016
      fixed_script='remote_uid=$(id -u stev) || exit 69; remote_home=$(getent passwd stev | cut -d: -f6) || exit 69; case "$remote_home" in /*) ;; *) exit 69 ;; esac; test -d "$remote_home" && test -x "$remote_home/.local/bin/cauce" || exit 69; cd "$remote_home" || exit 69; exec sudo -u stev env HOME="$remote_home" XDG_RUNTIME_DIR="/run/user/$remote_uid" "$remote_home/.local/bin/cauce" "$@"'
      ;;
    ssh:*)
      destination=${route#ssh:}
      # shellcheck disable=SC2016
      fixed_script='remote_uid=$(id -u) || exit 69; remote_home=$(getent passwd "$remote_uid" | cut -d: -f6) || exit 69; case "$remote_home" in /*) ;; *) exit 69 ;; esac; test -d "$remote_home" && test -x "$remote_home/.local/bin/cauce" || exit 69; cd "$remote_home" || exit 69; exec env HOME="$remote_home" XDG_RUNTIME_DIR="/run/user/$remote_uid" "$remote_home/.local/bin/cauce" "$@"'
      ;;
    *) return 2 ;;
  esac
  build_remote_command "$fixed_script" "$alias_name" "$@"
  # shellcheck disable=SC2029
  ssh "${tty[@]}" "$destination" "$REPLY"
}

# Alta y renovacion de credenciales en lib hermana (poda T060-D): mismo codigo, cargado aqui para que entrypoint, ayuda y dispatcher queden intactos.
CLI_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck disable=SC1091
source "$CLI_DIR/cauce-credenciales.lib.sh" || { printf 'cauce: falta %s/cauce-credenciales.lib.sh (reinstalar con install-cauce-cli.sh)\n' "$CLI_DIR" >&2; exit 1; }

cmd_retirar() {  # $1=alias
  local a=$1
  printf "\n  %sretirar %s%s\n\n" "$c_b" "$a" "$c_reset"

  # 1: parar y deshabilitar la unit del alias.
  local u; u=$(unit_del_alias "$a")
  printf "  [1] deteniendo y deshabilitando %s\n" "$u"
  systemctl --user disable --now "$u" >/dev/null 2>&1
  # `is-active` prints its own state word (including for a unit that never existed) and still
  # exits non-zero for anything but "active" — capture it directly, no `||` fallback on top.
  local estado_unit
  estado_unit=$(systemctl --user is-active "$u" 2>/dev/null)
  printf "      estado: %s\n" "${estado_unit:-desconocido}"

  # 2: revocar el hash del token — solo si issue-alias-token.py implementa --revoke.
  local issue_script="$OPS/scripts/issue-alias-token.py"
  if [ -f "$issue_script" ] && grep -qE -- '--revoke' "$issue_script" 2>/dev/null; then
    if python3 "$issue_script" --revoke --alias "$a" --tokens-dir "$TOKENS_DIR_ALIAS" --identities-dir "$IDENTIDADES_DIR"; then
      printf "  [2] hash de agent-%s marcado revoked\n" "$a"
    else
      printf "  [2] %sissue-alias-token.py --revoke fallo para %s%s\n" "$c_err" "$a" "$c_reset"
    fi
  else
    printf "  [2] %sissue-alias-token.py todavia no implementa --revoke%s\n" "$c_warn" "$c_reset"
    printf "      marcalo a mano: revoked=true para agent-%s en %s/token_hashes.json\n" "$a" "$IDENTIDADES_DIR"
  fi

  # 2b: revocar la identidad mTLS de [1b] — mismo patron que el paso 2, con register-agent-identity.py.
  local register_script="$OPS/scripts/register-agent-identity.py" ret_tenant; ret_tenant=$(flota_estado_alias "$a" | cut -f1)
  if [ ! -f "$register_script" ] || ! grep -qE -- '--revoke' "$register_script" 2>/dev/null; then
    printf "  [2b] %sregister-agent-identity.py todavia no implementa --revoke%s\n" "$c_warn" "$c_reset"
  elif [ -n "$ret_tenant" ] && python3 "$register_script" --revoke --tenant "$ret_tenant" --alias "$a"; then
    printf "  [2b] identidad mTLS de %s marcada revoked\n" "$a"
  else
    printf "  [2b] %sno pude revocar la identidad mTLS de %s (tenant=%s)%s\n" "$c_err" "$a" "${ret_tenant:-?}" "$c_reset"
  fi

  # 3: la BD queda fuera del alcance del CLI a proposito.
  printf "\n  %spendiente del dueno%s %s(este CLI NO escribe en la BD):%s\n" "$c_warn" "$c_reset" "$c_dim" "$c_reset"
  printf "    UPDATE agents SET enabled=false WHERE alias='%s';\n" "$a"
  printf "    python3 ops/scripts/export-fleet-snapshot.py --out ops/flota.json\n"
  printf "    ./ops/scripts/regenerate-fleet.sh   %s(purga manifest/unit/telegram del alias)%s\n\n" "$c_dim" "$c_reset"
}


case "${1:-}" in
  ""|flota|estado) if [[ ${1:-} == estado ]]; then cmd_estado "${2:-}"; else cmd_flota; fi ;;
  -h|--help|help|ayuda) uso ;;
  ver) shift; cmd_ver "$@" ;;
  pila-test) shift; d=$(dirname "${BASH_SOURCE[0]}")/../tests/cauce-pila-test.cli.mjs; [ -f "$d" ] || { echo "pila-test solo existe en el repo (falta $d)"; exit 3; }; exec node "$d" "$@" ;;
  *)
    a=$1; shift || true
    route=$(sitio "$a") || exit $?
    case "$route" in
      vps)
        printf "  \033[2m%s vive en el VPS; reenvio el comando alla\033[0m\n" "$a" >&2
        remoto_cauce "$route" "$a" "$@"
        exit $?
        ;;
      ssh:*)
        printf "  \033[2m%s vive en %s; reenvio el comando alla\033[0m\n" "$a" "${route#ssh:}" >&2
        remoto_cauce "$route" "$a" "$@"
        exit $?
        ;;
    esac
    case "${1:-}" in
      "")        cmd_entrar "$a" ;;
      ver)       cmd_ver "$a" ;;
      estado)    cmd_estado "$a" ;;
      sesiones)  cmd_sesiones "$a" ;;
      on)        cmd_on "$a" ;;
      off)       cmd_off "$a" ;;
      login|auth) shift; cmd_login "$a" "$@" ;;
      aprovisionar) shift; cmd_aprovisionar "$a" "$@" ;;
      retirar)   cmd_retirar "$a" ;;
      *)         echo "no entiendo '$1'"; uso; exit 2 ;;
    esac ;;
esac
