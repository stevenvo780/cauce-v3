#!/usr/bin/env bash
set -euo pipefail

cli_directory=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
exec python3 -I -B - "$cli_directory" "$@" <<'PY'
import argparse
import json
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, sys.argv.pop(1))
from context_client import ContextClient, ContextFailure


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, stream, code, message, headers, new_url):
        return None


class DiagnoseArgumentParser(argparse.ArgumentParser):
    def format_help(self):
        return super().format_help().replace('usage: ', 'Uso: ', 1)

    def format_usage(self):
        return super().format_usage().replace('usage: ', 'Uso: ', 1)

    def error(self, _message):
        self.print_usage(sys.stderr)
        self.exit(2, 'Argumentos de diagnose inválidos; usa cauce diagnose --help.\n')


def main():
    parser = DiagnoseArgumentParser(prog='cauce diagnose', description='Lee la cadena de diagnóstico de la empresa con la sesión de consola')
    parser.add_argument('id', help='Identificador de traza, operación, sesión, entrega o copia')
    parser.add_argument('--gateway', required=True)
    parser.add_argument('--origin', required=True)
    parser.add_argument('--session-file', required=True)
    parser.add_argument('--ca-file')
    args = parser.parse_args()
    try:
        if not args.id or len(args.id.encode('utf-16-le')) > 512 or args.id in ('.', '..') \
                or any(ord(character) < 32 or ord(character) == 127 for character in args.id):
            raise ContextFailure('diagnostic identifier is unavailable')
        client = ContextClient(args.gateway, args.origin, args.session_file, args.ca_file)
        request = urllib.request.Request(
            client.gateway + '/v3/console/diagnose/' + urllib.parse.quote(args.id, safe=''),
            headers={'Cookie': client.cookie, 'Origin': client.origin, 'Accept': 'application/json'},
            method='GET',
        )
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect(),
            urllib.request.HTTPSHandler(context=client.tls))
        with opener.open(request, timeout=65) as response:
            raw = response.read(2097153)
            if len(raw) > 2097152:
                raise ContextFailure('diagnostic response exceeds limit')
            result = json.loads(raw)
        if not isinstance(result, dict):
            raise ContextFailure('diagnostic response is invalid')
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0
    except urllib.error.HTTPError as error:
        code = error.code
        if code == 401:
            print('La sesión o las credenciales fueron rechazadas (HTTP 401); vuelve a iniciar sesión con cauce login.', file=sys.stderr)
        elif code == 403:
            print('La consola rechazó el acceso al diagnóstico (HTTP 403); revisa los permisos y la empresa activa.', file=sys.stderr)
        elif 300 <= code < 400:
            print(f'El gateway respondió con una redirección (HTTP {code}); comprueba --gateway. No se envió la sesión a otro destino.', file=sys.stderr)
        else:
            print(f'La consola rechazó el diagnóstico (HTTP {code}); revisa el identificador y la empresa activa.', file=sys.stderr)
    except (urllib.error.URLError, TimeoutError):
        print('No se pudo conectar con la consola; comprueba --gateway, la red y los certificados.', file=sys.stderr)
    except ContextFailure as error:
        print({
            'diagnostic identifier is unavailable': 'El identificador de diagnóstico no es válido; usa el id de la operación, la traza o el evento.',
            'diagnostic response exceeds limit': 'La respuesta del diagnóstico supera el límite permitido.',
            'diagnostic response is invalid': 'La respuesta del diagnóstico no es válida; revisa el gateway.',
        }.get(str(error), 'No se pudo leer el diagnóstico; revisa la sesión y el destino.'), file=sys.stderr)
    except (OSError, ValueError):
        print('No se pudo completar el diagnóstico; revisa la sesión de consola y el destino.', file=sys.stderr)
    return 1


raise SystemExit(main())
PY
