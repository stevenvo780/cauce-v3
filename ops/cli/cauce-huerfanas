#!/usr/bin/env bash
# cauce-huerfanas [days] lists failed deliveries that originated from a human message (default: 7).
# Tenant ownership comes from the durable row; no user identity is printed.
set -uo pipefail
DIAS=${1:-7}

case "$DIAS" in ''|*[!0-9]*) echo "uso: cauce-huerfanas [dias]" >&2; exit 2;; esac

ssh -o BatchMode=yes agora-storage \
  "docker exec -i cauce-v3-prod-postgres-1 psql -U cauce -d cauce -v dias=$DIAS -f -" <<'SQL'
\pset border 2
\pset format aligned
SELECT
  d.created_at::timestamp(0)                                   AS cuando,
  d.recipient_alias                                            AS agente,
  d.status                                                     AS estado,
  m.tenant_id                                                  AS tenant,
  -- No se imprime el cuerpo ni siquiera redactado: un resumen truncado sigue pudiendo contener
  -- datos personales. La consola autenticada es el lugar para inspeccionar el pedido concreto.
  char_length(coalesce(m.body->>'text', ''))                   AS pedido_chars,
  left(coalesce(d.last_error, '-'), 60)                        AS por_que
FROM deliveries d
JOIN messages m ON m.id = d.message_id
WHERE d.status IN ('dead','failed')
  AND d.created_at > now() - make_interval(days => :dias)
  AND m.origin->>'conversation_id' IS NOT NULL
ORDER BY d.created_at DESC;
SQL
