#!/usr/bin/env python3
from __future__ import annotations

import argparse
import getpass
import json
import math
import os
import pathlib
import re
import secrets
import stat
import sys
import time
import urllib.parse
import warnings
from http.cookies import CookieError, SimpleCookie

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from context_client import (
    ConsoleSessionClient,
    ContextFailure,
    console_failure_message,
    private_session,
    request_json,
    trusted_origin,
)

CSRF = re.compile(r'[A-Za-z0-9_-]{32,128}\Z')


class PrivateArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(2, 'Argumentos de login inválidos; usa --help.\n')


def default_session_file() -> str:
    if os.environ.get('CAUCE_CONSOLE_SESSION_FILE'):
        return os.environ['CAUCE_CONSOLE_SESSION_FILE']
    root = pathlib.Path(os.environ.get('XDG_STATE_HOME', str(pathlib.Path.home() / '.local' / 'state')))
    return str(root / 'cauce-v3' / 'console-session.json')


def check_target(parent: int, name: str) -> None:
    try:
        info = os.stat(name, dir_fd=parent, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise ContextFailure('El destino de la sesión debe ser un archivo privado de este usuario; usa --session-file con un archivo propio y permisos 600.')


def open_session_parent(location: str) -> tuple[int, str]:
    path = pathlib.Path(location).absolute()
    if '..' in path.parts or not path.name:
        raise ContextFailure('La ruta de sesión no admite ".."; elige otra ruta con --session-file.')
    descriptor = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:-1]:
            try:
                os.mkdir(part, 0o700, dir_fd=descriptor)
            except FileExistsError:
                pass
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_fd
        check_target(descriptor, path.name)
        return descriptor, path.name
    except BaseException:
        os.close(descriptor)
        raise


def write_session(parent: int, name: str, session: dict) -> None:
    temporary = '.console-session-' + secrets.token_hex(16) + '.tmp'
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(session, stream, separators=(',', ':'))
            stream.flush()
            os.fsync(stream.fileno())
        check_target(parent, name)
        os.replace(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    finally:
        try:
            os.unlink(temporary, dir_fd=parent)
        except FileNotFoundError:
            pass


def login(gateway: str, origin: str | None, email: str, password: str, session_file: str, ca_file: str | None = None) -> dict:
    gateway = trusted_origin(gateway)
    origin = trusted_origin(origin) if origin is not None else gateway
    if not isinstance(email, str) or not email or len(email) > 254 or '@' not in email \
            or any(ord(char) < 32 or ord(char) == 127 for char in email):
        raise ContextFailure('Falta un correo válido; usa --email <CORREO> o inicia cauce login en una terminal privada.')
    if not isinstance(password, str) or not password or len(password) > 4096:
        raise ContextFailure('Falta una contraseña válida; introdúcela en una terminal privada o usa --password-stdin.')
    parent, name = open_session_parent(session_file)
    try:
        result, cookies = request_json(gateway, origin, ca_file, 'POST', '/v3/auth/login', {'email': email, 'password': password})
        if not isinstance(result, dict) or result.get('authenticated') is not True:
            raise ContextFailure('El login por contraseña no está disponible o fue rechazado; revisa el acceso en la consola y vuelve a ejecutar cauce login.')
        save_login_session(parent, name, result, cookies, gateway, origin, email)
        return result
    finally:
        os.close(parent)


def save_login_session(parent: int, name: str, result: dict, cookies: list[str], gateway: str, origin: str,
                       email: str | None = None) -> None:
    csrf = result.get('csrf_token')
    cookie_values = SimpleCookie()
    try:
        for header in cookies:
            cookie_values.load(header)
    except CookieError:
        raise ContextFailure('El gateway devolvió una cookie de sesión inválida; vuelve a ejecutar cauce login y consulta al operador si se repite.') from None
    cookie = '; '.join(morsel.key + '=' + morsel.coded_value for morsel in cookie_values.values())
    if not cookie or len(cookie) > 12000 or any(ord(char) < 32 or ord(char) == 127 for char in cookie) \
            or not isinstance(csrf, str) or not CSRF.fullmatch(csrf):
        raise ContextFailure('El gateway no entregó una sesión utilizable; vuelve a ejecutar cauce login y consulta al operador si se repite.')
    session = {'version': 1, 'gateway': gateway, 'origin': origin, 'cookie': cookie, 'csrf_token': csrf}
    if email:
        session['email'] = email
    write_session(parent, name, session)


def device_login(gateway: str, origin: str, session_file: str, ca_file: str | None = None,
                 client_name: str = 'Cauce CLI') -> dict:
    gateway, origin = trusted_origin(gateway), trusted_origin(origin)
    if not client_name or len(client_name) > 80 or any(ord(char) < 32 or ord(char) == 127 for char in client_name):
        raise ContextFailure('El nombre del cliente debe tener entre 1 y 80 caracteres sin controles; revisa --client-name.')
    parent, name = open_session_parent(session_file)
    try:
        started = time.monotonic()
        grant, _ = request_json(gateway, origin, ca_file, 'POST', '/v3/auth/device', {'client_name': client_name})
        if not isinstance(grant, dict) or not isinstance(grant.get('device_code'), str) \
                or not re.fullmatch(r'[A-Za-z0-9_-]{43,128}', grant['device_code']) \
                or not isinstance(grant.get('user_code'), str) or not re.fullmatch(r'[A-Z2-9]{4}-[A-Z2-9]{4}', grant['user_code']) \
                or type(grant.get('expires_in')) is not int or not 1 <= grant['expires_in'] <= 600 \
                or type(grant.get('interval')) is not int or not 1 <= grant['interval'] <= 60:
            raise ContextFailure('El gateway devolvió una solicitud de dispositivo inválida; vuelve a ejecutar cauce login --dispositivo.')
        url = grant.get('verification_uri_complete')
        parsed = urllib.parse.urlsplit(url) if isinstance(url, str) else None
        if not parsed or trusted_origin(urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, '', '', ''))) != origin \
                or parsed.path != '/dispositivo' or parsed.fragment \
                or urllib.parse.parse_qs(parsed.query) != {'code': [grant['user_code']]} \
                or any(ord(char) < 33 or ord(char) == 127 for char in url):
            raise ContextFailure('La dirección de autorización no coincide con el origen elegido; revisa --gateway y --origin.')
        print('Abre esta dirección en tu navegador de confianza e inicia sesión en la consola:', file=sys.stderr, flush=True)
        print(url, file=sys.stderr, flush=True)
        print('Código: ' + grant['user_code'], file=sys.stderr, flush=True)
        print('Autoriza solo si reconoces esta solicitud. El código caduca en ' + str(grant['expires_in']) + ' segundos.',
              file=sys.stderr, flush=True)
        deadline = started + grant['expires_in']
        interval = grant['interval']
        while time.monotonic() < deadline:
            remaining = deadline - time.monotonic()
            time.sleep(min(interval, max(0, remaining)))
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            result, cookies = request_json(gateway, origin, ca_file, 'POST', '/v3/auth/device/token',
                {'device_code': grant['device_code']}, timeout=max(1, min(30, math.ceil(remaining))),
                accepted_error_statuses=(400,))
            if not isinstance(result, dict):
                raise ContextFailure('El gateway devolvió una respuesta de autorización inválida; vuelve a iniciar el login.')
            if result.get('authenticated') is True:
                save_login_session(parent, name, result, cookies, gateway, origin)
                return result
            error = result.get('error')
            if error == 'authorization_pending':
                continue
            if error == 'slow_down':
                interval += 5
                continue
            if error == 'access_denied':
                raise ContextFailure('La solicitud de dispositivo fue rechazada. Si necesitas acceso, inicia otra con cauce login --dispositivo.')
            if error == 'expired_token':
                break
            raise ContextFailure('No se pudo autorizar el dispositivo; vuelve a ejecutar cauce login --dispositivo.')
        raise ContextFailure('El código de dispositivo caducó. Inicia otra solicitud con cauce login --dispositivo.')
    finally:
        os.close(parent)


def safe_status(result: dict) -> dict:
    keys = ('authenticated', 'login_mode', 'subject', 'home_tenant', 'name', 'roles', 'permissions', 'expires_at')
    safe = {key: result[key] for key in keys if key in result}
    if isinstance(result.get('authority'), dict):
        safe['authority'] = {key: result['authority'][key] for key in ('role', 'scope', 'home_company', 'acting_company', 'platform_override')
                             if key in result['authority']}
    return safe


def main() -> int:
    parser = PrivateArgumentParser(prog='cauce login', allow_abbrev=False,
        description='Inicia o renueva una sesión nominal de consola sin guardar la contraseña')
    parser.add_argument('--gateway', default=os.environ.get('CAUCE_GATEWAY_URL'))
    parser.add_argument('--origin')
    parser.add_argument('--email')
    parser.add_argument('--password-stdin', action='store_true')
    parser.add_argument('--session-file', default=default_session_file())
    parser.add_argument('--ca-file')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--renew', action='store_true')
    mode.add_argument('--status', action='store_true')
    mode.add_argument('--dispositivo', '--device', dest='device', action='store_true',
        help='Autorizar desde la consola web sin teclear la contraseña en este equipo')
    parser.add_argument('--client-name', default='Cauce CLI', help='Nombre del equipo que mostrará la consola al autorizar')
    args = parser.parse_args()
    try:
        if args.status:
            if args.password_stdin or args.email:
                raise ContextFailure('--status usa solo la sesión guardada; quita --email y --password-stdin, o ejecuta cauce login sin --status.')
            client = ConsoleSessionClient(args.session_file, args.gateway, args.origin, args.ca_file)
            result = client.request('GET', '/v3/auth/session')
            if not isinstance(result, dict):
                raise ContextFailure('La respuesta de la sesión es inválida; vuelve a ejecutar cauce login y consulta al operador si se repite.')
            print(json.dumps({**safe_status(result), 'state': 'authenticated' if result.get('authenticated') is True else 'expired'}, ensure_ascii=False))
            return 0 if result.get('authenticated') is True else 1
        existing = private_session(args.session_file) if args.renew else {}
        gateway = args.gateway or existing.get('gateway')
        if not gateway:
            raise ContextFailure('Falta el gateway; usa cauce login --gateway <URL> o configura CAUCE_GATEWAY_URL.')
        origin = args.origin or existing.get('origin') or gateway
        if existing and (trusted_origin(gateway) != trusted_origin(existing.get('gateway'))
                         or trusted_origin(origin) != trusted_origin(existing.get('origin'))):
            raise ContextFailure('La renovación debe usar el gateway y origen guardados; ejecuta cauce login sin --renew para otro destino.')
        if args.device:
            if args.email or args.password_stdin:
                raise ContextFailure('--dispositivo no necesita correo ni contraseña; quita --email y --password-stdin.')
            result = device_login(gateway, origin, args.session_file, args.ca_file, args.client_name)
            print(json.dumps({**safe_status(result), 'state': 'authenticated', 'gateway': trusted_origin(gateway),
                              'session_file': str(pathlib.Path(args.session_file).absolute())}, ensure_ascii=False))
            return 0
        email = args.email or existing.get('email')
        if not email and sys.stdin.isatty():
            email = input('Correo: ').strip()
        if args.password_stdin:
            password = sys.stdin.readline(4098).removesuffix('\n').removesuffix('\r')
        elif sys.stdin.isatty():
            with warnings.catch_warnings():
                warnings.simplefilter('error', getpass.GetPassWarning)
                password = getpass.getpass('Contraseña: ')
        else:
            raise ContextFailure('Inicia cauce login en una terminal privada o usa --password-stdin; la contraseña no se pasa como argumento.')
        result = login(gateway, origin, email, password, args.session_file, args.ca_file)
        print(json.dumps({**safe_status(result), 'state': 'renewed' if args.renew else 'authenticated',
                          'gateway': trusted_origin(gateway), 'session_file': str(pathlib.Path(args.session_file).absolute())}, ensure_ascii=False))
        return 0
    except ContextFailure as error:
        print(console_failure_message(error), file=sys.stderr)
    except getpass.GetPassWarning:
        print('No hay una terminal privada; usa --password-stdin.', file=sys.stderr)
    except KeyboardInterrupt:
        print('\nInicio de sesión cancelado.', file=sys.stderr)
    except (OSError, ValueError, TypeError):
        print('No se pudo completar el login; revisa destino, permisos y sesión.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
