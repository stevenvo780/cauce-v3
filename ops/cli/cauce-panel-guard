#!/usr/bin/env bash
# cauce-panel-guard — que la sesión compartida no se quede muerta sin que nadie se entere.
#
# Verifica y repone el panel de tmux para las sesiones compartidas cuyo adaptador está activo.
#
# Comportamiento:
# - Solo interviene si el adaptador está activo (unit de systemd y proceso en contenedor).
# - No repone paneles de alias detenidos para no interferir con ciclos de apagado/reinicio.
# - Registra anomalías como `tui_absent` en el log sin forzar el cierre de la sesión de usuario.
set -uo pipefail

CONFIG=$HOME/.config/cauce-v3/container-aliases
OPS=$HOME/.local/share/cauce-v3/ops
STATE=$HOME/.local/state/cauce-attach
LOG=$STATE/guard.log
PANEL=$HOME/.local/bin/cauce-tmux-panel

# `--dry-run` dice qué haría con cada alias y no toca nada. Existe porque una corrida sana de este
# guardia es MUDA, y "mudo porque todo está bien" y "mudo porque me salté los quince" se ven igual
# desde afuera. Sin esto, la única forma de comprobar que mira a alguien es romper un panel.
DRYRUN=
[ "${1:-}" = --dry-run ] && DRYRUN=1

mkdir -p "$STATE"

# Un solo guardia a la vez. Dos `ensure` simultáneos sobre el mismo alias se pisan: uno crea la
# sesión y al otro tmux le contesta "duplicate session", que se reporta como fallo de una sesión
# que en realidad está perfecta.
exec 9>"$STATE/panel-guard.lock"
flock -n 9 || exit 0

log() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$LOG"; }

# El mismo barrido que usa `cauce`: un alias está vivo por su PROCESO, no por su nombre.
BARRIDO='for p in /proc/[0-9]*; do c=$(tr "\0" " " < "$p/cmdline" 2>/dev/null); set -- $c; case "${1:-}" in *node*|*python*) ;; *) continue;; esac; h=""; e=$(tr "\0" "\n" < "$p/environ" 2>/dev/null | sed -n "s/^CAUCE_ALIAS=//p" | head -1); [ "$e" = "@@A@@" ] && h=1; case "$c" in *cauce-v3-adapter/@@A@@/*) h=1;; esac; [ -n "$h" ] && echo "${p#/proc/}"; done'

[ -x "$PANEL" ] || { log "PANEL-GUARD: falta $PANEL, no puedo reponer nada"; exit 1; }

for env in "$CONFIG"/*.env; do
  [ -e "$env" ] || continue
  a=$(basename "$env" .env)

  # Sin sesión compartida configurada no hay panel que vigilar.
  grep -qx 'SHARED_SESSION=1' "$env" || continue

  # kant es host-native: su panel es otra unit (`cauce-v3-tmux-kant.service`) y `cauce-tmux-panel`
  # sólo sabe de contenedores. Tocarlo desde acá sería inventarse una ruta que no existe.
  systemctl --user cat "cauce-v3-host-$a.service" >/dev/null 2>&1 && continue

  # Condición de seguridad, primera mitad: para systemd el adaptador tiene que estar encendido.
  [ "$(systemctl --user is-active "cauce-v3-container-$a.service" 2>/dev/null)" = active ] || continue

  line=$(PYTHONDONTWRITEBYTECODE=1 python3 "$OPS/scripts/container-alias-query.py" "$a" 2>/dev/null) || continue
  IFS=$'\t' read -r _ _ ctr cuser _ _ harness _ <<<"$line"
  [ -n "$ctr" ] || continue

  # Segunda mitad, la que no miente: que haya un proceso del adaptador dentro del contenedor.
  [ -n "$(docker exec "$ctr" sh -c "${BARRIDO//@@A@@/$a}" 2>/dev/null)" ] || continue

  release=$(sed -n 's/^BUNDLE_RELEASE=//p' "$env" | head -1)
  [ -n "$release" ] || continue
  helper="/opt/cauce-v3-adapter/$a/releases/$release/packages/adapter-sdk/dist/src/bin/shared-session.js"
  ws=$(sed -n 's/^SHARED_SESSION_WORKSPACE=//p' "$env" | head -1)

  # Se pregunta con el MISMO helper que usan el adaptador y el CLI, para que los tres coincidan
  # siempre en qué quiere decir "la sesión está".
  estado=$(docker exec --user "$cuser" "$ctr" node "$helper" status \
             --alias "$a" --harness "$harness" --workspace "${ws:-/workspace}" 2>/dev/null)

  # Con panel vivo no se escribe nada: el guardia tiene que ser mudo cuando todo está bien.
  case "$estado" in
    *'"pid"'*) [ -n "$DRYRUN" ] && echo "OK      $a ($ctr): panel vivo -> $estado"; continue ;;
    *'"present":true'*)
      log "PANEL-GUARD $a: la sesion existe pero no tiene TUI viva adentro (tui_absent). No la toco: repararlo exige matar la sesion del dueno. Revisar a mano: cauce $a ver"
      continue ;;
  esac

  if [ -n "$DRYRUN" ]; then
    echo "REPONDRIA $a ($ctr): no hay sesion compartida y el adaptador esta vivo"
    continue
  fi
  salida=$("$PANEL" "$a" 2>&1); rc=$?
  log "PANEL REPUESTO $a: no habia sesion compartida y el adaptador estaba vivo -> rc=$rc ${salida//$'\n'/ | }"
done
