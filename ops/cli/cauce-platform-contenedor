#!/usr/bin/env bash
# Runs ops/cli/platform_admin.mjs (admin|empresa|enlace) or ops/cli/context_seed.mjs (contexto) inside
# the release runtime image, attached to the stack's backend network: production has no tsx, no host
# port for PostgreSQL and a verify-full URL whose host only resolves there. `--mostrar [OPERACIÓN...]`
# renders the service that operation would run without running it. `contexto sembrar --nativos DIR`
# binds DIR read-only into the container, so it must be readable by uid 1000.
set -euo pipefail

AQUI=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ENV_FILE=${CAUCE_ENV_FILE:-/etc/cauce-v3/prod.env}
fallar() { printf 'cauce-platform-contenedor: %s\n' "$1" >&2; exit 2; }

[ -f "$ENV_FILE" ] && [ -r "$ENV_FILE" ] || fallar "no puedo leer $ENV_FILE (CAUCE_ENV_FILE)"
valor() {  # $1=key: last assignment in the env file, read as data and never sourced
  local linea
  linea=$(grep -E "^$1=" "$ENV_FILE" | tail -n 1) || true
  linea=${linea#*=}; linea=${linea%$'\r'}
  linea=${linea#\"}; linea=${linea%\"}
  printf '%s' "$linea"
}
proyecto=$(valor COMPOSE_PROJECT_NAME)
proyecto=${proyecto:-cauce-v3-prod}
[[ $proyecto =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || fallar "COMPOSE_PROJECT_NAME no es un nombre de proyecto válido"
for script in platform_admin.mjs context_seed.mjs; do
  [ -f "$AQUI/$script" ] || fallar "falta $AQUI/$script"
done

mostrar=false
if [ "${1:-}" = --mostrar ]; then mostrar=true; shift; fi
unset CAUCE_PLATAFORMA_NATIVOS
export CAUCE_PLATAFORMA_PROYECTO="$proyecto-plataforma"
export CAUCE_PLATAFORMA_RED="${proyecto}_backend"
export CAUCE_PLATAFORMA_CLI="$AQUI"
export CAUCE_PLATAFORMA_ENTRADA=platform_admin.mjs
[ "${1:-}" = contexto ] && CAUCE_PLATAFORMA_ENTRADA=context_seed.mjs
compose=(docker compose --env-file "$ENV_FILE" -p "$CAUCE_PLATAFORMA_PROYECTO" -f "$AQUI/cauce-platform.compose.yaml")

# The host DIR of --nativos does not exist inside the container: it is bound read-only and the seed
# receives the mount point instead. A missing value is left to context_seed.mjs to reject.
argumentos=()
while [ $# -gt 0 ]; do
  if [ "$CAUCE_PLATAFORMA_ENTRADA" = context_seed.mjs ] && [ "$1" = --nativos ] && [ $# -gt 1 ] && [[ $2 != --* ]]; then
    [ -z "${CAUCE_PLATAFORMA_NATIVOS:-}" ] || fallar "--nativos no se puede repetir"
    [[ $2 != *[[:cntrl:]]* ]] || fallar "--nativos contiene caracteres inválidos"
    nativos=$(realpath -e -- "$2" 2>/dev/null) && [ -d "$nativos" ] && [ -r "$nativos" ] && [ -x "$nativos" ] \
      || fallar "--nativos no es un directorio legible: $2"
    export CAUCE_PLATAFORMA_NATIVOS="$nativos"
    compose+=(-f "$AQUI/cauce-platform.nativos.compose.yaml")
    argumentos+=(--nativos /run/cauce/nativos)
    shift 2
    continue
  fi
  argumentos+=("$1")
  shift
done

if [ "$mostrar" = true ]; then
  exec "${compose[@]}" config
fi
docker network inspect "$CAUCE_PLATAFORMA_RED" >/dev/null 2>&1 \
  || fallar "no existe la red $CAUCE_PLATAFORMA_RED: la pila $proyecto no está levantada"
exec "${compose[@]}" run --rm --no-deps cauce-platform "${argumentos[@]}"
