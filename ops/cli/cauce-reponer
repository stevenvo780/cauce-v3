#!/usr/bin/env bash
# cauce-reponer <delivery_id> replays one eligible failed delivery.
# Console mutations require an allowlisted Origin and a non-empty JSON body.
# Run this where the console client certificate is available.
# A delivery without a dead_letters row cannot be replayed.
# Replay sends the original message immediately; check for newer conversation and in-flight work first.
set -euo pipefail

ID=${1:-}
ORIGIN=${CAUCE_CONSOLE_ORIGIN:-https://consola.elenxos.com}
GW=${CAUCE_GATEWAY:-}

case "$ID" in
  '' ) echo "uso: cauce-reponer <delivery_id>   (sacalo de: cauce-huerfanas)" >&2; exit 2 ;;
  [0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]* ) ;;
  * ) echo "eso no parece un delivery_id (uuid): $ID" >&2; exit 2 ;;
esac

if [ -z "$GW" ]; then
  printf 'cauce-reponer: falta CAUCE_GATEWAY; exporta la URL del gateway antes de reponer una entrega.\n' >&2
  exit 2
fi

echo "  reponiendo entrega $ID"
SALIDA=$(ssh -o BatchMode=yes agora-storage "curl -sS -k -o /tmp/cauce-reponer.\$\$ -w '%{http_code}' \
    --cert /etc/cauce-v3/pki/console-client.crt --key /etc/cauce-v3/pki/console-client.key \
    -H 'content-type: application/json' -H 'x-cauce-operator: steven' \
    -H 'Origin: $ORIGIN' --data '{}' \
    -X POST '$GW/v3/console/deliveries/$ID/replay'; echo; cat /tmp/cauce-reponer.\$\$; rm -f /tmp/cauce-reponer.\$\$")

CODIGO=$(printf '%s' "$SALIDA" | head -1)
CUERPO=$(printf '%s' "$SALIDA" | tail -n +2)

if [ "$CODIGO" = 200 ]; then
  NUEVA=$(printf '%s' "$CUERPO" | sed -n 's/.*"delivery_id":"\([^"]*\)".*/\1/p')
  printf '  \033[32mrepuesta\033[0m — entrega nueva: %s\n' "${NUEVA:-?}"
  printf '  \033[2mmirá que termine y que SALGA: la respuesta tiene que quedar en adapter_outbox con status=sent\033[0m\n'
  exit 0
fi

printf '  \033[31mno se repuso (HTTP %s)\033[0m\n  %s\n' "$CODIGO" "$CUERPO"
[ "$CODIGO" = 404 ] && printf '  \033[2m404 suele ser: ya la repusieron, o no tiene fila en dead_letters (no replayable)\033[0m\n'
exit 1
