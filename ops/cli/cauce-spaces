PRIVATE_TEXT = re.compile(r'[/\\]|(?:\d{1,3}\.){3}\d{1,3}|(?:[a-f\d]{0,4}:){2,}[a-f\d:]*|'
                          r'ssh-|ecdsa-|SHA256:|(?:[a-f\d]{32,})|[A-Za-z\d+_=.-]{48,}', re.IGNORECASE)


def cell(value: object, width: int = 40) -> str:
    if value is None:
        return '—'
    if type(value) is bool:
        return 'Sí' if value else 'No'
    if not isinstance(value, (str, int)):
        return '—'
    text = str(value)
    if PRIVATE_TEXT.search(text) or any(unicodedata.category(char).startswith('C') for char in text):
        return '[oculto]'
    text = ' '.join(text.split())
    return text if len(text) <= width else text[:width - 1] + '…'


def timestamp(value: object) -> datetime.datetime | None:
    try:
        parsed = datetime.datetime.fromisoformat(value.replace('Z', '+00:00')) if isinstance(value, str) else None
        return parsed if parsed is not None and parsed.tzinfo is not None else None
    except ValueError:
        return None


def age(operation: dict, now: datetime.datetime) -> str:
    changed = timestamp(operation.get('updated_at')) or timestamp(operation.get('created_at'))
    if changed is None:
        return 'sin fecha'
    seconds = max(0, int((now - changed).total_seconds()))
    if seconds < 60:
        return 'hace menos de 1 min'
    if seconds < 3600:
        return f'hace {seconds // 60} min'
    if seconds < 86400:
        return f'hace {seconds // 3600} h'
    return f'hace {seconds // 86400} d'


def human_inventory(result: dict) -> str:
    now = datetime.datetime.now(datetime.UTC)
    oldest = datetime.datetime.min.replace(tzinfo=datetime.UTC)
    operations = sorted(result['operations'], key=lambda row: timestamp(row.get('created_at')) or oldest, reverse=True)
    latest = {}
    for operation in operations:
        selected = operation.get('target', {})
        if selected.get('resource') == 'agent' and selected.get('tenant_id') == result['tenant_id']:
            latest.setdefault(selected.get('alias'), operation)
    headings = ['Alias', 'Nombre visible', 'Arnés', 'Ordenador', 'Modo', 'Ciclo de vida', 'Habilitado', 'Última operación']
    rows = []
    known = set()
    for retired, agents in ((False, result['agents']), (True, result['retired_agents'])):
        for agent in agents:
            alias = agent.get('alias')
            known.add(alias)
            placement = agent.get('placement') if isinstance(agent.get('placement'), dict) else {}
            state = agent.get('lifecycle_state') or ('retired' if retired else None)
            operation = latest.get(alias)
            summary = 'Sin operaciones recientes' if operation is None else ' / '.join([
                KIND_LABELS.get(operation.get('kind'), 'Desconocida'),
                STATE_LABELS.get(operation.get('status'), 'Desconocida'), age(operation, now)])
            rows.append([cell(alias, 32), cell(agent.get('display_name'), 32), cell(agent.get('harness_id'), 16),
                         cell(agent.get('host_id') or placement.get('host_id'), 24),
                         MODE_LABELS.get(agent.get('runtime_mode') or placement.get('mode'), '—'),
                         STATE_LABELS.get(state, 'Sin estado'), cell(agent.get('enabled')), summary])
    for alias, operation in latest.items():
        if alias not in known:
            rows.append([cell(alias, 32), '—', '—', '—', '—', 'Sin registro visible', '—', ' / '.join([
                KIND_LABELS.get(operation.get('kind'), 'Desconocida'),
                STATE_LABELS.get(operation.get('status'), 'Desconocida'), age(operation, now)])])
    heading = f"Espacio: {cell(result['tenant_id'])} · Revisión: {result['revision']}"
    if not rows:
        return heading + '\nNo hay agentes ni operaciones recientes en este espacio.'
    widths = [max(len(row[index]) for row in [headings, *rows]) for index in range(len(headings))]
    lines = ['  '.join(value.ljust(width) for value, width in zip(row, widths, strict=True)).rstrip() for row in [headings, *rows]]
    return '\n'.join([heading, *lines, 'La antigüedad indica la última actualización; el historial reciente es limitado.'])


def change_values(agent: dict, *, declarative: bool = False) -> dict:
    placement = agent.get('placement') if isinstance(agent.get('placement'), dict) else {}
    values = {**agent, **({'mode': agent['runtime_mode']} if 'runtime_mode' in agent else {}), **placement}
    if declarative:
        for key in ('display_name', 'primary_account_id', 'model_id', 'reasoning_effort'):
            values.setdefault(key, None)
        values.setdefault('systemd_user', 'stev')
        values.setdefault('container_name', f"host:{values.get('host_id')}")
    return values


def human_change(result: dict, args) -> str:
    preview = result['state'] == 'preview'
    lines = [f"{'Previsualización' if preview else 'Resultado'}: "
             f"{KIND_LABELS[{'edit': 'update'}.get(args.command, args.command)]} "
             f"{cell(args.tenant)} · {cell(args.alias)}"]
    if not preview:
        lines.append('Estado: ' + STATE_LABELS.get(result['state'], 'Registro aplicado'))
        lines.append(result['message'])
        return '\n'.join(lines)
    registry = result.get('registry_only', False)
    receipt = result['receipt'] if registry else result['preview']
    lines.append(f'Revisión esperada: {args.expected_revision}')
    lines.append('Alcance: solo registro.' if registry else 'Alcance: operación de flota.')
    desired = receipt['mutation'].get('value', {}) if registry else args.preview_request['parameters']
    before = change_values(args.preview_current)
    after = change_values(desired, declarative=not registry and args.command in ('create', 'edit'))
    if args.command == 'retire':
        lines.append('Cambio: eliminar el borrador del registro.' if registry else
                     'Cambio: retirar el agente y solicitar la detención de su ejecución y la revocación de acceso.')
    else:
        for key, label in CHANGE_FIELDS.items():
            if key in after and after[key] != before.get(key):
                old, new = before.get(key), after[key]
                values = [MODE_LABELS.get(value, '—') for value in (old, new)] if key == 'mode' else [
                    'sin asignar' if value is None else cell(value) for value in (old, new)]
                lines.append(f'{label}: {values[0]} → {values[1]}')
        members = desired.get('memberships')
        if isinstance(members, list):
            lines.append(f'Membresías solicitadas: {len(members)}')
            lines.append('Se reemplazan las membresías por:')
            rooms = {room.get('id'): room.get('display_name') for room in getattr(args, 'preview_rooms', [])
                     if isinstance(room, dict) and room.get('tenant_id') == args.tenant}
            for member in members:
                room = rooms.get(member['room_id']) or member['room_id']
                lines.append(f"  Sala: {cell(room)} · Rol: {cell(member['role'])} · "
                             f"Habilitada: {cell(member.get('enabled', True))}")
        for key, label in PRIVATE_FIELDS.items():
            if key in after and after[key] != before.get(key):
                change = 'se elimina la asignación' if after[key] is None else 'cambia'
                if not registry and key in ('systemd_user', 'container_name') and key not in desired.get('placement', {}):
                    change = 'vuelve al valor predeterminado' if before.get(key) is not None else 'usa el valor predeterminado'
                lines.append(f'{label}: {change} (detalle con --json).')
    if not registry:
        lines.append('Puede aplicarse: ' + cell(receipt['can_apply']))
        lines.append(f"Dependencias detectadas: {len(receipt.get('dependencies', []))}")
    lines.append('No se aplicó ningún cambio. Usa --apply con la misma revisión y clave para solicitarlo.' if not registry else
                 'No se aplicó ningún cambio. Usa --apply con la misma revisión para solicitarlo.')
    return '\n'.join(lines)


class PrivateArgumentParser(argparse.ArgumentParser):
    def error(self, _message):
        self.print_usage(sys.stderr)
        self.exit(2, 'Argumentos de spaces inválidos; usa --help.\n')


def canonical(value: object) -> str:
    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(',', ':'), allow_nan=False)


def request_hash(value: dict) -> str:
    return hashlib.sha256(canonical(value).encode()).hexdigest()


def require_object(value: object, keys: frozenset, label: str) -> dict:
    if not isinstance(value, dict) or set(value) - keys:
        raise ContextFailure(f'{label}: formato inválido o campos no permitidos.')
    return value


def input_document(location: str) -> dict:
    path = pathlib.Path(location).absolute()
    try:
        raw = read_scoped(path.parent, path.name, 262144)
        def pairs(items):
            result = {}
            for key, value in items:
                if key in result:
                    raise ValueError
                result[key] = value
            return result
        value = json.loads(raw, object_pairs_hook=pairs, parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
    except (ValueError, UnicodeError, OSError):
        raise ContextFailure('No se pudo leer un JSON regular, acotado y sin campos duplicados.') from None
    if not isinstance(value, dict):
        raise ContextFailure('El JSON de entrada debe ser un objeto.')
    return value


def parameters(value: dict) -> dict:
    require_object(value, PARAMETER_KEYS, 'Parámetros de ejecución')
    if not {'runtime_key', 'harness_id', 'primary_room_id', 'memberships', 'placement'} <= set(value):
        raise ContextFailure('Faltan runtime_key, harness_id, primary_room_id, memberships o placement.')
    for key in PARAMETER_KEYS - {'placement', 'memberships'}:
        if key in value and not isinstance(value[key], str) and value[key] is not None:
            raise ContextFailure('Los campos de identidad y perfil deben ser texto o null.')
    if isinstance(value.get('display_name'), str):
        value['display_name'] = value['display_name'].strip()
    placement = require_object(value['placement'], PLACEMENT_KEYS, 'Ubicación')
    if not {'host_id', 'mode', 'runtime_user', 'home_directory', 'state_directory'} <= set(placement):
        raise ContextFailure('Completa host_id, mode, runtime_user, home_directory y state_directory.')
    if any(not isinstance(item, str) for item in placement.values()):
        raise ContextFailure('Los campos de ubicación deben ser texto.')
    members = value['memberships']
    if not isinstance(members, list) or not 1 <= len(members) <= 100:
        raise ContextFailure('Las membresías deben contener entre 1 y 100 grupos.')
    for member in members:
        require_object(member, frozenset({'room_id', 'role', 'enabled'}), 'Membresía')
        if not {'room_id', 'role'} <= set(member):
            raise ContextFailure('Cada membresía requiere room_id y role.')
        if not isinstance(member['room_id'], str) or not isinstance(member['role'], str) \
                or 'enabled' in member and type(member['enabled']) is not bool:
            raise ContextFailure('La membresía requiere room_id/role de texto y enabled booleano.')
        member['role'] = member['role'].strip()
    return value


def snapshot(client, tenant: str) -> dict:
    value = client.request('GET', CONFIG)
    if not isinstance(value, dict) or type(value.get('revision')) is not int or value['revision'] < 0:
        raise ContextFailure('El servidor no publicó una revisión durable de configuración.')
    tenants = value.get('tenants', []) + value.get('retired', {}).get('tenants', [])
    if not any(isinstance(row, dict) and row.get('id') == tenant for row in tenants):
        raise ContextFailure('El espacio de trabajo no figura en tu inventario autorizado.')
    return value


def target(args) -> dict:
    return {'resource': 'agent', 'tenant_id': args.tenant, 'alias': args.alias}


def history(client, selected: dict) -> list:
    result = client.request('GET', OPERATIONS + '?' + urllib.parse.urlencode(selected))
    rows = result.get('operations') if isinstance(result, dict) else None
    if not isinstance(rows, list) or any(not isinstance(row, dict) or row.get('target') != selected
                                       or row.get('status') not in STATUSES for row in rows):
        raise ContextFailure('El servidor no devolvió un historial durable del agente seleccionado.')
    return rows


def operation_result(value: dict, request: dict) -> dict:
    if not isinstance(value, dict) or value.get('target') != request['target'] or value.get('kind') != request['kind'] \
            or value.get('request_sha256') != request_hash(request) \
            or value.get('expected_revision') != request['expected_revision'] \
            or value.get('status') not in STATUSES or not isinstance(value.get('id'), str) \
            or type(value.get('version')) is not int or value['version'] < 0:
        raise ContextFailure('No se pudo acreditar el recibo solicitado; consulta spaces list antes de reintentar.')
    state = value['status']
    message = 'Operación registrada; consulta su estado con spaces list. El runtime aún no está acreditado.'
    if state == 'succeeded':
        message = 'El servidor acredita la operación completada en su recibo durable.'
    elif state in ('failed', 'cancelled'):
        message = 'La operación terminó sin completar el efecto solicitado; conserva el recibo para recuperarla desde la consola.'
    return {'state': state, 'message': message, 'operation': value}


def accepted_result(accepted: object, request: dict) -> dict:
    operation = accepted.get('operation') if isinstance(accepted, dict) else None
    if not isinstance(operation, dict) or accepted.get('operation_id') != operation.get('id') \
            or accepted.get('status') != operation.get('status'):
        raise ContextFailure('No se pudo acreditar la aceptación; consulta spaces list antes de reintentar.')
    return operation_result(operation, request)


def fleet_change(client, args) -> dict:
    if not args.idempotency_key or not IDEMPOTENCY.fullmatch(args.idempotency_key):
        raise ContextFailure('Indica --idempotency-key con 8 a 128 letras, números, guiones o guiones bajos.')
    request = {'kind': {'edit': 'update'}.get(args.command, args.command), 'target': target(args),
               'expected_revision': args.expected_revision, 'idempotency_key': args.idempotency_key,
               'parameters': {} if args.command == 'retire' else parameters(input_document(args.input))}
    args.preview_request = request
    if args.apply:
        prior = next((row for row in history(client, request['target'])
                      if row.get('request_sha256') == request_hash(request)), None)
        if prior is not None:
            return accepted_result(client.request('POST', OPERATIONS, request), request)
    current = snapshot(client, args.tenant)
    args.preview_rooms = current.get('rooms', [])
    args.preview_current = next((row for row in current.get('agents', [])
                                 if row.get('tenant_id') == args.tenant and row.get('alias') == args.alias), {})
    if current['revision'] != args.expected_revision:
        raise ContextFailure('La revisión cambió; relee spaces list y prepara otra previsualización.')
    capability = client.request('GET', '/v3/console/fleet/capability')
    if not isinstance(capability, dict) or capability.get('available') is not True \
            or request['kind'] not in capability.get('actions', []):
        raise ContextFailure('El servidor no acredita capacidad para esta operación; habilita su ejecutor y catálogo.')
    preview = client.request('POST', OPERATIONS + '/preview', request)
    if not isinstance(preview, dict) or preview.get('target') != request['target'] \
            or preview.get('kind') != request['kind'] or preview.get('expected_revision') != args.expected_revision \
            or preview.get('request_sha256') != request_hash(request) or type(preview.get('can_apply')) is not bool:
        raise ContextFailure('El servidor devolvió una previsualización distinta de la solicitud.')
    if not args.apply:
        return {'state': 'preview', 'preview': preview}
    if not preview['can_apply']:
        raise ContextFailure('La previsualización bloquea el cambio por dependencias; no se encoló nada.')
    return accepted_result(client.request('POST', OPERATIONS, request), request)


def registry_receipt(value: dict, mutation: dict, revision: int, dry_run: bool) -> dict:
    expected_hash = hashlib.sha256(('cauce-v3:configuration-mutation:v1\n' + canonical(mutation)).encode()).hexdigest()
    if not isinstance(value, dict) or value.get('mutation') != mutation or value.get('dry_run') is not dry_run \
            or value.get('applied') is not (not dry_run) or value.get('rolled_back_revision_id') is not None \
            or type(value.get('revision')) is not int \
            or (value['revision'] != revision if dry_run else value['revision'] <= revision) \
            or value.get('mutation_sha256', expected_hash) != expected_hash:
        raise ContextFailure('No se pudo acreditar el recibo versionado del registro solicitado.')
    return value


def registry_value(args) -> dict:
    value = input_document(args.input)
    require_object(value, REGISTRY_KEYS if args.command == 'create' else REGISTRY_EDIT_KEYS, 'Registro')
    if not value:
        raise ContextFailure('El cambio de registro debe contener al menos un campo.')
    if 'enabled' in value and value['enabled'] is not False:
        raise ContextFailure('Habilitar el agente requiere una operación de flota verificada.')
    for key, item in value.items():
        if key not in ('enabled', 'max_concurrent_deliveries') and not isinstance(item, str) and item is not None:
            raise ContextFailure('Los campos del registro deben ser texto o null.')
        if key == 'max_concurrent_deliveries' and item is not None and type(item) is not int:
            raise ContextFailure('max_concurrent_deliveries debe ser entero o null.')
        if isinstance(item, str) and key in ('display_name', 'container_name', 'runtime_user', 'home_directory', 'state_directory'):
            value[key] = item.strip()
    if args.command == 'create':
        value['enabled'] = False
    return value


def registry_change(client, args) -> dict:
    current = snapshot(client, args.tenant)
    args.preview_current = next((row for row in current.get('agents', [])
                                 if row.get('tenant_id') == args.tenant and row.get('alias') == args.alias), {})
    if current['revision'] != args.expected_revision:
        raise ContextFailure('La revisión cambió; relee spaces list antes de cambiar el registro.')
    mutation = {'resource': 'agent', 'action': {'create': 'create', 'edit': 'update', 'retire': 'delete'}[args.command],
                'tenant_id': args.tenant, 'alias': args.alias}
    if args.command == 'retire':
        agents = current.get('agents', []) + current.get('retired', {}).get('agents', [])
        agent = next((row for row in agents
                      if row.get('tenant_id') == args.tenant and row.get('alias') == args.alias), None)
        if agent is not None and agent.get('runtime_key') is not None:
            raise ContextFailure('Este agente tiene ejecución; retíralo sin --registry-only mediante una operación de flota.')
    else:
        mutation['value'] = registry_value(args)
    body = {'dry_run': True, 'expected_revision': args.expected_revision, 'mutation': mutation}
    preview = registry_receipt(client.request('POST', CONFIG + '/changes', body), mutation, args.expected_revision, True)
    if not args.apply:
        return {'state': 'preview', 'registry_only': True, 'receipt': preview}
    body['dry_run'] = False
    receipt = registry_receipt(client.request('POST', CONFIG + '/changes', body), mutation, args.expected_revision, False)
    message = 'Registro eliminado. No se ejecutó ninguna operación física.' if args.command == 'retire' \
        else 'Registro actualizado. Este recibo no acredita un runtime operativo.'
    return {'state': 'registry_applied', 'registry_only': True, 'message': message, 'receipt': receipt}


def list_spaces(client, args) -> dict:
    current = snapshot(client, args.tenant)
    def selected(row):
        return isinstance(row, dict) and row.get('tenant_id') == args.tenant \
            and (args.alias is None or row.get('alias') == args.alias)
    agents = [row for row in current.get('agents', []) if selected(row)]
    retired = [row for row in current.get('retired', {}).get('agents', []) if selected(row)]
    if args.alias:
        operations = history(client, target(args))
    else:
        recent = client.request('GET', OPERATIONS + '/recent?limit=200')
        rows = recent.get('operations') if isinstance(recent, dict) else None
        if not isinstance(rows, list) or any(not isinstance(row, dict) or not isinstance(row.get('target'), dict)
                                           or row.get('status') not in STATUSES for row in rows):
            raise ContextFailure('No se pudo acreditar el historial reciente de operaciones.')
        operations = [row for row in rows if row['target'].get('resource') == 'agent'
                      and row['target'].get('tenant_id') == args.tenant]
    def project(row):
        return {key: value for key, value in row.items() if key in AGENT_FIELDS}
    return {'state': 'observed', 'tenant_id': args.tenant, 'revision': current['revision'],
            'agents': [project(row) for row in agents], 'retired_agents': [project(row) for row in retired],
            'operations': operations, 'history_limit': 100 if args.alias else 200}


def parser() -> argparse.ArgumentParser:
    result = PrivateArgumentParser(description='Registro y operaciones durables de espacios de agentes con sesión humana.')
    commands = result.add_subparsers(dest='command', required=True)
    for name in ('create', 'list', 'edit', 'retire'):
        command = commands.add_parser(name)
        command.add_argument('--session-file')
        command.add_argument('--gateway')
        command.add_argument('--origin')
        command.add_argument('--ca-file')
        command.add_argument('--json', action='store_true', help='Muestra el JSON completo para scripts, incluidos los detalles internos.')
        command.add_argument('--tenant', required=True)
        command.add_argument('--alias', required=name != 'list')
        if name == 'list':
            continue
        command.add_argument('--expected-revision', type=int, required=True)
        command.add_argument('--idempotency-key')
        command.add_argument('--apply', action='store_true', help='Aplica después de previsualizar; sin esta opción solo muestra el plan.')
        command.add_argument('--registry-only', action='store_true',
                             help='Solo cambia el registro; retire elimina un borrador sin ejecución.')
        if name != 'retire':
            command.add_argument('--input', required=True, help='JSON de parameters de flota, o value del registro con --registry-only.')
    return result


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    try:
        if not IDENTITY.fullmatch(args.tenant) or args.alias is not None and not IDENTITY.fullmatch(args.alias):
            raise ContextFailure('Tenant y alias deben ser identificadores explícitos válidos.')
        if args.command != 'list' and args.expected_revision < 0:
            raise ContextFailure('--expected-revision debe ser una revisión no negativa.')
        module = runpy.run_path(str(CLI / 'cauce-login'), run_name='cauce_console_session')
        client = module['ConsoleSessionClient'](args.session_file or module['default_session_file'](),
                                              gateway=args.gateway, origin=args.origin, ca_file=args.ca_file)
        if args.command == 'list':
            result = list_spaces(client, args)
        elif getattr(args, 'registry_only', False):
            result = registry_change(client, args)
        else:
            result = fleet_change(client, args)
        print(json.dumps(result, ensure_ascii=False, separators=(',', ':')) if args.json else
              human_inventory(result) if args.command == 'list' else human_change(result, args))
        return 1 if result['state'] == 'failed' else 0
    except ContextFailure as error:
        print('cauce spaces: ' + context_client.console_failure_message(error), file=sys.stderr)
        return 1
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        print('cauce spaces: No se pudo verificar la sesión, la entrada o el recibo del gateway.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
