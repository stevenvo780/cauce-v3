                         'max_concurrent_deliveries'})
REGISTRY_EDIT_KEYS = frozenset({'display_name', 'enabled', 'max_concurrent_deliveries'})
AGENT_FIELDS = REGISTRY_KEYS | frozenset({'tenant_id', 'alias', 'runtime_key', 'runtime_mode', 'systemd_user',
    'primary_account_id', 'model_id', 'reasoning_effort', 'lifecycle_state', 'placement', 'retired_at', 'purged_at'})
