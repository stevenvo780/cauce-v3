# Copiar como config/dev.env y completar localmente. No versionar el resultado.
COMPOSE_PROJECT_NAME=cauce-v3-dev
POSTGRES_DB=cauce
POSTGRES_USER=cauce
POSTGRES_PASSWORD=
DATABASE_URL=
PGSSLMODE=prefer
NODE_ENV=development
CAUCE_DEV_AUTH=1
CAUCE_DEV_BIND_IP=127.0.0.1
GATEWAY_PORT=8080
CONSOLE_PORT=8081
CAUCE_CONSOLE_TENANT=Steven
CAUCE_CONSOLE_ALIAS=kant
DISPATCHER_POLL_MS=100
CAUCE_ACK_DEADLINE_MS=600000
ACK_TIMEOUT_MS=600000
INTERACTIVE_BURST=3
# Profiles opcionales telegram/shadow usan directorios externos; /dev/null falla cerrado.
CAUCE_TELEGRAM_RUNTIME_DIR=
CAUCE_TELEGRAM_ALIASES=
SHADOW_ROUTER_MODE=shadow
SHADOW_ROUTER_TENANTS=Steven
CAUCE_SHADOW_ROUTER_SOCKET_DIR=
CAUCE_SHADOW_V2_SOCKET_DIR=
CAUCE_SHADOW_V3_SOCKET_DIR=
