# Target externo TLS. No incluir tokens ni credenciales en este archivo versionable.
CAUCE_BASE_URL=https://127.0.0.1:8443
CAUCE_WS_URL=wss://127.0.0.1:8443/v3/ws
NODE_EXTRA_CA_CERTS=
CAUCE_HTTP_TIMEOUT_MS=5000
CAUCE_WS_TIMEOUT_MS=5000
CAUCE_PRESENCE_LEASE_MS=500
CAUCE_RETRY_TIMEOUT_MS=15000
CAUCE_FAULT_MODE=none
CAUCE_FAULT_CONFIRM=
