# Cauce PostgreSQL is always mandatory. Enable this only on a host that also
# owns the independent ut-nexus SQLite volume and has installed its backup script.
UT_NEXUS_ENABLED=0

# A release/incident snapshot must set this to 1 for that one run. It preserves every local
# generation after the append-only offsite checksum gate; ordinary scheduled runs leave it at 0.
CAUCE_BACKUP_SKIP_RETENTION=0

# The private key is generated on the database host and restricted on the NAS
# to rrsync write-only access inside the Cauce backup root. Never commit it.
OFFSITE_KEY=/root/.ssh/id_ed25519_cauce_backup_offsite
OFFSITE_HOST=100.64.0.4
OFFSITE_USER=nas
