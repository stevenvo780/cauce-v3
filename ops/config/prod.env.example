# Solo PATHs/config no secretos. Copiar fuera del repo como modo 0600 y completar allí.
COMPOSE_PROJECT_NAME=cauce-v3-prod
CAUCE_RUNTIME_IMAGE=
CAUCE_CONSOLE_IMAGE=
CAUCE_OTEL_IMAGE=
CAUCE_PROMETHEUS_IMAGE=
CAUCE_PRIVATE_BIND_IP=127.0.0.1
GATEWAY_TLS_PORT=8443
CONSOLE_TLS_PORT=8444
CAUCE_AUTH_PROVIDER=
CAUCE_OIDC_ISSUER=
CAUCE_OIDC_AUDIENCE=
CAUCE_OIDC_JWKS_URL=
CAUCE_OIDC_AUTHORIZATION_URL=
CAUCE_OIDC_TOKEN_URL=
CAUCE_OIDC_CLIENT_ID=
CAUCE_OIDC_REDIRECT_URI=
CAUCE_OIDC_POST_LOGIN_PATH=/
# Siempre requerido con provider=oidc: 32 bytes aleatorios, hex o base64, fuera del repo.
CAUCE_GATEWAY_OIDC_SESSION_KEY_PATH=
# Para cliente confidencial, completar ambos; para PKCE público, dejarlos vacíos.
CAUCE_GATEWAY_OIDC_CLIENT_SECRET_PATH=
CAUCE_OIDC_CLIENT_SECRET_CONTAINER_FILE=
CAUCE_CONSOLE_ORIGINS=
CAUCE_ACK_DEADLINE_MS=600000
ACK_TIMEOUT_MS=600000
CAUCE_DATABASE_URL_SECRET_PATH=
CAUCE_POSTGRES_CA_PATH=
CAUCE_GATEWAY_TLS_CERT_PATH=
CAUCE_GATEWAY_TLS_KEY_PATH=
CAUCE_GATEWAY_TLS_CA_PATH=
CAUCE_GATEWAY_CLIENT_CA_PATH=
# Directorio (no archivo) con SOLO mtls_identities.json y token_hashes.json. Se monta read-only en
# /run/cauce-identities. Debe ser un directorio porque ambos registros se releen en cada request y se
# rotan por rename atomico: un bind de archivo suelto quedaria pinneado al inodo viejo y ni las altas
# ni las revocaciones llegarian al gateway. No dejar backups de rotacion adentro. Con provider=oidc
# igual hay que apuntarlo a un directorio existente (puede estar vacio).
CAUCE_GATEWAY_IDENTITY_DIR=
CAUCE_CONSOLE_TLS_CERT_PATH=
CAUCE_CONSOLE_TLS_KEY_PATH=
CAUCE_CONSOLE_TLS_CA_PATH=
CAUCE_CONSOLE_GATEWAY_CLIENT_CERT_PATH=
CAUCE_CONSOLE_GATEWAY_CLIENT_KEY_PATH=
CAUCE_LOCAL_POSTGRES=0
# Si CAUCE_LOCAL_POSTGRES=1, completar PATHs de password/cert/key; el cert debe tener SAN=postgres.
CAUCE_POSTGRES_IMAGE=
CAUCE_POSTGRES_PASSWORD_PATH=
CAUCE_POSTGRES_SERVER_CERT_PATH=
CAUCE_POSTGRES_SERVER_KEY_PATH=
POSTGRES_DB=cauce
POSTGRES_USER=cauce
# Profiles opt-in: origin-relay, telegram, shadow, observability.
COMPOSE_PROFILES=observability
CAUCE_RELAY_PROVIDER_MODULE_PATH=
CAUCE_RELAY_ALLOWED_ORIGINS=
CAUCE_RELAY_ADAPTERS=
CAUCE_TELEGRAM_RUNTIME_DIR=
CAUCE_TELEGRAM_ALIASES=
SHADOW_ROUTER_MODE=shadow
SHADOW_ROUTER_TENANTS=
SHADOW_ROUTER_CUTOVER_DIRECTION=
SHADOW_ROUTER_ENABLE_CUTOVER=
CAUCE_SHADOW_ROUTER_SOCKET_DIR=
CAUCE_SHADOW_V2_SOCKET_DIR=
CAUCE_SHADOW_V3_SOCKET_DIR=

# --- Canal PTY de la consola (terminal-relay + pty-agent) --------------------------------
# Todo el plano queda APAGADO con CAUCE_TERMINAL_ENABLED=0: el gateway no registra las rutas,
# /v3/console/terminal/capability responde 501 y la consola muestra el panel deshabilitado con
# motivo. Encenderlo exige, ademas de poner 1, los cuatro secretos de abajo.
CAUCE_TERMINAL_ENABLED=0
CAUCE_TERMINAL_WS_PATH=/v3/console/terminal/ws
# Lista separada por comas de operadores humanos habilitados en la cabecera x-cauce-operator.
# Vacia = todo pedido a un tenant ajeno se rechaza con 403 attribution_required.
CAUCE_TERMINAL_OPERATORS=
# CN del certificado de cliente con el que el nginx de la consola se presenta ante el relay.
CAUCE_TERMINAL_CONSOLE_CN=console
# Directorio (NO archivo) montado read-only en el gateway y en el relay. Tiene que contener
# grants.json y pty_agent_identities.json. Es un bind de DIRECTORIO a proposito: los dos se rotan
# por rename atomico y un bind de archivo dejaria al gateway leyendo el inodo viejo para siempre,
# con lo cual una revocacion no llegaria nunca.
CAUCE_TERMINAL_CONFIG_DIR=
# Clave maestra de tickets: exactamente 32 bytes. De aca se deriva por HKDF la k_alias de cada
# destino, que es la unica clave que ve el pty-agent dentro del contenedor.
CAUCE_TERMINAL_TICKET_KEY_PATH=
# Bearer con el que el relay se autentica contra /v3/terminal/relay/*. Minimo 32 caracteres.
CAUCE_TERMINAL_RELAY_TOKEN_PATH=
# Certificado del relay. Los agentes lo alcanzan por IP en la tailnet, asi que el cert necesita
# SAN de IP (o el .env del alias tiene que fijar RELAY_SERVER_NAME).
CAUCE_TERMINAL_RELAY_TLS_CERT_PATH=
CAUCE_TERMINAL_RELAY_TLS_KEY_PATH=
# Puerto donde los pty-agent de kratos marcan hacia adentro. El relay NUNCA disca a un contenedor.
TERMINAL_RELAY_AGENT_PORT=8445
