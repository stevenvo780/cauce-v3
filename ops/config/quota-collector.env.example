# Instalar como ~/.config/cauce-v3/quota-collector.env (usuario stev en kratos), modo 0600.
# Solo config no secreta: los secretos (client.key) viven aparte, bajo CAUCE_QUOTA_PKI_DIR,
# con el mismo layout que ya usa container-adapters.md (client.crt/client.key/ca.crt, 0600).
CAUCE_QUOTA_GATEWAY_URL=https://100.64.0.6:8443/v3/quotas/samples
# Dejar vacio si el cert del gateway trae la IP de arriba como SAN (caso esperado). Completar
# SOLO si no la trae -- mismo escape hatch que RELAY_SERVER_NAME en ops/pty-agent/README.md.
CAUCE_QUOTA_GATEWAY_SERVER_NAME=
CAUCE_QUOTA_PKI_DIR=/home/stev/.config/cauce-v3/container-pki/quota-collector
# Explicito y no derivado de hostname(): dos hosts logueados con suscripciones DISTINTAS bajo
# el mismo nombre de proveedor es justo el caso que la 013 modela por (host, provider, ...).
CAUCE_QUOTA_HOST=kratos
CAUCE_QUOTA_AI_USAGE_CMD=ai-usage --json
CAUCE_QUOTA_AI_USAGE_TIMEOUT_SECONDS=45
# Proveedores conocidos, usados SOLO como fallback cuando el CLI entero no responde o devuelve
# una forma irreconocible: se publica un reporte ok=false por cada uno en vez de no publicar
# nada. Ajustar si se agrega/retira una suscripcion.
CAUCE_QUOTA_PROVIDERS=claude,codex,antigravity,opencode
CAUCE_QUOTA_ACCOUNT_BINDINGS_FILE=/home/stev/.config/cauce-v3/quota-collector/account-bindings.json
CAUCE_QUOTA_HTTP_TIMEOUT_SECONDS=20
CAUCE_QUOTA_HTTP_RETRIES=2
CAUCE_QUOTA_HTTP_RETRY_DELAY_SECONDS=3
