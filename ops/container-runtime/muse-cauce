#!/bin/bash
# Bridge between the Cauce adapter and Muse Code ("muse"): copies the prompt from stdin to a temp file (`muse exec --prompt-file` rejects /dev/stdin), re-links MUSE_CONFIG_DIR into ~/.config/muse if a re-flattened image dropped it, and runs at MUSE_REASONING_EFFORT (default "max", adapter only).
set -u
MUSE_CONFIG_DIR="${MUSE_CONFIG_DIR:-$HOME/.local/share/cauce-v3/config/hegel/.config/muse}"
if [ ! -e "$HOME/.config/muse" ] && [ -d "$MUSE_CONFIG_DIR" ]; then
  mkdir -p "$HOME/.config" && ln -s "$MUSE_CONFIG_DIR" "$HOME/.config/muse"
fi
tmp=$(mktemp "${TMPDIR:-/tmp}/muse-prompt.XXXXXX") || exit 70
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
"$HOME/.local/bin/muse" "$@" --reasoning-effort "${MUSE_REASONING_EFFORT:-max}" --prompt-file "$tmp"
