#!/usr/bin/python3
"""Installs the image-pinned Muse binary into the profile prefix.

Muse has no npm package. The image digest stays pinned; this copies
/usr/local/bin/muse onto /home/node/.local/bin/muse. A symlink that resolves
outside the image pin is refused. auth.json is never opened. The profile copy
shadows the image binary until the pin changes and update_cli runs again, so
the before and after versions match until then. The session under
~/.config/muse stays untouched.
"""
import os
import pathlib
import stat


def install_pinned_cli(source, destination, allowed_source_root):
    root = pathlib.Path(allowed_source_root).resolve()
    resolved = pathlib.Path(source).resolve(strict=True)
    if not resolved.is_relative_to(root) or not resolved.is_file() or resolved.is_symlink():
        raise ValueError('muse update source escapes the image pin')
    destination = pathlib.Path(destination)
    if destination.is_symlink():
        destination.unlink()
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + '.new')
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            with resolved.open('rb') as origin:
                while True:
                    chunk = origin.read(1024 * 1024)
                    if not chunk:
                        break
                    stream.write(chunk)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    if stat.S_IMODE(destination.stat().st_mode) != 0o755 or destination.read_bytes() != resolved.read_bytes():
        raise ValueError('muse update did not install the pinned binary')


def main():
    try:
        install_pinned_cli(pathlib.Path('/usr/local/bin/muse'), pathlib.Path('/home/node/.local/bin/muse'),
                           pathlib.Path('/usr/local/bin'))
    except (OSError, ValueError):
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
