#!/bin/bash
# Empuja server2 -> VPS (no al reves: el VPS no tiene llave hacia server2). Solo viajan porcentajes y correos: el token no sale del contenedor.
set -u
DEST=/home/stev/.local/share/cauce-quota-http/cuotas-cli.json
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
/home/server/cuotas-cli/cuotas-claude-local --json > "$TMP" 2>/dev/null
[ -s "$TMP" ] || { echo "sin salida"; exit 1; }
# Fichero temporal y renombrado atomico: la sonda nunca lee una version a medias.
if timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=15 vps-tn "cat > $DEST.tmp && chown stev:stev $DEST.tmp && chmod 600 $DEST.tmp && mv $DEST.tmp $DEST" < "$TMP"; then
  echo "publicado $(wc -l < "$TMP") cuentas en el VPS"
else
  echo "no pude publicar"; exit 1
fi
