[Unit]
Description=Cauce V3 alias consumer hades (Steven/grok)
After=network-online.target cauce-v3-compose@prod.service
Wants=network-online.target
ConditionPathExists=/etc/cauce-v3/aliases/hades.env
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=cauce-v3
Group=cauce-v3
UMask=0077
Environment=CAUCE_ALIAS=hades
Environment=CAUCE_TENANT=Steven
Environment=CAUCE_ROOM=grp.steven
Environment=CAUCE_HARNESS=grok
Environment=CAUCE_SEMBRAR_PERFIL=1
Environment=CAUCE_ORIGIN_TRANSPORT=telegram
Environment=CAUCE_ENVIRONMENT=production
Environment=CAUCE_INSTANCE_ID=systemd-hades
Environment=CAUCE_STATE_DIR=/var/lib/cauce-v3/aliases/hades
Environment=CAUCE_RELAY_URL_ENV=CAUCE_HADES_RELAY_URL
Environment=CAUCE_TOKEN_PATH_ENV=CAUCE_HADES_TOKEN_PATH
Environment=CAUCE_CERT_PATH_ENV=CAUCE_HADES_CERT_PATH
Environment=CAUCE_KEY_PATH_ENV=CAUCE_HADES_KEY_PATH
Environment=CAUCE_CA_PATH_ENV=CAUCE_HADES_CA_PATH
Environment=CAUCE_EXEC_PATH_ENV=CAUCE_HADES_EXEC_PATH
EnvironmentFile=/etc/cauce-v3/aliases/hades.env
ExecStart=/opt/cauce-v3/ops/scripts/alias-runner.sh hades
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillMode=mixed
StateDirectory=cauce-v3/aliases/hades
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadOnlyPaths=/opt/cauce-v3
ReadWritePaths=/var/lib/cauce-v3/aliases/hades

[Install]
WantedBy=multi-user.target
