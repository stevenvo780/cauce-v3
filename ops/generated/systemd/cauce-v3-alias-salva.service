[Unit]
Description=Cauce V3 alias consumer salva (Isa/codex)
After=network-online.target cauce-v3-compose@prod.service
Wants=network-online.target
ConditionPathExists=/etc/cauce-v3/aliases/salva.env
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=cauce-v3
Group=cauce-v3
UMask=0077
Environment=CAUCE_ALIAS=salva
Environment=CAUCE_TENANT=Isa
Environment=CAUCE_ROOM=grp.isa
Environment=CAUCE_HARNESS=codex
Environment=CAUCE_SEMBRAR_PERFIL=1
Environment=CAUCE_ORIGIN_TRANSPORT=telegram
Environment=CAUCE_ENVIRONMENT=production
Environment=CAUCE_INSTANCE_ID=systemd-salva
Environment=CAUCE_STATE_DIR=/var/lib/cauce-v3/aliases/salva
Environment=CAUCE_RELAY_URL_ENV=CAUCE_SALVA_RELAY_URL
Environment=CAUCE_TOKEN_PATH_ENV=CAUCE_SALVA_TOKEN_PATH
Environment=CAUCE_CERT_PATH_ENV=CAUCE_SALVA_CERT_PATH
Environment=CAUCE_KEY_PATH_ENV=CAUCE_SALVA_KEY_PATH
Environment=CAUCE_CA_PATH_ENV=CAUCE_SALVA_CA_PATH
Environment=CAUCE_EXEC_PATH_ENV=CAUCE_SALVA_EXEC_PATH
EnvironmentFile=/etc/cauce-v3/aliases/salva.env
ExecStart=/opt/cauce-v3/ops/scripts/alias-runner.sh salva
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillMode=mixed
StateDirectory=cauce-v3/aliases/salva
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadOnlyPaths=/opt/cauce-v3
ReadWritePaths=/var/lib/cauce-v3/aliases/salva

[Install]
WantedBy=multi-user.target
