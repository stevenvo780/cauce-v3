#!/usr/bin/env python3
"""ai-live — REAL per-account quota for the fleet, used directly from the control host.

  Usage:
      cauce-ai-live            # readable table
      cauce-ai-live --json     # raw, for other programs
      cauce-ai-live --context  # additionally rewrites the file read by agents

Each Claude browser account gets its own CDP port. Real quota only comes from claude.ai's own
/api/organizations/{uuid}/usage endpoint, read inside that account's browser session. Codex
quota comes from its own read-only RPC (codex-probe.py) without consuming a turn.

Account identity is taken from the email in /api/organizations, never from the on-screen name.

Missing data is not quota: a session that dropped reports `ok=false` with its reason — never
0% or 100%. A false 0% would pause a live account; a false 100% would push work at a dead one.
"""

from __future__ import annotations

import argparse
import datetime
import io
import json
import os
import subprocess
import sys
import time

BASE = "/home/stev/.local/share/cauce-ai-live"
sys.path.insert(0, BASE)
import cdp

# One browser account per CDP port. The label is neutral on purpose: the real email is
# discovered live and only printed in --json.
CUENTAS_PATH = os.environ.get(
    "CAUCE_AI_LIVE_CUENTAS",
    "/datos/agents/shared/.local/share/ai-usage-live/claude-cdp-accounts.json",
)
# Embedded fallback: known Claude accounts. Used only if the shared file is missing or
# fails to parse, and never silently falls back to a shorter list.
CLAUDE_RESPALDO = [
    {"label": "claude#1", "port": 9241},
    {"label": "claude#2", "port": 9242},
    {"label": "claude#3", "port": 9243},
    {"label": "claude#4", "port": 9247},
]


def carga_cuentas() -> list:
    """Read the account list from the shared file used by the banner probe."""
    try:
        with io.open(CUENTAS_PATH, encoding="utf-8") as fh:
            crudo = json.load(fh)
        cuentas = []
        for i, c in enumerate(crudo.get("accounts") or []):
            cuentas.append({"label": str(c.get("slot") or "claude#%d" % (i + 1)),
                            "port": int(c["port"])})
        if cuentas:
            return cuentas
    except Exception as e:
        print("aviso: no pude leer %s (%s); uso el respaldo embebido"
              % (CUENTAS_PATH, type(e).__name__), file=sys.stderr)
    return list(CLAUDE_RESPALDO)


CLAUDE = carga_cuentas()

USAGE_JS = r"""(async () => {
  try {
    const orgs = await (await fetch("/api/organizations", {credentials: "include"})).json();
    if (!Array.isArray(orgs) || !orgs.length) return {ok:false, note:"sin sesion (no hay organizations)"};
    const org = orgs[0];
    const u = await (await fetch(`/api/organizations/${org.uuid}/usage`, {credentials:"include"})).json();
    return {ok:true, email: org.name, tier: org.rate_limit_tier,
            h5: (u.five_hour||{}).utilization, h5_reset: (u.five_hour||{}).resets_at,
            d7: (u.seven_day||{}).utilization, d7_reset: (u.seven_day||{}).resets_at};
  } catch (e) { return {ok:false, note: String(e).slice(0,80)}; }
})()"""


def _horas(iso: str | None) -> str:
    if not iso:
        return "?"
    try:
        dt = datetime.datetime.fromisoformat(iso.replace("Z", "+00:00"))
        h = (dt - datetime.datetime.now(datetime.timezone.utc)).total_seconds() / 3600
        return "%.0fh" % h if h >= 0 else "vencida"
    except Exception:
        return "?"


def sonda_claude(cuenta: dict) -> dict:
    r = {"label": cuenta["label"], "provider": "claude", "ok": False}
    tab = None
    try:
        tab = cdp.abre(cuenta["port"], "https://claude.ai/new")
        time.sleep(4)
        pg = cdp.Pagina(tab["webSocketDebuggerUrl"])
        datos = pg.evalua(USAGE_JS)
        pg.cierra()
        if isinstance(datos, dict) and datos.get("ok"):
            r.update(ok=True, email=datos.get("email"), tier=datos.get("tier"),
                     libre_5h=100 - (datos.get("h5") or 0), reset_5h=_horas(datos.get("h5_reset")),
                     reset_5h_iso=datos.get("h5_reset"),
                     libre_7d=100 - (datos.get("d7") or 0), reset_7d=_horas(datos.get("d7_reset")),
                     reset_7d_iso=datos.get("d7_reset"))
        else:
            r["note"] = (datos or {}).get("note", "respuesta inesperada") if isinstance(datos, dict) else "sin datos"
    except Exception as e:
        r["note"] = "%s: %s" % (type(e).__name__, str(e)[:60])
    finally:
        if tab and tab.get("id"):
            try:
                import urllib.request
                urllib.request.urlopen("http://127.0.0.1:%s/json/close/%s" % (cuenta["port"], tab["id"]), timeout=8)
            except Exception:
                pass
    return r


def sonda_codex() -> dict:
    r = {"label": "codex", "provider": "codex", "ok": False}
    try:
        env = dict(os.environ, CODEX_HOME="/datos/agents/shared/.codex", CODEX_PROBE_TIMEOUT="45")
        out = subprocess.run(["python3", BASE.replace("cauce-ai-live", "ai-usage-live") + "/codex-probe.py"],
                             capture_output=True, text=True, timeout=90, env=env)
        d = json.loads(out.stdout.strip().splitlines()[-1]) if out.stdout.strip() else {}
        rl = (d.get("rate_limits") or [{}])[0].get("primary") or {}
        if d.get("ok") and "used_percent" in rl:
            r.update(ok=True, libre_7d=100 - rl["used_percent"],
                     reset_7d=_horas(datetime.datetime.fromtimestamp(rl["resets_at"], datetime.timezone.utc).isoformat())
                     if rl.get("resets_at") else "?")
        else:
            r["note"] = d.get("note", "sin datos")
    except Exception as e:
        r["note"] = "%s: %s" % (type(e).__name__, str(e)[:60])
    return r


def recolecta() -> dict:
    cuentas = [sonda_claude(c) for c in CLAUDE]
    cuentas.append(sonda_codex())
    return {"generado": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
            "cuentas": cuentas}


def tabla(datos: dict) -> str:
    l = ["== cuotas de la flota ==  generado %s UTC" % datos["generado"][11:19]]
    for c in datos["cuentas"]:
        if not c.get("ok"):
            l.append("  %-9s %-8s  SIN DATO — %s" % (c["label"], c["provider"], c.get("note", "?")))
            continue
        if c["provider"] == "claude":
            l.append("  %-9s claude   libre 5h:%3d%% (↻%s)  7d:%3d%% (↻%s)  [%s]"
                     % (c["label"], c["libre_5h"], c["reset_5h"], c["libre_7d"], c["reset_7d"],
                        (c.get("tier") or "").replace("default_claude_max_", "max ")))
        else:
            l.append("  %-9s codex    libre 7d:%3d%% (↻%s)" % (c["label"], c.get("libre_7d", 0), c.get("reset_7d", "?")))
    return "\n".join(l)


def escribe_contexto(datos: dict) -> None:
    """Rewrite the file injected by the hook into each agent, WITH its absolute timestamp."""
    dst = "/home/stev/.local/share/ai-usage-live/quota-context.txt"
    lineas = ["<ai-quotas generado=%s fuente=cauce-ai-live>" % datos["generado"]]
    for c in datos["cuentas"]:
        if c.get("ok") and c["provider"] == "claude":
            lineas.append("%s: libre 5h %d%% / 7d %d%%" % (c["label"], c["libre_5h"], c["libre_7d"]))
        elif c.get("ok"):
            lineas.append("%s: libre 7d %d%%" % (c["label"], c.get("libre_7d", 0)))
        else:
            lineas.append("%s: SIN DATO (%s)" % (c["label"], c.get("note", "?")))
    lineas.append("</ai-quotas>")
    io.open(dst, "w", encoding="utf-8").write("\n".join(lineas) + "\n")


def main() -> int:
    p = argparse.ArgumentParser(description="Cuota real por cuenta de la flota Cauce")
    p.add_argument("--json", action="store_true")
    p.add_argument("--context", action="store_true", help="reescribe el fichero que leen los agentes")
    a = p.parse_args()
    datos = recolecta()
    if a.context:
        escribe_contexto(datos)
    print(json.dumps(datos, ensure_ascii=False) if a.json else tabla(datos))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
