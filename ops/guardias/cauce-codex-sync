#!/bin/bash
# Propagates /datos/agents/shared/.codex/auth.json to the codex-homes of agents that do
# NOT mount the shared directory. auth.json only; config.toml is per-agent. Idempotent:
# skip the write when already identical so the path unit doesn't feed back.
set -u
SRC=/datos/agents/shared/.codex/auth.json
LOG=/home/stev/.local/state/cauce-codex-sync.log

[ -r "$SRC" ] || { echo "$(date -Is) FALTA $SRC" >> "$LOG"; exit 1; }

TARGETS="
/datos/miguel-config/.openclaw
/datos/claw-config/.openclaw
/datos/agent-v2/tenants/jhon/agents/hegel/oc/.openclaw
/datos/agent-v2/tenants/pablo/agents/marcas/oc/.openclaw
/datos/agent-v2/tenants/pablo/agents/personal/oc/.openclaw
"

src_sum=$(sha256sum "$SRC" | cut -d' ' -f1)
changed=0
for base in $TARGETS; do
  ch="$base/agents/main/agent/codex-home"
  auth="$ch/auth.json"
  [ -d "$ch" ] || continue
  if [ -f "$auth" ] && [ "$(sha256sum "$auth" | cut -d' ' -f1)" = "$src_sum" ]; then
    continue
  fi
  install -o stev -g stev -m 600 "$SRC" "$auth" && changed=$((changed+1))
  mkdir -p "$(dirname "$LOG")"
  echo "$(date -Is) actualizado $auth" >> "$LOG"
done
[ "$changed" -gt 0 ] && echo "$(date -Is) sincronizados=$changed" >> "$LOG"
exit 0
