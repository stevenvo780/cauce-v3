#!/usr/bin/env bash
# cauce-directo — abrir un alias SIN los saltos de pty de kratos.
#
# Por qué existe (medido 2026-08-11): desde kratos, `cauce <alias>` encadena CUATRO pty
# —ssh -t (87 ms de red pública) → sudo -u stev (use_pty) → docker exec -it → tmux/openclaw-tui—
# y cuando el salto externo se corta a mitad de sesión el proceso interior queda huérfano
# aferrado a la pty en vez de liberarla. Encontramos uno así vivo 25 h en el contenedor de
# jarvis (PID 77476, PPID 0, /dev/pts/0).
#
# Esto usa UN solo salto: entra al VPS y corre allí el `cauce` nativo, que es el que funciona.
# No reemplaza a `cauce`: los dos alias que viven en kratos (kant, salva) siguen siendo locales.
set -uo pipefail

VPS=${CAUCE_VPS:-vps}
LOCALES="kant salva"

if [ $# -eq 0 ]; then
  echo "uso: cauce-directo <alias> [subcomando]"
  echo "     cauce-directo            -> listado (lo hace el cauce del VPS)"
  exec ssh -t "$VPS" 'sudo -iu stev cauce'
fi

for l in $LOCALES; do
  if [ "$1" = "$l" ]; then
    echo "$1 vive en ESTA maquina (kratos), no en el VPS: uso el cauce local." >&2
    exec cauce "$@"
  fi
done

# Las comillas de "$@" se pierden al cruzar ssh, así que se reescapan una vez.
args=$(printf '%q ' "$@")
exec ssh -t "$VPS" "sudo -iu stev cauce $args"
