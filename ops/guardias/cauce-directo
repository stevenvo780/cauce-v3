#!/usr/bin/env bash
# cauce-directo — open an alias WITHOUT the pty hops that the local cauce wrapper performs.
# Why it exists: from this host, `cauce <alias>` chains FOUR ptys (ssh -t over public net ->
# sudo -u -> docker exec -it -> tmux/openclaw-tui) and when the outer hop drops mid-session
# the inner process stays orphaned clinging to the pty instead of releasing it.
# This uses ONE hop: SSH to the VPS and run the native `cauce` there, which is what works.
# Does not replace `cauce`: the two aliases that live locally stay local.
set -uo pipefail

VPS=${CAUCE_VPS:-vps}
LOCALES="kant salva"

if [ $# -eq 0 ]; then
  echo "uso: cauce-directo <alias> [subcomando]"
  echo "     cauce-directo            -> listado (lo hace el cauce del VPS)"
  exec ssh -t "$VPS" 'sudo -iu stev cauce'
fi

for l in $LOCALES; do
  if [ "$1" = "$l" ]; then
    echo "$1 vive en ESTA maquina (kratos), no en el VPS: uso el cauce local." >&2
    exec cauce "$@"
  fi
done

# The quotes around "$@" are lost crossing ssh, so re-quote once.
args=$(printf '%q ' "$@")
exec ssh -t "$VPS" "sudo -iu stev cauce $args"
