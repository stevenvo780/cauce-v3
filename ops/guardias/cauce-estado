#!/usr/bin/env python3
"""cauce-estado <alias> — is this agent working or dead?

A single screen crossing the four sources that answer that question:

  * systemd: the adapter's unit (active, since when, restart count)
  * the container: the adapter process and its CPU TIME. An active unit proves nothing; an
                   inert agent is betrayed by accumulating CPU seconds over hours.
  * the attach marker: if someone is on the console, the agent is INTENTIONALLY mute.
  * the gateway (mTLS): presence/heartbeat, delivery queue and ACK timeline. From the control
                   host there is no Postgres (no psql, 5432 closed, no ssh to the storage
                   host); the gateway is the only window into the database and it is enough.

    cauce-estado <alias>     one screen
    cauce-estado             whole fleet, one line per agent
    cauce-estado --json      same in JSON
"""
import datetime
import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import sys
import time

MARKERS = os.path.expanduser('~/.local/state/cauce-attach')
HOST_NATIVE = {'kant': 'cauce-v3-host-kant'}


def die(msg):
    print(f'cauce-estado: {msg}', file=sys.stderr)
    raise SystemExit(1)


def sh(args, timeout=60):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def sesiones_mod():
    ruta = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'cauce-sesiones')
    if not os.path.exists(ruta):
        die(f'falta {ruta} (se instala junto a cauce-estado)')
    sys.dont_write_bytecode = True
    cargador = importlib.machinery.SourceFileLoader('cauce_sesiones', ruta)
    modulo = importlib.util.module_from_spec(importlib.util.spec_from_loader('cauce_sesiones', cargador))
    cargador.exec_module(modulo)
    return modulo


def unit_of(alias):
    return HOST_NATIVE.get(alias, f'cauce-v3-container-{alias}')


# VPS aliases run their units on the VPS itself, under the VPS user; asking `systemctl --user`
# locally would correctly report `inactive` for them and mis-publish that as "DOWN".
# kant and salva ARE supervised by this host, so those two keep being measured locally.
LOCALES = {'kant', 'salva'}
VPS_SSH = "vps-tn"


def alias_de_unit(unit):
    """`cauce-v3-container-argos` / `cauce-v3-host-kant` -> `argos` / `kant`."""
    for prefijo in ('cauce-v3-container-', 'cauce-v3-host-'):
        if unit.startswith(prefijo):
            return unit[len(prefijo):].replace('.service', '')
    return unit


def propiedades(unit, claves):
    alias = alias_de_unit(unit)
    pedido = ['systemctl', '--user', 'show', unit] + ['-p' + k for k in claves]
    if alias in LOCALES:
        crudo = sh(pedido)
    else:
        remoto = ('U=$(id -u stev); sudo -u stev XDG_RUNTIME_DIR=/run/user/$U '
                  + ' '.join(pedido))
        crudo = sh(['ssh', '-n', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
                    VPS_SSH, remoto])
    salida = {}
    for linea in crudo.splitlines():
        if '=' in linea:
            clave, valor = linea.split('=', 1)
            salida[clave] = valor
    return salida


def segundos_cpu(texto):
    """'01:23' or '1-02:03:04' from ps → seconds."""
    if not texto:
        return None
    dias, _, resto = texto.partition('-')
    if not resto:
        resto, dias = dias, '0'
    partes = resto.split(':')
    try:
        numeros = [float(p) for p in partes]
    except ValueError:
        return None
    total = 0.0
    for numero in numeros:
        total = total * 60 + numero
    return total + int(float(dias or 0)) * 86400


_PS_CACHE = []


def procesos_host():
    """One snapshot of the control host's process table plus the VPS's, joined.

    Container aliases' adapters migrated to the VPS, so a single local `ps` would declare
    "NO ADAPTER" for the whole fleet. Joining both snapshots keeps local cases (kant, salva)
    working and lets one SSH read the remote ones.
    """
    if not _PS_CACHE:
        local = sh(['ps', '-eo', 'pid,etime,time,pcpu,args', '--no-headers'])
        remoto = sh(['ssh', '-n', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', VPS_SSH,
                     'ps -eo pid,etime,time,pcpu,args --no-headers'], timeout=90)
        _PS_CACHE.append((local or '') + '\n' + (remoto or ''))
    filas = []
    for linea in _PS_CACHE[0].splitlines():
        partes = linea.split(None, 4)
        if len(partes) == 5:
            filas.append(partes)
    return filas


def proceso_adaptador(alias, host_native, unidad):
    """The adapter process for THIS alias and its accumulated CPU. An active unit proves nothing:
    an inert agent is betrayed by not consuming CPU (seconds over hours).

    Two distinct cases must be respected:
      * container alias: the unit spawns a `docker exec` (MainPID, CPU always 0) that in turn
        runs `cauce-container-runtime.py run --alias X`. The one doing the work is THAT, not
        the MainPID.
      * kant (host-native): everything runs under the unit, so the cgroup's CPUUsageNSec is exact.
    """
    if host_native:
        principal = str(unidad.get('MainPID') or '')
        fila = next((f for f in procesos_host() if f[0] == principal), None)
        try:
            cpu_s = int(unidad.get('CPUUsageNSec')) / 1e9
        except (TypeError, ValueError):
            cpu_s = segundos_cpu(fila[2]) if fila else None
        if fila is None and cpu_s is None:
            return None
        return {'pid': principal, 'edad': fila[1] if fila else '?',
                'cpu': reloj(cpu_s), 'pcpu': fila[3] if fila else '?',
                'cpu_s': cpu_s, 'edad_s': segundos_cpu(fila[1]) if fila else None,
                'fuente': 'cgroup de la unit'}
    for pid, edad, cpu, pcpu, args in procesos_host():
        if args.startswith('docker ') or 'cauce-container-runtime.py' not in args:
            continue
        if f'--alias {alias} ' not in args + ' ':
            continue
        return {'pid': pid, 'edad': edad, 'cpu': cpu, 'pcpu': pcpu,
                'cpu_s': segundos_cpu(cpu), 'edad_s': segundos_cpu(edad),
                'fuente': 'cauce-container-runtime'}
    return None


def reloj(segundos):
    if segundos is None:
        return '?'
    segundos = int(segundos)
    return f'{segundos // 3600:02d}:{(segundos % 3600) // 60:02d}:{segundos % 60:02d}'


def harness_vivo(info, alias):
    """The harness process inside the container (the one running dist/src/bin/<harness>.js).
    It is the only thing owned by Cauce inside; other fleets' processes share the containers
    and must not be confused with it."""
    cmd = ("ps -eo args --no-headers 2>/dev/null | grep -F 'adapter-sdk/dist/src/bin/' "
           f"| grep -F '/{alias}/' | grep -v grep | head -1")
    if info.get('alias') in LOCALES or info['container'] in ('ws-isa',):
        return bool(sh(['docker', 'exec', info['container'], 'sh', '-lc', cmd], timeout=30))
    return bool(sh(['ssh', '-n', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', VPS_SSH,
                    f'docker exec {info["container"]} sh -lc {shlex.quote(cmd)}'],
                   timeout=60))


def marcador(alias):
    path = os.path.join(MARKERS, f'{alias}.json')
    try:
        with open(path) as handle:
            datos = json.load(handle)
    except (OSError, ValueError):
        return None
    try:
        os.kill(int(datos.get('attach_pid')), 0)
        datos['vivo'] = True
    except (OSError, TypeError, ValueError):
        datos['vivo'] = False
    return datos


def presencia(mod, alias):
    codigo, datos = mod.gateway(alias, '/v3/status')
    if codigo != 200 or not isinstance(datos, dict):
        return None, None
    mia = next((p for p in (datos.get('presence') or []) if p.get('alias') == alias), None)
    return mia, datos


def epoca(texto):
    """ISO-8601 from the gateway → local epoch. None if it can't be parsed."""
    if not isinstance(texto, str) or not texto:
        return None
    try:
        return int(datetime.datetime.fromisoformat(texto.replace('Z', '+00:00')).timestamp())
    except (ValueError, TypeError):
        return None


def actividad(mod, alias):
    """Last ACK and last completed delivery for THIS alias, from the timeline."""
    codigo, datos = mod.gateway(alias, '/v3/console/messages')
    if codigo != 200 or not isinstance(datos, dict):
        return None
    ultimo_ack = ultima_hecha = None
    ack_estado = None
    for mensaje in (datos.get('items') or []):
        for entrega in (mensaje.get('deliveries') or []):
            if entrega.get('recipient_alias') != alias:
                continue
            for evento in (entrega.get('timeline') or []):
                if evento.get('status') == 'published':
                    continue
                cuando = epoca(evento.get('at'))
                if cuando is None:
                    continue
                if ultimo_ack is None or cuando > ultimo_ack:
                    ultimo_ack, ack_estado = cuando, evento.get('status')
                if evento.get('status') == 'done' and (ultima_hecha is None or cuando > ultima_hecha):
                    ultima_hecha = cuando
    return {'ultimo_ack': ultimo_ack, 'ack_estado': ack_estado, 'ultima_hecha': ultima_hecha}


def veredicto(datos, mod):
    """The conclusion, in one line. Order matters: first what explains the silence."""
    if datos['marcador'] and datos['marcador'].get('vivo'):
        espera = humano(int(time.time()) - int(datos['marcador'].get('started_at', 0)))
        return ('MUDO A PROPÓSITO',
                f'hay un attach abierto (pid {datos["marcador"].get("attach_pid")}, hace {espera}): '
                'el adaptador está parado y las entregas se encolan.')
    if datos['marcador'] and not datos['marcador'].get('vivo'):
        return ('MARCADOR HUÉRFANO', 'el attach murió sin restaurar. cauce-attach-guard lo levanta '
                f'en ≤2 min; si no, systemctl --user start {datos["unit"]}')
    if datos['unidad'].get('ActiveState') != 'active':
        return ('CAÍDO', f'la unit {datos["unit"]} está {datos["unidad"].get("ActiveState")} '
                'y nadie la paró desde la consola.')
    if datos['proceso'] is None:
        return ('SIN ADAPTADOR', 'la unit está activa pero no hay proceso de adaptador para este '
                'alias: arrancó y se murió sin que systemd lo note.')
    if datos.get('harness_vivo') is False:
        return ('SIN HARNESS', 'el adaptador corre en el host pero adentro del contenedor no hay '
                'proceso del harness: no puede ejecutar nada.')
    presente = datos['presencia']
    if presente is not None and not presente.get('online'):
        return ('SIN LATIDO', 'el adaptador corre pero el gateway no lo ve online '
                f'(último latido {presente.get("last_heartbeat_at") or "?"}).')
    cpu, edad = datos['proceso'].get('cpu_s'), datos['proceso'].get('edad_s')
    if cpu is not None and edad and edad > 3600 and (cpu / edad) < 0.0005:
        return ('INERTE', f'lleva {datos["proceso"]["edad"]} vivo y sólo {int(cpu)}s de CPU: '
                'está prendido pero no procesa nada.')
    atascado = mod.veredicto_cola(datos['cola'])
    if atascado is not None:
        return atascado
    vivas = len(datos['cola']['vivas']) if datos['cola'] else 0
    if vivas:
        return ('TRABAJANDO', f'{vivas} entrega(s) en vuelo o en cola.')
    return ('VIVO Y OCIOSO', 'sin entregas pendientes.')


def humano(segundos):
    segundos = max(0, int(segundos))
    if segundos < 90:
        return f'{segundos}s'
    if segundos < 5400:
        return f'{segundos // 60}m'
    if segundos < 172800:
        return f'{segundos // 3600}h'
    return f'{segundos // 86400}d'


def desde(stamp):
    if not stamp:
        return 'nunca'
    return f"{time.strftime('%m-%d %H:%M', time.localtime(stamp))} (hace {humano(time.time() - stamp)})"


def reunir(mod, alias, con_sesiones=True, ligero=False, bus=None):
    info = mod.alias_info(alias)
    host_native = alias in HOST_NATIVE
    unit = unit_of(alias)
    if bus is None:
        presente, estado_bus = presencia(mod, alias)
    else:
        estado_bus = bus
        presente = next((p for p in (bus.get('presence') or []) if p.get('alias') == alias), None)
    datos = {
        'alias': alias, 'unit': unit, 'info': info,
        'unidad': propiedades(unit, ['ActiveState', 'SubState', 'ActiveEnterTimestamp',
                                     'NRestarts', 'MainPID', 'CPUUsageNSec']),
        'marcador': marcador(alias),
        'presencia': presente,
        'bus': estado_bus,
        'cola': mod.cola(alias),
        'actividad': None if ligero else actividad(mod, alias),
    }
    datos['proceso'] = proceso_adaptador(alias, host_native, datos['unidad'])
    datos['harness_vivo'] = None if ligero or host_native else harness_vivo(info, alias)
    if con_sesiones:
        inventario = mod.inventario(alias)
        datos['sesiones'] = {
            'total': len(inventario['sesiones']),
            'dm': (inventario['dm'] or {}).get('abrev'),
            'dm_ultimo': (inventario['dm'] or {}).get('mtime'),
            'reciente': (inventario['reciente'] or {}).get('abrev'),
            'partidas': sum(len(v) for v in inventario['duplicadas'].values()),
        }
    datos['veredicto'] = veredicto(datos, mod)
    return datos


def pantalla(datos):
    alias = datos['alias']
    titulo, explicacion = datos['veredicto']
    print(f'{alias} · {datos["info"].get("harness")} · {datos["info"].get("container")}')
    print('=' * 78)
    print(f'  {titulo:<18} {explicacion}')
    print('')
    unidad = datos['unidad']
    print(f'  adaptador   unit {datos["unit"]}: {unidad.get("ActiveState", "?")}/{unidad.get("SubState", "?")}'
          f' desde {unidad.get("ActiveEnterTimestamp") or "?"} · {unidad.get("NRestarts", "?")} reinicios')
    proceso = datos['proceso']
    if proceso:
        sin_harness = '' if datos.get('harness_vivo') is not False else ' · SIN harness adentro'
        print(f'              proceso pid {proceso["pid"]} · vivo hace {proceso["edad"]}'
              f' · CPU acumulada {proceso["cpu"]} ({proceso["pcpu"]}%){sin_harness}')
    else:
        print('              proceso: NO hay adaptador corriendo para este alias')
    presente = datos['presencia']
    if presente:
        print(f'  bus         {"online" if presente.get("online") else "OFFLINE"}'
              f' · epoch {presente.get("epoch")}'
              f' · último latido {desde(epoca(presente.get("last_heartbeat_at")))}')
    else:
        print('  bus         el gateway no contestó o no publica presencia de este alias')
    marca = datos['marcador']
    if marca:
        estado_attach = 'ABIERTO' if marca.get('vivo') else 'MARCADOR HUÉRFANO (el pid murió)'
        print(f'  attach      {estado_attach} · sesión {str(marca.get("session"))[:8]}'
              f' · pid {marca.get("attach_pid")}'
              f' · abierto hace {humano(int(time.time()) - int(marca.get("started_at", 0)))}')
    else:
        print('  attach      nadie adentro por consola')
    print('  cola        ' + datos_cola(datos))
    act = datos['actividad']
    if act:
        detalle_ack = f' ({act["ack_estado"]})' if act['ack_estado'] else ''
        print(f'  último ACK  {desde(act["ultimo_ack"])}{detalle_ack}')
        print(f'  última OK   {desde(act["ultima_hecha"])}')
    else:
        print('  último ACK  el gateway no contestó')
    ses = datos.get('sesiones')
    if ses:
        print(f'  sesiones    {ses["total"]} en total · DM del dueño: {ses["dm"] or "—"}'
              f' (último turno {desde(ses["dm_ultimo"])}) · más reciente: {ses["reciente"] or "—"}')
        if ses['partidas']:
            print(f'              {ses["partidas"]} de ellas son la misma conversación partida'
                  f' (ia {alias} --lista)')


def datos_cola(datos):
    cola = datos['cola']
    if cola is None:
        return 'el gateway no contestó (no hay Postgres alcanzable desde kratos)'
    partes = []
    nombres = {'pending': 'en cola', 'started': 'en vuelo', 'retrying': 'reintentando',
               'leased': 'reclamadas', 'accepted': 'aceptadas', 'dead': 'muertas'}
    for clave in ('pending', 'started', 'retrying', 'leased', 'accepted', 'dead'):
        if cola['por_estado'].get(clave):
            partes.append(f'{cola["por_estado"][clave]} {nombres[clave]}')
    if not partes:
        return 'nada pendiente'
    linea = ', '.join(partes)
    esperas = [epoca(i.get('available_at')) for i in cola['vivas']]
    esperas = [e for e in esperas if e]
    if esperas:
        linea += f' · la más vieja espera hace {humano(time.time() - min(esperas))}'
    return linea


def resumen_flota(mod):
    try:
        aliases = sorted(json.load(open(mod.MAP))['aliases'])
    except (OSError, ValueError, KeyError):
        die(f'no puedo leer {mod.MAP}')
    bus = None
    for alias in aliases:
        _codigo, respuesta = mod.gateway(alias, '/v3/status')
        if isinstance(respuesta, dict) and respuesta.get('presence'):
            bus = respuesta
            break
    print(f'{"ALIAS":<10} {"ESTADO":<18} {"CPU":<9} {"COLA":<7} DETALLE')
    for alias in aliases:
        try:
            datos = reunir(mod, alias, con_sesiones=False, ligero=True, bus=bus)
        except SystemExit:
            continue
        titulo, explicacion = datos['veredicto']
        proceso = datos['proceso'] or {}
        vivas = len(datos['cola']['vivas']) if datos['cola'] else '?'
        print(f'{alias:<10} {titulo:<18} {proceso.get("cpu", "—"):<9} {vivas:<7} {explicacion[:70]}')


def main():
    args = sys.argv[1:]
    como_json = '--json' in args
    args = [a for a in args if not a.startswith('--')]
    mod = sesiones_mod()
    if not args:
        resumen_flota(mod)
        return 0
    datos = reunir(mod, args[0])
    if como_json:
        print(json.dumps(datos, ensure_ascii=False, default=str))
    else:
        pantalla(datos)
    return 0


if __name__ == '__main__':
    sys.exit(main())
