#!/usr/bin/env bash
# Clears modals that leave an agent alive but mute.
# Why a sweeper and not "just update": the update only resets the clock; the next release
# brings the same dialog. This is the cure; the update is only a truce.
# Always pick "3. Skip until next version": updating another alias's toolchain is a separate
# decision (the vendored codex binary gates which models each may use), and "2. Skip" asks again
# right away.
# Only send keys when the modal is REALLY on screen. Never blindly.
set -u
# Three guards, all three must pass:
#   1. the REAL modal also brings its numbered options;
#   2. the `›` cursor marks a pending menu (not historical text);
#   3. the marker must be in the LAST lines: a live modal sits at the bottom, not in the middle.
MARCA='Update available'
OPCION='Skip until next version'
COLA_LINEAS=12

es_modal_vivo() {   # $1 = contenido del panel
  local p=$1 cola
  case "$p" in *"$MARCA"*) ;; *) return 1 ;; esac
  case "$p" in *"$OPCION"*) ;; *) return 1 ;; esac
  cola=$(printf '%s\n' "$p" | tail -n "$COLA_LINEAS")
  case "$cola" in *"$MARCA"*) ;; *) return 1 ;; esac
  case "$cola" in *"›"*) ;; *) return 1 ;; esac
  return 0
}
LOG=${LOG:-$HOME/.local/state/cauce-modal-sweeper.log}
mkdir -p "$(dirname "$LOG")"
di() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" | tee -a "$LOG"; }

barrer_host() {   # $1 = etiqueta, $2 = prefijo de ejecución ("" local, "ssh vps sudo" remoto)
  local host=$1; shift
  local ejec=("$@")
  local nombres
  nombres=$("${ejec[@]}" docker ps --format '{{.Names}}' 2>/dev/null) || return 0
  for c in $nombres; do
    local sesiones
    sesiones=$("${ejec[@]}" docker exec -u dev "$c" tmux -L cauce ls 2>/dev/null | cut -d: -f1) || continue
    [ -z "$sesiones" ] && continue
    for s in $sesiones; do
      local pantalla
      pantalla=$("${ejec[@]}" docker exec -u dev "$c" tmux -L cauce capture-pane -p -t "$s" 2>/dev/null)
      es_modal_vivo "$pantalla" || continue
      local linea
      linea=$(printf '%s\n' "$pantalla" | grep -m1 "$MARCA" | tr -s ' ')
      di "MODAL en $host/$c/$s ->$linea"
      "${ejec[@]}" docker exec -u dev "$c" tmux -L cauce send-keys -t "$s" "3" 2>/dev/null
      sleep 1
      "${ejec[@]}" docker exec -u dev "$c" tmux -L cauce send-keys -t "$s" Enter 2>/dev/null
      sleep 3
      # VERIFY BY EFFECT: the modal must be gone. Sending the key is not having cleared it.
      pantalla=$("${ejec[@]}" docker exec -u dev "$c" tmux -L cauce capture-pane -p -t "$s" 2>/dev/null)
      if es_modal_vivo "$pantalla"; then
        di "  NO SE DESTRABO $host/$c/$s: el modal sigue en pantalla (revisar a mano)"
      else
        di "  destrabado $host/$c/$s"
      fi
    done
  done
}

barrer_host kratos
barrer_host vps ssh -o BatchMode=yes -o ConnectTimeout=10 vps sudo
exit 0
