def matar_por_pid(host, pid, args_esperados):
    """Mata UN proceso por PID, reconfirmando su identidad justo antes. Nunca por nombre."""
    rc, out, _ = sh(host, "tr '\\0' ' ' < /proc/%d/cmdline 2>/dev/null" % pid, timeout=30)
    if rc != 0 or not out.strip():
        return False, "el proceso ya no existe"
    if not RE_PUENTE.search(out) and not RE_PUENTE_NATIVO.search(out):
        # Cambio de identidad: el PID se reutilizo. No se toca.
        return False, "el PID cambio de identidad, no se toca"
    sh(host, "kill -TERM %d" % pid, timeout=30)
    sh(host, "sleep 10", timeout=40)
    rc, _, _ = sh(host, "test -d /proc/%d" % pid, timeout=30)
    if rc == 0:
        sh(host, "kill -KILL %d" % pid, timeout=30)
        sh(host, "sleep 5", timeout=30)
        rc, _, _ = sh(host, "test -d /proc/%d" % pid, timeout=30)
    return (rc != 0), ("el proceso desaparecio" if rc != 0 else "SIGUE VIVO tras SIGKILL")


