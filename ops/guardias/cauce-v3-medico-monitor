# --- UN APAGADO ORDENADO NO ES UNA CAIDA --------------------------------------------------
# BUG MEDIDO 2026-08-13 (zeus): el guardia grito "no se ve adaptador vivo ni unidad activa en
# ningun host" con gravedad 95 dos veces esta noche, con atlas y con socrates, y las dos veces
# era FALSO: los habian reiniciado a proposito y el guardia paso por el hueco. La lista de
# unidades se toma UNA vez al principio de la corrida y este aviso se emite minutos despues,
# sin volver a mirar; un reinicio entero cabe holgado en ese hueco.
#
# El discriminante es el que pedia el caso: un apagado ORDENADO se ve distinto de una caida.
# Medido con `systemctl show` sobre las dos unidades que dispararon el falso positivo:
#   atlas     InactiveEnter 04:03:17 -> ActiveEnter 04:03:44   (27 s)  Result=success
#   socrates  InactiveEnter 03:42:35 -> ActiveEnter 03:43:09   (34 s)  Result=success
# Una caida deja `Result` en exit-code / signal / timeout / oom-kill / core-dump, y no trae un
# arranque limpio detras. Un reinicio deliberado deja `Result=success` y una parada RECIENTE.
#
# Se remide la unidad AHORA (no es un sleep: es dejar de concluir sobre una muestra vieja, lo
# mismo que ya hace la rama `adaptador_caido` desde el 2026-08-11) y se pregunta por el EFECTO:
#   - si ya esta `active`     -> se recupero solo / nunca estuvo caido: no es hallazgo.
#   - si esta `activating`    -> esta arrancando ahora mismo: no es hallazgo.
#   - si esta parada limpia   -> apagado ordenado hace menos de VENTANA_REINICIO_S: es un
#     y RECIENTE                reinicio en curso, no un alias mudo. Queda como apunte.
#   - cualquier otra cosa     -> se avisa igual, como siempre.
# Los timestamps se leen en forma MONOTONA (microsegundos desde el arranque) y se restan
# contra `/proc/uptime` del mismo host: asi no depende del locale del `date` ni del reloj.
VENTANA_REINICIO_S = 600      # 10 min: ~18x la parada mas larga medida (34 s), con margen de
# sobra para un `restart` lento, y suficientemente corto para que un alias realmente caido no
# se esconda mas de una corrida del guardia (que corre cada 15 min).


def estado_fresco_unidad(host, unidad):
    """Remide UNA unidad AHORA. Devuelve dict o None si no se pudo medir.

    None significa "no lo pude medir", que NO es lo mismo que "esta bien": el que llama tiene
    que seguir avisando en ese caso. Una sonda rota no acredita nada (misma regla que ya rige
    para `unidades()` y `procesos()` en esta corrida).
    """
    base = ("XDG_RUNTIME_DIR=/run/user/1000 systemctl --user" if host == "kratos"
            else "sudo -u stev XDG_RUNTIME_DIR=/run/user/1000 systemctl --user")
    rc, out, _ = sh(host, "cat /proc/uptime; %s show %s -p ActiveState,SubState,Result,"
                          "ActiveEnterTimestampMonotonic,InactiveEnterTimestampMonotonic"
                    % (base, unidad), timeout=40)
    if rc != 0 or not out.strip():
        return None
    lineas = out.strip().split("\n")
    try:
        uptime_s = float(lineas[0].split()[0])
    except (IndexError, ValueError):
        return None
    d = {}
    for linea in lineas[1:]:
        if "=" in linea:
            k, _, v = linea.partition("=")
            d[k.strip()] = v.strip()
    if "ActiveState" not in d:
        return None

    def _antiguedad(campo):
        try:
            us = int(d.get(campo, "0"))
        except ValueError:
            return None
        if us <= 0:
            return None
        return uptime_s - (us / 1000000.0)

    return {"unidad": unidad, "host": host,
            "active": d.get("ActiveState", ""), "sub": d.get("SubState", ""),
            "result": d.get("Result", ""),
            "hace_activa_s": _antiguedad("ActiveEnterTimestampMonotonic"),
            "hace_parada_s": _antiguedad("InactiveEnterTimestampMonotonic")}


def _lee_reinicio(fresco, ventana_s=VENTANA_REINICIO_S):
    """(es_reinicio, motivo) a partir de UNA medicion ya tomada. PURA: no toca red, para poder
    probarla. `False, ""` = avisar como siempre."""
    unidad, host = fresco["unidad"], fresco["host"]
    if fresco["active"] == "active" and fresco["sub"] != "failed":
        # Cubre DOS casos, los dos reales: (a) el alias se reinicio en el hueco entre la muestra
        # y el aviso, y ya volvio; (b) la unidad ELEGIDA arriba era la sobra `inactive` que dejo
        # una mudanza en el otro host, mientras la de verdad esta arriba. En los dos, con la
        # unidad activa AHORA no se puede concluir que el alias este sin adaptador.
        return True, ("la unidad %s en %s esta ACTIVA al remedirla (arriba hace %s s): la "
                      "muestra del principio de la corrida no alcanza para declararlo mudo"
                      % (unidad, host,
                         int(fresco["hace_activa_s"]) if fresco["hace_activa_s"] else "?"))
    if fresco["active"] in ("activating", "reloading", "deactivating"):
        return True, ("la unidad %s en %s esta en '%s': esta arrancando o parando ahora mismo, "
                      "no esta caida" % (unidad, host, fresco["active"]))
    parada = fresco["hace_parada_s"]
    if fresco["result"] == "success" and parada is not None and parada < ventana_s:
        return True, ("la unidad %s en %s se paro ORDENADAMENTE (Result=success) hace %d s, "
                      "dentro de la ventana de reinicio de %d s: es un apagado deliberado en "
                      "curso, no una caida" % (unidad, host, int(parada), ventana_s))
    return False, ""


def en_ventana_de_reinicio(host, unidad, ventana_s=VENTANA_REINICIO_S):
    """(es_reinicio, motivo) para UNA unidad, remedida AHORA. Envoltorio de `_lee_reinicio`.
    Un `None` (no se pudo medir) NO es "esta bien": se devuelve `False` y se avisa como
    siempre, que de una sonda rota no se concluye nada."""
    fresco = estado_fresco_unidad(host, unidad)
    if fresco is None:
        return False, ""
    return _lee_reinicio(fresco, ventana_s)


def mapa_adaptadores(procs):
    """alias -> adaptador vivo (host, pid, bundle, digest, contenedor). Se descubre del
    proceso VIVO, no del inventario: el inventario y el Description de las units mienten
    despues de una mudanza (ya paso), el argv del proceso no."""
    res = {}
    for p in procs:
        m = RE_ADAPTADOR.search(p["args"])
        if not m:
            continue
        alias = m.group("alias")
        b = RE_BUNDLE.search(p["args"])
        d = RE_DIGEST.search(p["args"])
        c = RE_CTR.search(p["args"])
        res[alias] = {"host": p["host"], "pid": p["pid"], "etimes": p["etimes"],
                      "bundle": os.path.basename(b.group("bundle")) if b else "",
                      "digest": d.group("digest") if d else "",
                      "contenedor": c.group("ctr") if c else ""}
    return res


def clientes_tmux(alias, adaptador):
    """Cuantos clientes de tmux hay atados al panel del alias. Reiniciar o matar algo de un
    alias con la TUI de su dueno abierta le tumba la sesion: no se hace solo."""
    sesion = "cauce-%s" % alias
    if not adaptador:
        return None
    if adaptador.get("contenedor"):
        cmd = "docker exec %s tmux -L cauce list-clients -t %s 2>/dev/null" % (
            adaptador["contenedor"], sesion)
    else:
        cmd = "tmux -L cauce list-clients -t %s 2>/dev/null" % sesion
    rc, out, _ = sh(adaptador["host"], cmd, timeout=30)
    if rc != 0:
        return 0
    return len([l for l in out.strip().split("\n") if l.strip()])


