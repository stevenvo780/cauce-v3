# "una funcion PURA de los hallazgos" queda rota: pasa a ser funcion de los hallazgos MAS
# cualquier cosa que un CLI ajeno haya escrito por su cuenta, en cualquier parte de la cadena.
#
# No importa si ESTE `last_error` en particular es estable entre corridas (lo es: viene de una
# columna de la base, no de un subproceso que el guardia relanza) - la garantia tiene que valer
# para CUALQUIER texto libre que un agente, un CLI o un subproceso puedan escribir, hoy o
# manana. Por eso el arreglo va en el UNICO punto de salida de `detalle` (bitacora y cuerpo del
# aviso), no en cada sitio que arma un `detalle`: ninguna fuente, presente o futura, puede
# volver a partir el reporte.
_RE_ESPACIOS_DE_CONTROL = re.compile(r"\s+")


def una_linea(texto, limite=4000):
    """Aplana cualquier texto a UNA sola linea logica.

    Colapsa saltos de linea, tabs y corridas de espacios a un unico espacio, y recorta si hace
    falta. Es el unico lugar por el que pasa un `detalle` antes de entrar a la bitacora o al
    cuerpo que se hashea para la `idempotency_key`: la salida de un subproceso -o de cualquier
    texto libre ajeno que haya llegado hasta aca, por SQL o por lo que sea- nunca puede meter un
    salto de linea que el render lea como un hallazgo propio, sin prefijo y sin alias.
    """
    if texto is None:
        return ""
    plano = _RE_ESPACIOS_DE_CONTROL.sub(" ", str(texto)).strip()
    if limite and len(plano) > limite:
        plano = plano[:limite].rstrip() + "…[truncado]"
    return plano


def memoria_hallazgos(visto_antes, visto_ahora, t0):
    """Conserva lo que NO se vio en ESTA corrida en vez de olvidarlo.

    `visto_ahora` se arma de cero con los hallazgos de la corrida en curso. Si se guardara tal
    cual, un hallazgo que desaparece un rato y vuelve entra como `nuevo`: `veces` vuelve a 1 y
    se despacha otra vez, saltandose REAVISO_HORAS. Eso es lo que se ve como "la misma alerta
    dos veces", y esta MEDIDO en la BD de PROD el 2026-08-06: la clave trabajo_perdido|hegel
    fue 1 -> 8 -> 1 y zeus recibio el mismo hallazgo en corridas distintas del mismo dia.
    Por eso la memoria se ARRASTRA; solo se olvida cuando lleva OLVIDO_HORAS sin verse (si no,
    el fichero de estado crece para siempre).
    """
    fusion = dict(visto_ahora)
    for clave, v in (visto_antes if isinstance(visto_antes, dict) else {}).items():
        if clave in fusion:
            continue
        ref = v.get("ultimo_visto") or v.get("ultimo_despacho") or v.get("primera_vez")
        try:
            viejo = (t0 - datetime.datetime.fromisoformat(ref)).total_seconds() \
                >= OLVIDO_HORAS * 3600
        except Exception:  # noqa: BLE001
            viejo = True   # sin fecha utilizable no se puede sostener la memoria: se suelta
        if not viejo:
            fusion[clave] = v
    return fusion


