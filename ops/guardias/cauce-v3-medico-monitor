def sh(host, comando, entrada=None, timeout=90):
    """Ejecuta en kratos (local), en el VPS o en agora-storage. Devuelve (rc, out, err)."""
    if host == "kratos":
        cmd = ["bash", "-lc", comando]
    else:
        destino = VPS if host == "vps" else AGORA
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", destino, comando]
    try:
        # stdin explicito: sin esto, un `ssh` hijo se come el stdin del propio guardia (y con
        # el, el resto del script cuando se lo invoca por heredoc). Ya mordio una vez.
        if entrada is None:
            r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, timeout=timeout)
        else:
            r = subprocess.run(cmd, input=entrada, capture_output=True, text=True,
                               timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout tras %ds" % timeout
    except Exception as e:  # noqa: BLE001
        return 1, "", "%s: %s" % (type(e).__name__, e)


def sql(consulta, columnas=None):
    """Consulta a la base de Cauce. La query viaja por stdin: sin comillas que escapar.

    Devuelve una lista de filas; cada fila es una lista de strings con EXACTAMENTE las columnas
    que pidio la consulta, pase lo que pase dentro de ellas.

    POR QUE NO SE PARTE POR UN CARACTER. Este parser reventó TRES veces por el mismo motivo:
    texto libre de `last_error` metido en un formato delimitado por un caracter.
      1) saltos de linea dentro de `last_error`  -> "expected 3, got 1"
      2) un `~` dentro de `last_error` (iza, 1463 caracteres) -> "expected 3, got 4"
      3) y el siguiente caracter raro habria sido el tercero: el separador es del formato, pero
         el contenido lo elige un mensaje de error que escribe cualquiera.
    Cada reventon se lleva por delante todo lo que venga DESPUES dentro del mismo `try`: la
    ultima vez desaparecieron del informe 1342 dead-letters y seis alias con trabajo perdido, y
    el guardia PARECIA sano porque el fallo salia como una linea gris entre veinte.

    Aplanar caracteres en la consulta (`replace(chr(10),' ')`) es perseguir bordes: siempre
    queda uno. Aqui se cambia el FORMATO, no el contenido: `COPY ... TO STDOUT WITH (FORMAT
    csv, FORCE_QUOTE *)` hace que Postgres emita CSV con TODOS los valores entre comillas y las
    comillas internas dobladas, y se parsea con el modulo `csv`, que entiende ese mismo
    formato. Con eso, una virgulilla, un salto de linea, una coma, un tabulador o una comilla
    dentro de `last_error` son datos, no estructura: NO pueden cambiar el numero de columnas.

    `columnas` es un contrato opcional: si la base devuelve otro ancho, se falla con un mensaje
    que dice que pasó, en vez de con un "too many values to unpack" a 700 lineas de distancia.
    """
    cuerpo = consulta.strip().rstrip(";").strip()
    if not cuerpo:
        raise RuntimeError("consulta vacia")
    orden = "COPY (%s) TO STDOUT WITH (FORMAT csv, FORCE_QUOTE *);" % cuerpo
    rc, out, err = sh("agora", PG, entrada=orden)
    if rc != 0:
        raise RuntimeError("psql rc=%d: %s" % (rc, err.strip()[:200]))
    # newline="" es lo que pide el modulo `csv`: el que trocea las filas es el lector de CSV,
    # que sabe que un salto de linea ENTRE COMILLAS es parte del dato y no el fin de la fila.
    filas = [f for f in csv.reader(io.StringIO(out, newline="")) if f]
    if columnas is not None:
        malas = [f for f in filas if len(f) != columnas]
        if malas:
            raise RuntimeError(
                "la consulta declaro %d columna(s) y la base devolvio %d fila(s) con otro "
                "ancho (la primera trae %d): revisa la CONSULTA, no el texto de los datos"
                % (columnas, len(malas), len(malas[0])))
    return filas


