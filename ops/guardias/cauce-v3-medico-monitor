def sonda_credenciales(adaptadores):
    """Huella de la credencial de cada contenedor con adaptador vivo. Detecta las dos firmas
    de 'credencial rota que miente': sin refreshToken, o la misma huella compartida.

    EL DISCRIMINANTE ES (huella, CONTENEDOR), NO (huella, alias). MEDIDO 2026-08-13 (zeus):
    el aviso "credencial COMPARTIDA (huella 0911427b90) entre: atlas, kratos; al rotar se
    pisan" es un FALSO POSITIVO PERMANENTE. atlas y kratos son dos ALIAS del MISMO contenedor
    (ws-humanizar): comparten `/home/dev/.claude/.credentials.json` porque comparten el HOME,
    no porque cada uno tenga su copia -es un solo inodo (13544331). Al renovarse, se renueva
    en sitio y los dos ven el token nuevo: no hay nada que pisarse. Barrida la huella en los
    15 contenedores del VPS: 0911427b90 aparece en EXACTAMENTE UNO; ninguna huella se repite
    entre contenedores distintos.
    El peligro REAL que esta regla existe para atrapar es OTRO: dos CONTENEDORES DISTINTOS con
    COPIAS del mismo refresh_token si se matan entre si (el primero que refresca revoca al
    otro, "Your authentication token has been invalidated" -paso de verdad con codex de argos
    y zeus). Por eso `huellas` guarda (alias, contenedor) y `compartidas` solo dispara cuando
    una MISMA huella aparece en MAS DE UN contenedor: dos alias del mismo contenedor jamas
    activan la alarma, por diseno, no por casualidad."""
    vistos, huellas, problemas = {}, {}, []
    for alias, ad in sorted(adaptadores.items()):
        ctr = ad.get("contenedor")
        if not ctr:
            continue
        if ctr in vistos:
            huellas.setdefault(vistos[ctr], []).append((alias, ctr))
            continue
        for ruta in ("/home/dev/.claude/.credentials.json", "/home/claw/.claude/.credentials.json"):
            cmd = "docker exec -i %s python3 -c \"$(cat)\" %s" % (ctr, ruta)
            rc, out, _ = sh(ad["host"], cmd, entrada=SONDA_CRED, timeout=40)
            if rc != 0 or not out.strip():
                continue
            try:
                d = json.loads(out.strip().split("\n")[-1])
            except Exception:  # noqa: BLE001
                continue
            if d.get("falta"):
                continue
            h = d.get("huella")
            if h is None:
                # setup-token: NO tiene refreshToken A PROPOSITO y dura ~364 dias. No es un
                # fallo: es el patron correcto. Solo es problema si el access ya vencio o esta
                # por vencer, porque entonces si enmudece y no hay con que renovar.
                # EPOCH0 2026-08-11 (zeus): un "exp" ausente o 0 NO es un token vencido: es que
                # no se pudo leer la caducidad. Tomarlo como epoch 1970 produce "vence en -496233 h"
                # (56 anios) y un aviso de credencial rota sobre un alias sano. Paso con zeus el
                # 2026-08-11 12:29Z: su fichero tenia refreshToken y el access vigente 8 h, medido
                # con esta misma sonda. Una medicion fallida no es un resultado negativo.
                exp_ms = int(d.get("exp") or 0)
                if exp_ms <= 0:
                    continue
                horas = (exp_ms/1000.0 - time.time())/3600.0
                if horas > 168:
                    continue  # token largo vigente: sano, y sin refresh no hay carrera que perder
                problemas.append({"alias": alias, "contenedor": ctr,
                                  "detalle": "sin refreshToken y el access vence en %.0f h: "
                                             "no puede renovar, enmudece" % horas})
            else:
                vistos[ctr] = h
                huellas.setdefault(h, []).append((alias, ctr))
            break
    compartidas = {}
    for h, quienes in huellas.items():
        contenedores = {c for _, c in quienes}
        if len(contenedores) > 1:
            compartidas[h] = sorted({a for a, _ in quienes})
    return problemas, compartidas


