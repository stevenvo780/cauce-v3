def entregas_trabadas():
    """Las entregas en vuelo, con lo que hace falta para saber si ALGUIEN LAS ESTA TRABAJANDO.

    La edad sola no distingue un turno largo de un turno muerto (por eso el guardia reportaba
    los turnos reales del medico como "trabados" cada hora). Se traen ademas dos medidas del
    MOVIMIENTO de la fila:
      quieto_min: minutos desde el ultimo avance real de la entrega
      lease_min : minutos que le quedan a la reserva (negativo = vencida)
    `greatest` en Postgres ignora los NULL, y `created_at` nunca lo es: la cuenta siempre sale.
    """
    filas = sql(
        "select recipient_tenant, recipient_alias, status, attempt, "
        "round(extract(epoch from (now()-created_at))/60), id, "
        "round(extract(epoch from (now()-greatest(created_at, claimed_at, "
        "  execution_started_at, updated_at)))/60), "
        "coalesce(round(extract(epoch from (claim_expires_at-now()))/60)::text,'') "
        "from deliveries where status in ('claimed','accepted','started') "
        "order by created_at;", columnas=8)
    salida = []
    for f in filas:
        if len(f) < 8:
            continue
        t, a, s, i, m, d, q, lease = f[:8]
        try:
            lease_min = int(float(lease)) if str(lease).strip() else None
        except ValueError:
            lease_min = None
        try:
            quieto = int(float(q))
        except ValueError:
            quieto = None
        salida.append({"tenant": t, "alias": a, "status": s, "intento": int(i),
                       "edad_min": int(float(m)), "id": d,
                       "quieto_min": quieto, "lease_min": lease_min})
    return salida


