def sonda_telegram():
    """Se ejecuta EN agora-storage para que los tokens no salgan de ese host."""
    # UN timeout de red no puede dejar ciego al informe entero. La sonda es de SOLO LECTURA
    # (corre en agora para que los tokens no salgan de ese host), asi que reintentar es seguro.
    # Solo se reintenta el fallo de CONEXION (255 = ssh, 124 = timeout); cualquier otro rc se
    # reporta tal cual, porque entonces el problema no es la red y insistir lo esconde.
    rc, out, err = sh("agora", "python3 -", entrada=SONDA_TELEGRAM, timeout=180)
    if rc in (124, 255):
        rc2, out2, err2 = sh("agora", "python3 -", entrada=SONDA_TELEGRAM, timeout=180)
        if rc2 == 0:
            rc, out, err = rc2, out2, err2
        else:
            return {}, ("sonda telegram rc=%d y el reintento tambien fallo (rc=%d): %s"
                        % (rc, rc2, (err2 or err).strip()[:130]))
    if rc != 0:
        return {}, "sonda telegram rc=%d: %s" % (rc, err.strip()[:150])
    try:
        return json.loads(out.strip().split("\n")[-1]), None
    except Exception as e:  # noqa: BLE001
        return {}, "sonda telegram ilegible: %s" % e


