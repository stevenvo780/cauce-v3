def robo_cpu_agora():
    """% de CPU que el hipervisor le roba a agora, o None si no se pudo medir.

    Una sonda que revienta con rc=124 puede ser una sonda ROTA... o una maquina a la que no le
    dan procesador. Son averias OPUESTAS: la primera se arregla tocando el guardia; la segunda
    NO se arregla desde dentro, y mandar a alguien a "arreglar la sonda" lo manda a reparar un
    instrumento que esta sano. Distinguirlas cuesta un segundo.

    Medido el 2026-08-23: el robo estuvo clavado en 90,0% con una variacion de una decima
    durante mas de una hora. Esa planitud es la firma de un TOPE del proveedor; un vecino
    ruidoso daria una sierra.
    """
    prog = (
        "import time\n"
        "def leer():\n"
        "    v=[int(x) for x in open('/proc/stat').readline().split()[1:]]\n"
        "    return sum(v), v[7]\n"
        "a=leer()\n"
        "time.sleep(1)\n"
        "b=leer()\n"
        "dt=b[0]-a[0]\n"
        "ds=b[1]-a[1]\n"
        "print(round(100.0*ds/dt,1) if dt>0 else -1)\n"
    )
    try:
        rc, out, _err = sh("agora", "python3 -", entrada=prog, timeout=25)
    except Exception:  # noqa: BLE001
        return None
    if rc != 0 or not out.strip():
        return None
    try:
        v = float(out.strip().splitlines()[-1])
    except Exception:  # noqa: BLE001
        return None
    return v if v >= 0 else None


