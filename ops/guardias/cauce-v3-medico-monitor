def ciclo_rescate(alias, adaptador, apuntes):
    """Reinicia un adaptador SIN perder el trabajo en vuelo.

    Sin el paso de re-inyeccion, reiniciar es DESTRUIR: la entrega en vuelo muere con
    `SHUTDOWN` en attempt=1 y no se reintenta nunca. Por eso el orden es obligatorio:
      1 capturar lo que se va a perder (y dejarlo en la bitacora ANTES de tocar nada)
      2 reiniciar
      3 verificar que volvio (active, no failed)
      4 leer la salida entera: `arranco SIN sesion compartida` es FALLO, no exito
      5 re-inyectar por la API con idempotency_key derivada del delivery original
      6 verificar POR EFECTO que la entrega llego a done
    """
    if not adaptador:
        return {"resultado": "omitido", "razon": "no se ve el adaptador vivo"}
    if alias in ALIAS_PIERDEN_CONTEXTO:
        # No es una precaucion teorica: su panel arranca con `exec claude` pelado y el agente
        # vuelve sin saber en que estaba. Se REPORTA para que lo mire una persona.
        return {"resultado": "omitido",
                "razon": "%s todavia PIERDE TODO SU CONTEXTO al reiniciarse (panel con `exec` "
                         "pelado, sin reanudar sesion): reiniciarlo es amnesia, no reparacion. "
                         "Se reporta; lo arregla el SDK, no el guardia." % alias}
    # Reiniciar con trabajo en vuelo lo mata con `attempt=1` y NO se reintenta solo. Mientras
    # la re-inyeccion no este implementada, esto es destruir trabajo, no rescatarlo.
    en_vuelo = captura_en_vuelo(alias)
    if en_vuelo:
        return {"resultado": "omitido", "perdido": en_vuelo,
                "razon": "%d entrega(s) EN VUELO: reiniciar ahora las mata con attempt=1 y "
                         "nadie las reintenta (la re-inyeccion automatica no existe todavia)"
                         % len(en_vuelo)}
    if adaptador.get("bundle") != RELEASE_CON_FIX78 or adaptador.get("digest") != DIGEST_CON_FIX78:
        return {"resultado": "omitido",
                "razon": "release sin el fix de exit 78 (%s): reiniciarlo puede dejarlo "
                         "en failed sin arrancar" % (adaptador.get("bundle") or "?")}
    n = clientes_tmux(alias, adaptador)
    if n:
        return {"resultado": "omitido",
                "razon": "%d cliente(s) de tmux atados: reiniciar le tumba la TUI a su dueno" % n}

    perdido = captura_en_vuelo(alias)          # paso 1
    apuntes.append({"tipo": "captura_previa", "alias": alias, "entregas": perdido})

    unidad = "cauce-v3-container-%s.service" % alias
    base = ("XDG_RUNTIME_DIR=/run/user/1000 systemctl --user" if adaptador["host"] == "kratos"
            else "sudo -u stev XDG_RUNTIME_DIR=/run/user/1000 systemctl --user")
    rc, out, err = sh(adaptador["host"], "%s restart %s 2>&1" % (base, unidad), timeout=180)
    salida_arranque = (out + err)[-2000:]      # paso 4: se guarda ENTERA, no se filtra
    sh(adaptador["host"], "sleep 15", timeout=40)
    _, estado, _ = sh(adaptador["host"], "%s is-active %s" % (base, unidad), timeout=40)
    estado = estado.strip()
    if estado != "active":                     # paso 3
        return {"resultado": "fallo", "estado": estado, "perdido": perdido,
                "salida": salida_arranque,
                "razon": "quedo en '%s': NO se re-inyecta nada contra un alias muerto" % estado}

    sin_panel = "SIN sesion compartida" in salida_arranque
    return {"resultado": "reiniciado", "estado": estado, "perdido": perdido,
            "sin_sesion_compartida": sin_panel, "salida": salida_arranque,
            "reinyeccion": "NO IMPLEMENTADA EN AUTOMATICO: ver informe"}


