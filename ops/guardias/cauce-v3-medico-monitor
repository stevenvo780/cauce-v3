#   362 no calzan -> se auditaron los 362 uno por stem y son TODOS prosa de alguien:
#       221 "cancelado por zeus 2026-07-28: aviso de fracaso duplicado..." (operador)
#        ~30 "Argos - <alias>, transporte cancelado. Acta NN..." (argos rechazando)
#        ~25 "EXERCISE_ID=PROMETEO-... STATUS=FAIL" (banco de pruebas)
#         2 "Cancelled by operator Steven:kant (ops/zeus maintenance...)"
#         y los de seneca/atlas de esta noche.
#   Cero diagnosticos del transporte se colaron del lado equivocado.
RE_ERROR_DE_TRANSPORTE = re.compile(
    r"^\s*(?:ACK timeout"
    r"|Harness "
    r"|A harness "
    r"|A failed harness "
    r"|Previous harness "
    r"|OpenClaw result "
    r"|Hermes result "
    r"|Structured output is missing"
    r"|Claude Code result "
    r"|Codex result "
    r"|Delivery expired"
    r"|Adapter "
    r"|Transport )")


def error_de_transporte(err):
    """True si este `last_error` lo escribio el TRANSPORTE (y por lo tanto se puede citar como
    prueba de que la respuesta no llego). False = lo escribio el destinatario o un operador, y
    entonces la entrega SI se vio: no se perdio en el camino, se rechazo.

    Ante la duda NO se calla nada: el que no calza no desaparece, se reporta por el otro canal
    (`respuesta_rechazada`) con la autoria puesta donde corresponde. Si el bus estrena un
    diagnostico nuevo que este patron no conoce, el peor caso es que aparezca en la lista
    equivocada -visible igual-, nunca que se pierda.
    """
    return bool(RE_ERROR_DE_TRANSPORTE.match(err or ""))


def respuestas_perdidas(horas=24):
    """(perdidas, rechazadas): dos cosas distintas que antes se contaban como una.

    `perdidas`   = la respuesta murio en el camino de vuelta. Deja CIEGAS a las dos puntas.
    `rechazadas` = la respuesta LLEGO y el destinatario la rechazo, dejando por escrito su
                   motivo en `last_error`. Nadie quedo ciego: hay un alias que la leyo.

    Medido en prod (24 h): 18/18 delegaciones muertas avisaron al que las pidio; 0/4 respuestas
    muertas avisaron a nadie. El aviso busca al padre en `agent_output_materializations`, que
    tiene fila para 220/220 delegaciones y 0/210 respuestas: sin fila, el store se calla.

    `recipient_alias` es el DESTINATARIO; `actor_alias`, quien la contesto. Solo en el grupo
    `perdidas` el destinatario es ademas "el que esperaba a ciegas": en `rechazadas` es el
    AUTOR del texto de `last_error`, y decir que esperaba algo es exactamente el bug de arriba.
    """
    filas = sql(
        "select d.recipient_tenant, d.recipient_alias, coalesce(m.actor_alias,'?'), "
        "left(d.id::text,8), "
        "to_char(d.terminal_at at time zone 'UTC','MM-DD HH24:MI'), "
        "left(coalesce(d.last_error,''),110), "
        "(select count(*) from deliveries d2 "
        " join messages m2 on m2.id = d2.message_id "
        " where d2.recipient_alias = d.recipient_alias and d2.status = 'done' "
        # 2026-08-18 zeus: era `> d.terminal_at`, y el fan-in se emite en el MISMO segundo en
        # que la respuesta se da por muerta -es su consecuencia-, asi que el `>` estricto lo
        # dejaba fuera por un empate. Se ancla en `created_at`: el texto existe desde que la
        # respuesta se creo, no desde que el bus se rindio.
        "   and d2.created_at >= d.created_at "
        "   and length(coalesce(m.body->>'text','')) > 40 "
        "   and position("
        # 2026-08-18 zeus: se buscaba en `m2.body->>'text'`, pero el fan-in lleva ahi un
        # texto generico ("Synthesize one non-empty final reply...") y el contenido real en
        # `body->fanin_data_v1->responses[]->untrusted_text`. Buscando en el cuerpo ENTERO se
        # cubren los dos casos. Sin esto, la via que mas veces reentrega una respuesta era
        # justo la que el chequeo no miraba, y el aviso salia con gravedad 82.
        "         left(regexp_replace(coalesce(m.body->>'text',''),'\\s+',' ','g'),60) "
        "         in regexp_replace(coalesce(m2.body::text,''),'\\s+',' ','g')) > 0)::text "
        "from deliveries d join messages m on m.id = d.message_id "
        "where d.status in ('dead','failed') "
        "  and d.terminal_at > now() - interval '%d hours' "
        "  and coalesce(m.body->>'type','') = 'agent.response' "
        "order by d.terminal_at desc;" % int(horas), columnas=7)
    perdidas, rechazadas = {}, {}
    for f in filas:
        if len(f) < 7:
            continue
        tenant, destinatario, contesto, did, cuando, err, rescate = f[:7]
        err = (err or "").strip()
        item = {"tenant": tenant, "contesto": contesto, "id": did,
                "cuando": cuando, "error": err,
                "rescatada": (rescate or "0").strip() not in ("", "0")}
        destino = perdidas if error_de_transporte(err) else rechazadas
        destino.setdefault(destinatario, []).append(item)
    return perdidas, rechazadas


def captura_en_vuelo(alias):
    """Lo que se va a PERDER si se reinicia este alias. Se guarda ANTES de tocar nada: si el
    rescate falla, este registro es lo unico que permite recuperarlo a mano."""
    filas = sql(
        "select d.id, d.message_id, m.actor_alias, m.tenant_id, m.room_id, m.lane, "
        "m.priority, m.request_id, replace(coalesce(m.body->>'text',''), chr(10), ' ') "
        "from deliveries d join messages m on m.id = d.message_id "
        "where d.recipient_alias = '%s' "
        "and d.status in ('claimed','accepted','started');" % alias.replace("'", "''"),
        columnas=9)
    return [{"delivery": f[0], "message": f[1], "actor": f[2], "tenant": f[3],
             "room": f[4], "lane": f[5], "priority": f[6], "request_id": f[7],
             "texto": f[8][:400]} for f in filas if len(f) >= 9]


