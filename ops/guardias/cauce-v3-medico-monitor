def sonda_credenciales(adaptadores):
    """Credential fingerprint per container with a live adapter. Detects the two signatures
    of 'lying broken credential': no refreshToken, or the same fingerprint shared.

    THE DISCRIMINANT IS (fingerprint, CONTAINER), not (fingerprint, alias). Two aliases that
    share a container also share the same file by bind-mount (a single inode); refreshing
    refreshes in place and both see the new token — nothing to step on. The real danger
    this rule exists to catch is two DISTINCT containers holding copies of the same
    refresh_token: when one refreshes, it invalidates the other. `compartidas` therefore
    fires only when the SAME fingerprint appears in MORE THAN ONE container."""
    vistos, credential_locations, problemas = {}, [], []
    for alias, ad in sorted(adaptadores.items()):
        ctr = ad.get("contenedor")
        if not ctr:
            continue
        if ctr in vistos:
            credential_locations.append((vistos[ctr], alias, ctr))
            continue
        for ruta in ("/home/dev/.claude/.credentials.json", "/home/claw/.claude/.credentials.json"):
            cmd = f"docker exec -i {ctr} python3 -c \"$(cat)\" {ruta}"
            rc, out, _ = sh(ad["host"], cmd, entrada=SONDA_CRED, timeout=40)
            if rc != 0 or not out.strip():
                continue
            try:
                d = json.loads(out.strip().split("\n")[-1])
            except Exception:  # noqa: BLE001
                continue
            if d.get("falta"):
                continue
            health = classify_doctor_record(d, now_epoch=time.time())
            h = health.fingerprint
            if h is None:
                # setup-token: no refreshToken BY DESIGN (~364d), fine unless access is
                # already expired. Absent/0 "exp" is an unreadable expiry, NOT epoch 1970 --
                # treating it as such would false-alert a healthy alias.
                if health.problem:
                    horas = health.hours_until_expiry
                    problemas.append({"alias": alias, "contenedor": ctr,
                                      "detalle": f"sin refreshToken y el access vence en {horas:.0f} h: "
                                                 "no puede renovar, enmudece"})
            else:
                vistos[ctr] = h
                credential_locations.append((h, alias, ctr))
            break
    compartidas = {
        fingerprint: sorted(subjects)
        for fingerprint, subjects in shared_fingerprints(credential_locations).items()
    }
    return problemas, compartidas


