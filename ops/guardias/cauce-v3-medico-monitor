def cuanto_falta(segundos):
    """Cuenta atras legible. PURA.

    2026-08-20 zeus: se imprimia con `%.0f h`, asi que 17 minutos salian como "faltan 0 h".
    El propio texto del apunte dice "si llega la fecha y sigue fallando, entonces SI es una
    alarma": mostrar 0 h cuando todavia faltan minutos invita exactamente al falso positivo
    que ese apunte existe para evitar.
    """
    minutos = int(segundos // 60)
    if minutos < 60:
        return "faltan %d min" % max(minutos, 0)
    if minutos < 60 * 24:
        return "faltan %dh%02dm" % (minutos // 60, minutos % 60)
    return "faltan %.0f h" % (minutos / 60.0)


def _reset_solo_hora(texto, ahora=None):
