#!/usr/bin/env bash
# secreto — pasa un secreto de su custodio al contenedor de otro agente SIN que viaje por el bus,
# porque un valor en `messages` queda en `messages.body` para siempre: no hay borrado retroactivo.
#
#   secreto depositar <nombre>            lee el valor de stdin y lo guarda 0600 en el deposito
#   secreto conceder  <nombre> <alias>    lo materializa 0600 dentro del contenedor del alias
#   secreto listar                        nombres y huellas, nunca valores
#   secreto revocar   <nombre> <alias>    lo borra del contenedor del alias

set -uo pipefail

DEPOSITO="${CAUCE_SECRETOS:-/home/stev/.config/cauce-v3/secretos}"
BITACORA="${CAUCE_SECRETOS_LOG:-/home/stev/.local/state/cauce-secretos.log}"
DESTINO_EN_CONTENEDOR="${CAUCE_SECRETOS_DESTINO:-.config/cauce-v3/secretos}"

huella() { sha256sum "$1" | cut -c1-10; }
morir()  { echo "secreto: $1" >&2; exit 1; }

# Lista blanca: acaban en rutas, en `sh -c` y en SQL. Un `..` o un `;` bastarian sin esto.
valido_nombre() {
  case "$1" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) morir "nombre invalido «$1»: solo A-Z a-z 0-9 . _ - y sin empezar por punto" ;;
  esac
}
valido_alias() {
  case "$1" in
    ''|*[!a-z0-9_-]*) morir "alias invalido «$1»: solo a-z 0-9 _ -" ;;
  esac
}

# El alias no basta: `agents.container_name` puede mentir. Se mide contra docker.
contenedor_de() {
  local alias="$1" c
  valido_alias "$alias"
  # Por STDIN, no por -c: psql solo interpola variables en entrada de fichero (alias ligado).
  c="$(printf "SELECT container_name FROM agents WHERE alias = :'alias';\n" \
       | docker exec -i cauce-v3-prod-postgres-1 psql -U cauce -d cauce -At \
           -v alias="$alias" -f - 2>/dev/null | head -1)"
  [ -n "$c" ] || morir "no encuentro contenedor para «$alias»: puede que no tenga fila en agents"
  # Nativo: `docker inspect` daria un generico «no existe» que despista sobre la causa.
  case "$c" in
    host:*) morir "«$alias» corre nativo en ${c#host:}, no en contenedor: este canal no lo alcanza" ;;
  esac
  docker inspect "$c" >/dev/null 2>&1 || morir "«$c» del alias «$alias» no existe aqui: ¿otro demonio?"
  printf '%s' "$c"
}

# Dos alias en un mismo contenedor comparten HOME: conceder a uno concede a ambos, en silencio.
convive_con() {
  local alias="$1" ctr="$2"
  printf "SELECT alias FROM agents WHERE container_name = :'ctr' AND alias <> :'alias';\n" \
    | docker exec -i cauce-v3-prod-postgres-1 psql -U cauce -d cauce -At \
        -v ctr="$ctr" -v alias="$alias" -f - 2>/dev/null | tr '\n' ' '
}

anotar() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$BITACORA" 2>/dev/null || true
}

case "${1:-}" in
  depositar)
    nombre="${2:-}"; [ -n "$nombre" ] || morir "uso: secreto depositar <nombre> < valor"
    valido_nombre "$nombre"
    [ -t 0 ] && morir "el valor se pasa por stdin, no como argumento (no queda en el historial)"
    install -d -m 700 "$DEPOSITO" || morir "no puedo crear el deposito $DEPOSITO"
    umask 077
    cat > "$DEPOSITO/$nombre" || morir "no pude escribir el secreto"
    chmod 600 "$DEPOSITO/$nombre"
    [ -s "$DEPOSITO/$nombre" ] || { rm -f "$DEPOSITO/$nombre"; morir "el valor llego vacio"; }
    h="$(huella "$DEPOSITO/$nombre")"
    anotar "depositar nombre=$nombre huella=$h"
    echo "depositado «$nombre», huella $h"
    ;;
  conceder)
    nombre="${2:-}"; alias="${3:-}"
    [ -n "$nombre" ] && [ -n "$alias" ] || morir "uso: secreto conceder <nombre> <alias>"
    valido_nombre "$nombre"; valido_alias "$alias"
    [ -r "$DEPOSITO/$nombre" ] || morir "no hay ningun secreto «$nombre» depositado"
    c="$(contenedor_de "$alias")" || exit 1
    vecinos="$(convive_con "$alias" "$c")"
    [ -z "$vecinos" ] || echo "AVISO: «$c» tambien es de ${vecinos% }; comparten HOME y esto se lo concede a todos" >&2
    # El usuario del contenedor no siempre es `dev`: se mide, no se supone.
    usuario="$(docker inspect --format '{{.Config.User}}' "$c" 2>/dev/null)"
    usuario="${usuario:-1000}"
    casa="$(docker exec "$c" sh -lc 'printf %s "$HOME"' 2>/dev/null)"
    [ -n "$casa" ] || morir "no pude leer HOME dentro de «$c»"
    ruta="$casa/$DESTINO_EN_CONTENEDOR/$nombre"
    # Valores por ENTORNO y guion en comillas simples: el shell de fuera no los expande nunca.
    # `docker exec -u 0` entra con HOME=/root: la casa medida viaja explicita o el secreto
    # aterriza donde su dueno no lo ve.
    docker exec -u 0 -i -e N="$nombre" -e D="$DESTINO_EN_CONTENEDOR" -e U="$usuario" \
      -e CASA="$casa" "$c" \
      sh -c 'set -e; install -d -m 700 -o "$U" "$CASA/$D"; umask 077; cat > "$CASA/$D/$N";
             chown "$U" "$CASA/$D/$N"; chmod 600 "$CASA/$D/$N"' < "$DEPOSITO/$nombre" \
      || morir "no pude materializar el secreto dentro de «$c»"
    h="$(huella "$DEPOSITO/$nombre")"
    # Comprobar el EFECTO: que el fichero exista dentro y tenga la MISMA huella.
    hd="$(docker exec -e R="$ruta" "$c" sh -c 'sha256sum "$R" 2>/dev/null | cut -c1-10')"
    [ "$hd" = "$h" ] || morir "el fichero dentro de «$c» no coincide (dentro=$hd, deposito=$h)"
    anotar "conceder nombre=$nombre alias=$alias contenedor=$c huella=$h"
    echo "concedido «$nombre» a $alias ($c): $ruta, huella $h"
    ;;
  listar)
    [ -d "$DEPOSITO" ] || { echo "no hay deposito todavia"; exit 0; }
    for f in "$DEPOSITO"/*; do
      [ -f "$f" ] || continue
      printf '%-34s huella %s\n' "$(basename "$f")" "$(huella "$f")"
    done
    ;;
  revocar)
    nombre="${2:-}"; alias="${3:-}"
    [ -n "$nombre" ] && [ -n "$alias" ] || morir "uso: secreto revocar <nombre> <alias>"
    valido_nombre "$nombre"; valido_alias "$alias"
    c="$(contenedor_de "$alias")" || exit 1
    casa="$(docker exec "$c" sh -lc 'printf %s "$HOME"' 2>/dev/null)"
    docker exec -u 0 -e N="$nombre" -e D="$DESTINO_EN_CONTENEDOR" -e CASA="$casa" "$c" \
      sh -c 'rm -f "$CASA/$D/$N"' || morir "no pude borrarlo dentro de «$c»"
    anotar "revocar nombre=$nombre alias=$alias contenedor=$c"
    echo "revocado «$nombre» en $alias ($c)"
    ;;
  *)
    sed -n '3,15p' "$0" >&2; exit 2 ;;
esac
