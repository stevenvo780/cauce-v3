#!/usr/bin/env bash
# secreto — pasa un secreto de su custodio al contenedor de otro agente SIN que viaje por el bus.
#
# Por que existe: un valor puesto en `messages` queda en `messages.body` de Postgres para siempre
# —respaldos, volcados, contexto de cualquier agente de esa conversacion— y no hay borrado
# retroactivo. La regla de no pasarlo por ahi es correcta, pero sin alternativa PARA el trabajo:
# el 2026-08-30 freno dos ramas en una hora (gaia y hegel).
#
#   secreto depositar <nombre>            lee el valor de stdin y lo guarda 0600 en el deposito
#   secreto conceder  <nombre> <alias>    lo materializa 0600 dentro del contenedor del alias
#   secreto listar                        nombres y huellas, nunca valores
#   secreto revocar   <nombre> <alias>    lo borra del contenedor del alias
#
# El valor NUNCA se imprime. Lo que viaja por el bus, si hace falta, es el NOMBRE.
set -uo pipefail

DEPOSITO="${CAUCE_SECRETOS:-/home/stev/.config/cauce-v3/secretos}"
BITACORA="${CAUCE_SECRETOS_LOG:-/home/stev/.local/state/cauce-secretos.log}"
DESTINO_EN_CONTENEDOR="${CAUCE_SECRETOS_DESTINO:-.config/cauce-v3/secretos}"

huella() { sha256sum "$1" | cut -c1-10; }
morir()  { echo "secreto: $1" >&2; exit 1; }

# El alias no basta: `agents.container_name` puede mentir. Se mide contra docker.
contenedor_de() {
  local alias="$1" c
  c="$(docker exec cauce-v3-prod-postgres-1 psql -U cauce -d cauce -At \
        -c "SELECT container_name FROM agents WHERE alias='$alias'" 2>/dev/null | head -1)"
  [ -n "$c" ] || morir "no encuentro contenedor para el alias «$alias»"
  docker inspect "$c" >/dev/null 2>&1 || morir "el contenedor «$c» del alias «$alias» no existe"
  printf '%s' "$c"
}

anotar() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$BITACORA" 2>/dev/null || true
}

case "${1:-}" in
  depositar)
    nombre="${2:-}"; [ -n "$nombre" ] || morir "uso: secreto depositar <nombre> < valor"
    [ -t 0 ] && morir "el valor se pasa por stdin, no como argumento (no queda en el historial)"
    install -d -m 700 "$DEPOSITO" || morir "no puedo crear el deposito $DEPOSITO"
    umask 077
    cat > "$DEPOSITO/$nombre" || morir "no pude escribir el secreto"
    chmod 600 "$DEPOSITO/$nombre"
    [ -s "$DEPOSITO/$nombre" ] || { rm -f "$DEPOSITO/$nombre"; morir "el valor llego vacio"; }
    h="$(huella "$DEPOSITO/$nombre")"
    anotar "depositar nombre=$nombre huella=$h"
    echo "depositado «$nombre», huella $h"
    ;;
  conceder)
    nombre="${2:-}"; alias="${3:-}"
    [ -n "$nombre" ] && [ -n "$alias" ] || morir "uso: secreto conceder <nombre> <alias>"
    [ -r "$DEPOSITO/$nombre" ] || morir "no hay ningun secreto «$nombre» depositado"
    c="$(contenedor_de "$alias")" || exit 1
    # El usuario del contenedor no siempre es `dev`: se mide, no se supone.
    usuario="$(docker inspect --format '{{.Config.User}}' "$c" 2>/dev/null)"
    usuario="${usuario:-1000}"
    casa="$(docker exec "$c" sh -lc 'printf %s "$HOME"' 2>/dev/null)"
    [ -n "$casa" ] || morir "no pude leer HOME dentro de «$c»"
    ruta="$casa/$DESTINO_EN_CONTENEDOR/$nombre"
    # El directorio tambien va al usuario del contenedor: creado por root y en 700, el agente no
    # puede ni atravesarlo, y el secreto queda ahi dentro invisible para quien tiene que usarlo.
    docker exec -u 0 "$c" sh -lc \
      "install -d -m 700 -o $usuario '$casa/$DESTINO_EN_CONTENEDOR'" \
      || morir "no pude crear el directorio dentro de «$c»"
    docker exec -u 0 -i "$c" sh -lc "umask 077; cat > '$ruta'" < "$DEPOSITO/$nombre" \
      || morir "no pude escribir dentro de «$c»"
    docker exec -u 0 "$c" sh -lc "chown $usuario '$ruta' && chmod 600 '$ruta'" \
      || morir "no pude ajustar dueno/permisos dentro de «$c»"
    h="$(huella "$DEPOSITO/$nombre")"
    # Comprobar el EFECTO: que el fichero exista dentro y tenga la MISMA huella.
    hd="$(docker exec "$c" sh -lc "sha256sum '$ruta' 2>/dev/null | cut -c1-10")"
    [ "$hd" = "$h" ] || morir "el fichero dentro de «$c» no coincide (dentro=$hd, deposito=$h)"
    anotar "conceder nombre=$nombre alias=$alias contenedor=$c huella=$h"
    echo "concedido «$nombre» a $alias ($c): $ruta, huella $h"
    ;;
  listar)
    [ -d "$DEPOSITO" ] || { echo "no hay deposito todavia"; exit 0; }
    for f in "$DEPOSITO"/*; do
      [ -f "$f" ] || continue
      printf '%-34s huella %s\n' "$(basename "$f")" "$(huella "$f")"
    done
    ;;
  revocar)
    nombre="${2:-}"; alias="${3:-}"
    [ -n "$nombre" ] && [ -n "$alias" ] || morir "uso: secreto revocar <nombre> <alias>"
    c="$(contenedor_de "$alias")" || exit 1
    casa="$(docker exec "$c" sh -lc 'printf %s "$HOME"' 2>/dev/null)"
    docker exec -u 0 "$c" sh -lc "rm -f '$casa/$DESTINO_EN_CONTENEDOR/$nombre'" \
      || morir "no pude borrarlo dentro de «$c»"
    anotar "revocar nombre=$nombre alias=$alias contenedor=$c"
    echo "revocado «$nombre» en $alias ($c)"
    ;;
  *)
    sed -n '3,15p' "$0" >&2; exit 2 ;;
esac
