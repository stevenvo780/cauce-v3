[Unit]
Description=Cauce V3 - mide las credenciales de los alias que viven en kratos (salva) y las empuja al VPS
Documentation=file:/home/stev/.local/bin/cred-guard.py
OnFailure=cauce-v3-backup-alert@%n.service

[Service]
