[Unit]
Description=Cauce V3 - repone la sesion compartida (panel) que se murio sola
Documentation=file:///datos/workspaces/zeus/cauce-v3/ops/guardias/README.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cauce-panel-guard
# Sin control-group propio: parar esta unit no puede llevarse por delante el panel del dueno,
# igual que en cauce-v3-tmux@.service.
KillMode=process
StandardInput=null
