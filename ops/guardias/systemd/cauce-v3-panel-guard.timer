[Unit]
Description=Chequeo cada 2 min del panel compartido de cada alias

[Timer]
# A los 3 min del arranque, no a los 2: cauce-attach-guard ya corre a los 2 y el adaptador tiene
# que estar en pie ANTES de que este guardia decida si al alias le falta el panel.
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s
Unit=cauce-v3-panel-guard.service

[Install]
WantedBy=timers.target
