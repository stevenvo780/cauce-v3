[Unit]
Description=Guardia de caducidad de credenciales OAuth de los WS de kratos
Documentation=file:%h/.local/bin/cred-guard.py
After=network.target

[Service]
Type=oneshot
Environment=CAUCE_CRED_GUARD_ESTADO=%h/.local/state
ExecStart=/usr/bin/python3 %h/.local/bin/cred-guard.py

[Install]
WantedBy=default.target
