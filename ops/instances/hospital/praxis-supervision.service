[Unit]
Description=Supervisión finita del GOAL de Praxis
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/praxis-supervision --once
TimeoutStartSec=60
UMask=0077
StateDirectory=praxis-supervision
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/praxis-supervision
