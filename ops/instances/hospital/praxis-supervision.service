[Unit]
Description=Supervisión finita del GOAL de Praxis
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/cauce-v3-hospital/guardias.env
ExecStart=/usr/local/sbin/praxis-supervision --once
TimeoutStartSec=60
UMask=0077
StateDirectory=praxis-supervision
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/praxis-supervision /opt/hospital-agent/runtime/praxis-preview/web
