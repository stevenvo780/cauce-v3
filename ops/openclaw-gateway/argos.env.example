# Config del gateway de OpenClaw de un alias, que lee openclaw-gateway-supervisor.sh.
# Se instala en ~/.config/cauce-v3/openclaw-gateway/<alias>.env en el host que supervisa.
#
# Deliberadamente NO sale del inventario (ops/container-aliases.json): ahi argos todavia figura
# como `hermes`, y quien corte el proximo release de ops desde git lo revertiria en silencio.
CONTAINER=ctrl-infra
RUNTIME_USER=dev
RUNTIME_HOME=/home/dev
PORT=18789
# loopback y no `auto`: dentro de un contenedor `auto` resuelve 0.0.0.0 y el gateway queda
# alcanzable desde TODA la red docker. Ademas `bind: loopback` en openclaw.json es la mitad de la
# llave que destraba el emparejamiento de la TUI (la otra es controlUi.allowInsecureAuth).
BIND=loopback
OPENCLAW_ENTRY=/usr/lib/node_modules/openclaw/dist/index.js
