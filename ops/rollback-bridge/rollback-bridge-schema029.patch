index 0000000000000000000000000000000000000000..df662dd4e5ccd4915c887876f418235dc0f6eef6
--- /dev/null
+++ b/tests/unit/rollback-bridge.test.ts
@@ -0,0 +1,140 @@
+import { randomUUID } from 'node:crypto';
+import { describe, expect, it, vi } from 'vitest';
+import {
+  AuthenticatedPublishSchema, SYSTEM_GATE_PROBE_MESSAGE_TYPE, SYSTEM_PRINCIPAL_ALIASES,
+  type ConfigMutation, type PublishMessage,
+} from '@cauce/protocol';
+import {
+  CauceRepository, ConfigurationRepository, ROLLBACK_BRIDGE_PROFILE_FROZEN,
+  type DatabasePool,
+} from '@cauce/store';
+
+function publish(overrides: Partial<PublishMessage> = {}): PublishMessage {
+  return {
+    version: '3.0',
+    request_id: randomUUID(),
+    trace_id: `rollback-${randomUUID()}`,
+    tenant_id: 'Steven',
+    room_id: 'grp.steven',
+    actor_alias: 'kant',
+    recipients: [{ tenant_id: 'Steven', alias: 'argos' }],
+    body: { text: 'diagnostico' },
+    idempotency_key: randomUUID(),
+    lane: 'interactive',
+    priority: 0,
+    ...overrides,
+  };
+}
+
+function configurationPool(): { pool: DatabasePool; sql: string[] } {
+  const sql: string[] = [];
+  const client = {
+    on: () => undefined,
+    off: () => undefined,
+    release: () => undefined,
+    async query(statement: string) {
+      const normalized = statement.replace(/\s+/g, ' ').trim();
+      sql.push(normalized);
+      if (normalized.includes('SELECT tenant.is_hub FROM memberships')) {
+        return { rows: [{ is_hub: true }], rowCount: 1 };
+      }
+      if (normalized.includes('COALESCE(max(id),0)::text AS revision')) {
+        return { rows: [{ revision: '12' }], rowCount: 1 };
+      }
+      if (normalized.includes('FROM agents WHERE tenant_id=$1 AND alias=$2 FOR UPDATE')) {
+        return {
+          rows: [{
+            harness_id: 'codex', display_name: 'Kant', enabled: true,
+            container_name: 'ctrl-infra', runtime_user: 'stev',
+            home_directory: '/home/stev', state_directory: '/home/stev/.local/state/cauce',
+            role_brief: 'r'.repeat(1_200), max_concurrent_deliveries: 2,
+          }],
+          rowCount: 1,
+        };
+      }
+      if (normalized.includes('INSERT INTO config_revisions')) {
+        return { rows: [{ id: '13' }], rowCount: 1 };
+      }
+      return { rows: [], rowCount: 0 };
+    },
+  };
+  return {
+    pool: {
+      connect: async () => client,
+      query: async (statement: string) => client.query(statement),
+    } as unknown as DatabasePool,
+    sql,
+  };
+}
+
+describe('rollback bridge compatibility shims', () => {
+  it('reserves both system principals and rejects system.gate.probe at the public schema', () => {
+    expect(SYSTEM_PRINCIPAL_ALIASES).toEqual(['gate-probe', 'quota-collector']);
+    expect(AuthenticatedPublishSchema.safeParse({
+      room_id: 'grp.steven',
+      recipients: [{ tenant_id: 'Steven', alias: 'kant' }],
+      body: {
+        type: SYSTEM_GATE_PROBE_MESSAGE_TYPE,
+        nonce: '0123456789abcdef0123456789abcdef',
+        timeout_ms: 5_000,
+      },
+      idempotency_key: 'gate-probe-must-not-enter-the-bridge',
+      lane: 'interactive',
+      priority: -100,
+    }).success).toBe(false);
+  });
+
+  it('rejects probe, system actor and system recipient before opening a transaction', async () => {
+    const query = vi.fn(async () => ({ rows: [], rowCount: 0 }));
+    const repository = new CauceRepository({ query } as unknown as DatabasePool);
+    for (const command of [
+      publish({ body: { type: SYSTEM_GATE_PROBE_MESSAGE_TYPE } }),
+      publish({ actor_alias: 'quota-collector' }),
+      publish({ recipients: [{ tenant_id: 'Steven', alias: 'gate-probe' }] }),
+      publish({ recipients: [{ tenant_id: 'Steven', alias: 'quota-collector' }] }),
+    ]) {
+      const code = await repository.publish(command).then(
+        () => 'unexpected-success',
+        (error: unknown) => error instanceof Error && 'code' in error ? String(error.code) : 'unknown',
+      );
+      expect(code).toMatch(/^(forbidden|no_route)$/);
+    }
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('freezes profile and role writes before issuing their SQL', async () => {
+    for (const mutation of [
+      {
+        resource: 'agent_profile', action: 'update', tenant_id: 'Steven', alias: 'kant',
+        value: { purpose: 'must remain frozen' },
+      },
+      {
+        resource: 'agent', action: 'update', tenant_id: 'Steven', alias: 'kant',
+        value: { role_brief: 'must remain frozen' },
+      },
+    ] satisfies ConfigMutation[]) {
+      const { pool, sql } = configurationPool();
+      await expect(new ConfigurationRepository(pool).apply(
+        'Steven', 'kant', mutation, false, 12,
+      )).rejects.toMatchObject({ code: 'conflict', message: ROLLBACK_BRIDGE_PROFILE_FROZEN });
+      expect(sql.some((statement) => /(?:INSERT INTO|UPDATE|DELETE FROM) agent_profiles/u.test(statement)))
+        .toBe(false);
+      expect(sql.some((statement) => /UPDATE agents/u.test(statement))).toBe(false);
+    }
+  });
+
+  it('updates unrelated agent fields without mentioning role_brief, including the inverse', async () => {
+    const { pool, sql } = configurationPool();
+    const result = await new ConfigurationRepository(pool).apply('Steven', 'kant', {
+      resource: 'agent', action: 'update', tenant_id: 'Steven', alias: 'kant',
+      value: { display_name: 'Kant bridge' },
+    }, false, 12);
+
+    const update = sql.find((statement) => statement.startsWith('UPDATE agents SET'));
+    expect(update).toBeDefined();
+    expect(update).not.toContain('role_brief');
+    expect(result.inverse_mutation.resource).toBe('agent');
+    if (result.inverse_mutation.resource !== 'agent') throw new Error('inverse resource changed');
+    expect(result.inverse_mutation.value).not.toHaveProperty('role_brief');
+  });
+});
