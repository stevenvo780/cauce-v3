+import { createHash } from 'node:crypto';
+import type { DatabasePool } from '@cauce/store';
+import Fastify from 'fastify';
+import { describe, expect, it } from 'vitest';
+import { buildGateway, type GatewayRepository } from './app.js';
+import {
+  OidcBffAuthProvider,
+  type OidcSession,
+  type OidcSessionStore,
+  type PendingOidcLogin,
+} from './oidc-bff.js';
+import {
+  rollbackBridgeAllowsRequest,
+  rollbackBridgeReadOnlyHook,
+} from './rollback-bridge-read-only.js';
+
+function mutableHarness(journal: string[], bridge: boolean) {
+  const app = Fastify();
+  if (bridge) app.addHook('onRequest', rollbackBridgeReadOnlyHook);
+  app.get('/v3/console/messages', async () => ({ entries: [...journal] }));
+  app.post('/v3/messages', async (request) => {
+    journal.push(JSON.stringify(request.body));
+    return { durable: true };
+  });
+  app.post('/v3/console/config/changes', async () => {
+    journal.push('config');
+    return { durable: true };
+  });
+  app.delete('/v3/console/terminal/sessions/session-a', async () => {
+    journal.push('terminal-delete');
+    return { durable: true };
+  });
+  app.get('/health/live', async () => ({ status: 'live' }));
+  app.get('/health/ready', async () => ({ status: 'ready' }));
+  app.get('/metrics', async () => 'metric 1\n');
+  return app;
+}
+
+class RecordingOidcStore implements OidcSessionStore {
+  readonly logins = new Map<string, PendingOidcLogin>();
+  readonly sessions = new Map<string, OidcSession>();
+  mutations = 0;
+
+  async ready(): Promise<void> {}
+  async putLogin(id: string, login: PendingOidcLogin): Promise<void> {
+    this.mutations += 1;
+    this.logins.set(id, structuredClone(login));
+  }
+  async takeLogin(id: string): Promise<PendingOidcLogin | undefined> {
+    this.mutations += 1;
+    const value = this.logins.get(id);
+    this.logins.delete(id);
+    return value;
+  }
+  async getSession(id: string): Promise<OidcSession | undefined> {
+    return this.sessions.get(id);
+  }
+  async putSession(id: string, session: OidcSession): Promise<void> {
+    this.mutations += 1;
+    this.sessions.set(id, structuredClone(session));
+  }
+  async deleteSession(id: string): Promise<void> {
+    this.mutations += 1;
+    this.sessions.delete(id);
+  }
+
+  digest(): string {
+    const records = {
+      logins: [...this.logins].sort(([left], [right]) => left.localeCompare(right)),
+      sessions: [...this.sessions].sort(([left], [right]) => left.localeCompare(right)),
+    };
+    return createHash('sha256').update(JSON.stringify(records)).digest('hex');
+  }
+}
+
+function fakePool(): DatabasePool {
+  return {
+    query: async () => ({ rows: [{ ssl: true }], rowCount: 1 }),
+  } as unknown as DatabasePool;
+}
+
+function fakeRepository(): GatewayRepository {
+  return {
+    assertPrincipal: async () => undefined,
+    status: async () => ({ online: 1 }),
+    listPresence: async () => [],
+    claimOutbox: async () => [],
+  } as unknown as GatewayRepository;
+}
+
+describe('rollback bridge server-side read-only gate', () => {
+  it('fails closed for every mutating method, websocket upgrade and terminal surface', () => {
+    for (const method of ['POST', 'PUT', 'PATCH', 'DELETE', 'CONNECT', 'TRACE']) {
+      expect(rollbackBridgeAllowsRequest({ method, url: '/v3/messages' })).toBe(false);
+    }
+    expect(rollbackBridgeAllowsRequest({
+      method: 'GET', url: '/v3/ws', upgrade: 'websocket',
+    })).toBe(false);
+    expect(rollbackBridgeAllowsRequest({
+      method: 'GET', url: '/v3/console/terminal/capability',
+    })).toBe(false);
+    expect(rollbackBridgeAllowsRequest({
+      method: 'GET', url: '/v3/console/messages?limit=50',
+    })).toBe(false);
