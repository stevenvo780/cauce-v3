+    expect(rollbackBridgeAllowsRequest({ method: 'HEAD', url: '/v3/auth/login' })).toBe(false);
+    expect(rollbackBridgeAllowsRequest({ method: 'HEAD', url: '/health/live' })).toBe(true);
+    expect(rollbackBridgeAllowsRequest({ method: 'GET', url: '/health/ready?probe=1' })).toBe(true);
+    expect(rollbackBridgeAllowsRequest({ method: 'GET', url: '/metrics' })).toBe(true);
+    expect(rollbackBridgeAllowsRequest({ method: 'OPTIONS', url: '/health/live' })).toBe(false);
+    expect(rollbackBridgeAllowsRequest({
+      method: 'GET', url: '/health/live', connection: 'keep-alive, Upgrade',
+    })).toBe(false);
+  });
+
+  it('keeps all candidate publish intents durable across candidate to baseline bridge to rollforward', async () => {
+    const durableJournal: string[] = [];
+    const candidate = mutableHarness(durableJournal, false);
+    const candidatePublish = await candidate.inject({
+      method: 'POST', url: '/v3/messages', payload: { request_id: 'candidate-intent-a' },
+    });
+    expect(candidatePublish.statusCode).toBe(200);
+    expect(durableJournal).toHaveLength(1);
+    const beforeBridge = JSON.stringify(durableJournal);
+    await candidate.close();
+
+    const bridge = mutableHarness(durableJournal, true);
+    for (const request of [
+      { method: 'POST' as const, url: '/v3/messages', payload: { request_id: 'legacy-retry-a' } },
+      { method: 'POST' as const, url: '/v3/console/config/changes', payload: { revision: 2 } },
+      { method: 'DELETE' as const, url: '/v3/console/terminal/sessions/session-a' },
+    ]) {
+      const response = await bridge.inject(request);
+      expect(response.statusCode).toBe(503);
+      expect(response.headers['retry-after']).toBe('60');
+      expect(response.json()).toEqual({ error: 'rollback_bridge_read_only' });
+    }
+    expect(JSON.stringify(durableJournal)).toBe(beforeBridge);
+    const read = await bridge.inject({ method: 'GET', url: '/v3/console/messages' });
+    expect(read.statusCode).toBe(503);
+    const health = await bridge.inject({ method: 'GET', url: '/health/live' });
+    expect(health.statusCode).toBe(200);
+    expect(health.json()).toEqual({ status: 'live' });
+    await bridge.close();
+
+    const rollforward = mutableHarness(durableJournal, false);
+    const newPublish = await rollforward.inject({
+      method: 'POST', url: '/v3/messages', payload: { request_id: 'candidate-intent-b' },
+    });
+    expect(newPublish.statusCode).toBe(200);
+    expect(durableJournal).toEqual([
+      JSON.stringify({ request_id: 'candidate-intent-a' }),
+      JSON.stringify({ request_id: 'candidate-intent-b' }),
+    ]);
+    await rollforward.close();
+  });
+
+  it('blocks every OIDC GET/HEAD path before session state, journal, cookies or IdP can mutate', async () => {
+    const store = new RecordingOidcStore();
+    const idpCalls: string[] = [];
+    const provider = new OidcBffAuthProvider({
+      issuer: 'https://idp.example',
+      audience: 'cauce-api',
+      jwksUrl: 'https://idp.example/jwks',
+      authorizationEndpoint: 'https://idp.example/authorize',
+      tokenEndpoint: 'https://idp.example/token',
+      clientId: 'cauce-console',
+      redirectUri: 'https://console.example/v3/auth/callback',
+      sessionStore: store,
+      fetcher: async (input) => {
+        idpCalls.push(input instanceof Request ? input.url : input.toString());
+        return new Response(null, { status: 500 });
+      },
+    });
+    const app = await buildGateway({
+      pool: fakePool(),
+      authProvider: provider,
+      repository: fakeRepository(),
+      deliveryWakeSubscriber: async () => async () => undefined,
+    });
+    const journal = ['candidate-intent-a'];
+    const beforeJournal = createHash('sha256').update(JSON.stringify(journal)).digest('hex');
+    const beforeSessions = store.digest();
+    try {
+      for (const request of [
+        { method: 'GET' as const, url: '/v3/auth/login' },
+        { method: 'HEAD' as const, url: '/v3/auth/login' },
+        { method: 'GET' as const, url: '/v3/auth/callback?code=x&state=y' },
+        { method: 'HEAD' as const, url: '/v3/auth/callback?code=x&state=y' },
+        { method: 'GET' as const, url: '/v3/auth/session' },
+        { method: 'HEAD' as const, url: '/v3/auth/session' },
+        { method: 'GET' as const, url: '/v3/status' },
+        { method: 'OPTIONS' as const, url: '/v3/auth/login' },
+      ]) {
+        const response = await app.inject(request);
+        expect(response.statusCode, `${request.method} ${request.url}`).toBe(503);
+        expect(response.headers['cache-control']).toBe('no-store');
