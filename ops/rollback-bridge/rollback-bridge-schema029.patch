--- /dev/null
+++ b/services/gateway/src/rollback-bridge-read-only.ts
@@ -0,0 +1,50 @@
+import type { FastifyReply, FastifyRequest } from 'fastify';
+
+const OPERATIONAL_READ_METHODS = new Set(['GET', 'HEAD']);
+const OPERATIONAL_READ_PATHS = new Set(['/health/live', '/health/ready', '/metrics']);
+
+export interface RollbackBridgeRequestShape {
+  method: string;
+  url: string;
+  upgrade?: string | string[];
+  connection?: string | string[];
+}
+
+/**
+ * The rollback bridge is a diagnostic/read path, never an alternate writer.
+ * Keep this predicate independent from auth and route registration so a legacy
+ * console bundle cannot reach a mutating handler before any client-side feature
+ * or journal capability is known.
+ */
+export function rollbackBridgeAllowsRequest(request: RollbackBridgeRequestShape): boolean {
+  const method = request.method.toUpperCase();
+  if (!OPERATIONAL_READ_METHODS.has(method)) return false;
+
+  const upgrade = Array.isArray(request.upgrade) ? request.upgrade.join(',') : request.upgrade;
+  if (upgrade !== undefined && upgrade.trim() !== '') return false;
+  const connection = Array.isArray(request.connection) ? request.connection.join(',') : request.connection;
+  if (connection?.split(',').some((value) => value.trim().toLowerCase() === 'upgrade')) return false;
+
+  const pathname = request.url.split('?', 1)[0] ?? '';
+  return OPERATIONAL_READ_PATHS.has(pathname);
+}
+
+export async function rollbackBridgeReadOnlyHook(
+  request: FastifyRequest,
+  reply: FastifyReply,
+): Promise<void> {
+  const upgrade = request.headers.upgrade;
+  const connection = request.headers.connection;
+  if (rollbackBridgeAllowsRequest({
