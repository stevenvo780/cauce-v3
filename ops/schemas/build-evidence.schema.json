{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/build-evidence.schema.json",
  "title": "Cauce V3 immutable release build evidence",
  "description": "schemaVersion 5 binds a committed git-archive RC with clean tracked/index state and one exact excluded operator-scratch prefix to registry-recoverable runtime and console digests, per-image source domains, and final-image packaging smoke.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "mechanism",
    "imageDigest",
    "sourceDigest",
    "sourceDigestDomain",
    "operationsDigest",
    "timestamps",
    "dockerfileSha256",
    "dockerignoreSha256",
    "sourceRevision",
    "runtime",
    "console",
    "runtimePackage",
    "schemaCompatibility"
  ],
  "properties": {
    "schemaVersion": { "const": 5 },
    "evidenceClass": { "const": "release-build" },
    "mechanism": { "const": "docker-build-push-pull-final-image" },
    "imageDigest": { "$ref": "#/$defs/digest" },
    "sourceDigest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of the runtime source domain. Top-level because every cross-artifact check in the release gate compares runtime evidence against this value."
    },
    "sourceDigestDomain": { "const": "runtime" },
    "operationsDigest": { "$ref": "#/$defs/digest" },
    "timestamps": { "$ref": "#/$defs/timestamps" },
    "dockerfileSha256": { "$ref": "#/$defs/digest" },
    "dockerignoreSha256": { "$ref": "#/$defs/digest" },
    "sourceRevision": { "$ref": "#/$defs/sourceRevision" },
    "runtime": { "$ref": "#/$defs/runtimeImage" },
    "console": { "$ref": "#/$defs/consoleImage" },
    "runtimePackage": { "$ref": "#/$defs/runtimePackage" },
    "schemaCompatibility": { "$ref": "#/$defs/schemaCompatibility" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "imageReference": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+@sha256:[a-f0-9]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "worktreeStatus", "untrackedPolicy", "excludedUntrackedPresent", "buildContext"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "worktreeStatus": { "const": "tracked-and-index-clean" },
        "untrackedPolicy": { "const": "only-apps-console-src-features-grafo" },
        "excludedUntrackedPresent": { "type": "boolean" },
        "buildContext": { "const": "git-archive" }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "runtimeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "imageId", "imageDigest", "repositoryDigest", "sourceDigest", "sourceDigestDomain"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "imageId": { "$ref": "#/$defs/digest" },
        "imageDigest": { "$ref": "#/$defs/digest" },
        "repositoryDigest": { "$ref": "#/$defs/imageReference" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "sourceDigestDomain": { "const": "runtime" }
      }
    },
    "consoleImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "imageId", "imageDigest", "repositoryDigest", "sourceDigest", "sourceDigestDomain"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "imageId": { "$ref": "#/$defs/digest" },
        "imageDigest": { "$ref": "#/$defs/digest" },
        "repositoryDigest": { "$ref": "#/$defs/imageReference" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "sourceDigestDomain": { "const": "console" }
      }
    },
    "runtimePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "status", "components"],
      "properties": {
        "mechanism": { "const": "docker-run-final-image-package-smoke" },
        "status": { "const": "passed" },
        "components": {
          "type": "array",
          "prefixItems": [
            { "const": "gateway" },
            { "const": "dispatcher" },
            { "const": "relay-worker" },
            { "const": "telegram-bridge" },
            { "const": "shadow-router" },
            { "const": "terminal-relay" },
            { "const": "outbox-metrics" }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "schemaCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "compatibleThrough"],
      "properties": {
        "label": { "const": "io.cauce.schema.compatible-through" },
        "compatibleThrough": {
          "type": "string",
          "pattern": "^[0-9]{3}_[a-z0-9_]+\\.sql$"
        }
      }
    }
  }
}
