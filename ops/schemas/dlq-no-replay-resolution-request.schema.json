{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/dlq-no-replay-resolution-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "id", "evidenceSha256", "reason", "actorTenant", "actorAlias", "possibleDuplicateAcknowledged", "possibleNoDeliveryAcknowledged"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "enum": ["delivery", "outbox"] },
    "id": { "type": "string", "format": "uuid" },
    "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "actorTenant": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "actorAlias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "possibleDuplicateAcknowledged": { "type": "boolean" },
    "possibleNoDeliveryAcknowledged": { "const": true }
  }
}
