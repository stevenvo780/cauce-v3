{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/dlq-reconciliation.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/inspect" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/apply" },
    { "$ref": "#/$defs/post" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "base": {
      "type": "object",
      "required": ["schemaVersion", "suite", "phase", "generatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "suite": { "const": "cauce-v3-dlq-causal-reconciliation" },
        "phase": { "enum": ["inspect", "plan", "apply", "post"] },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind", "disposition", "open", "actionable", "count"],
        "properties": {
          "source": { "enum": ["delivery", "outbox"] },
          "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
          "disposition": { "$ref": "#/$defs/disposition" },
          "open": { "type": "boolean" },
          "actionable": { "type": "boolean" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "disposition": {
      "enum": ["ambiguous", "safe_retry", "missing_final", "auth", "expected_offline", "unclassified"]
    },
    "inspect": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "suite", "phase", "generatedAt", "inventory", "inventorySha256"],
          "properties": {
            "schemaVersion": true, "suite": true, "phase": { "const": "inspect" }, "generatedAt": true,
            "inventory": { "$ref": "#/$defs/inventory" },
            "inventorySha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "plan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "suite", "phase", "generatedAt", "planSha256", "material"],
          "properties": {
            "schemaVersion": true, "suite": true, "phase": { "const": "plan" }, "generatedAt": true,
            "planSha256": { "$ref": "#/$defs/sha256" },
            "material": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "actorSha256", "candidateCount", "candidateSetSha256", "inventory", "transitions"],
              "properties": {
                "schemaVersion": { "const": 1 },
                "actorSha256": { "$ref": "#/$defs/sha256" },
                "candidateCount": { "type": "integer", "minimum": 0 },
                "candidateSetSha256": { "$ref": "#/$defs/sha256" },
                "inventory": { "$ref": "#/$defs/inventory" },
                "transitions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["target", "rule", "toDisposition", "count", "evidenceSha256"],
                    "properties": {
                      "target": { "enum": ["delivery", "outbox"] },
                      "rule": { "type": "string", "pattern": "^[a-z0-9_]+_v[0-9]+$" },
                      "toDisposition": { "$ref": "#/$defs/disposition" },
                      "count": { "type": "integer", "minimum": 1 },
                      "evidenceSha256": { "$ref": "#/$defs/sha256" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "apply": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "suite", "phase", "generatedAt", "planSha256", "alreadyApplied", "transitionCount", "resolvedCount", "recoveredSentCount", "dispositionCount"],
          "properties": {
            "schemaVersion": true, "suite": true, "phase": { "const": "apply" }, "generatedAt": true,
            "planSha256": { "$ref": "#/$defs/sha256" },
            "alreadyApplied": { "type": "boolean" },
            "transitionCount": { "type": "integer", "minimum": 0 },
            "resolvedCount": { "type": "integer", "minimum": 0 },
            "recoveredSentCount": { "type": "integer", "minimum": 0 },
            "dispositionCount": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "post": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "suite", "phase", "generatedAt", "planSha256", "appliedCounts", "inventory", "inventorySha256"],
          "properties": {
            "schemaVersion": true, "suite": true, "phase": { "const": "post" }, "generatedAt": true,
            "planSha256": { "$ref": "#/$defs/sha256" },
            "appliedCounts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transitions", "resolved", "recoveredSent", "dispositions"],
              "properties": {
                "transitions": { "type": "integer", "minimum": 0 },
                "resolved": { "type": "integer", "minimum": 0 },
                "recoveredSent": { "type": "integer", "minimum": 0 },
                "dispositions": { "type": "integer", "minimum": 0 }
              }
            },
            "inventory": { "$ref": "#/$defs/inventory" },
            "inventorySha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  }
}
