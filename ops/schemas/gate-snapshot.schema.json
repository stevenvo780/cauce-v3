{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/gate-snapshot.schema.json",
  "title": "Cauce V3 cutover gate snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenant",
    "alias",
    "capturedAt",
    "v2",
    "v3",
    "drain",
    "acks",
    "queues",
    "roundTrip"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "tenant": { "type": "string", "minLength": 1, "maxLength": 64 },
    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "v2": { "$ref": "#/$defs/consumerState" },
    "v3": { "$ref": "#/$defs/consumerState" },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inflight", "overdueInflight", "ownershipMismatch"],
      "properties": {
        "inflight": { "$ref": "#/$defs/nonNegative" },
        "overdueInflight": { "$ref": "#/$defs/nonNegative" },
        "ownershipMismatch": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "acks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rejectedRecent", "staleAccepted"],
      "properties": {
        "rejectedRecent": { "$ref": "#/$defs/nonNegative" },
        "staleAccepted": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "queues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wakePending", "outboxPending", "relayPending", "dlqOpen", "dlqNewSinceBaseline"],
      "properties": {
        "wakePending": { "$ref": "#/$defs/nonNegative" },
        "outboxPending": { "$ref": "#/$defs/nonNegative" },
        "relayPending": { "$ref": "#/$defs/nonNegative" },
        "dlqOpen": { "$ref": "#/$defs/nonNegative" },
        "dlqNewSinceBaseline": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "roundTrip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedAt", "terminalAckApplied", "activeLeaseMatch"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not-run"] },
        "completedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "terminalAckApplied": { "type": "boolean" },
        "activeLeaseMatch": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "nonNegative": { "type": "integer", "minimum": 0 },
    "consumerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "pollers", "leaseOwners"],
      "properties": {
        "consumers": { "$ref": "#/$defs/nonNegative" },
        "pollers": { "$ref": "#/$defs/nonNegative" },
        "leaseOwners": { "$ref": "#/$defs/nonNegative" }
      }
    }
  }
}
