{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/release-candidate.schema.json",
  "title": "Cauce V3 release-candidate gate separation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "sourceDigest", "sourceDigestDomain", "sourceDigests", "generatedAt", "candidateStatus", "fleet", "gates", "evidence"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "suite": { "const": "cauce-v3-release-candidate" },
    "sourceDigest": {
      "$ref": "#/$defs/digest",
      "description": "Full-domain digest. The candidate aggregates artifacts from every domain, so it is pinned to the union."
    },
    "sourceDigestDomain": { "const": "full" },
    "sourceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "console", "harness", "full"],
      "description": "Every domain digest observed while assembling the candidate, so a reader can re-derive which artifact was checked against which domain.",
      "properties": {
        "runtime": { "$ref": "#/$defs/digest" },
        "console": { "$ref": "#/$defs/digest" },
        "harness": { "$ref": "#/$defs/digest" },
        "full": { "$ref": "#/$defs/digest" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidateStatus": { "enum": ["code-runtime-passed-release-host-blocked", "release-ready"] },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifests", "packagedAdapters"],
      "properties": {
        "manifests": { "const": 15 },
        "packagedAdapters": { "const": 5 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeRuntime", "releaseHost"],
      "properties": {
        "codeRuntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "criticalSkipped", "checks"],
          "properties": {
            "status": { "const": "passed" },
            "criticalSkipped": { "const": 0 },
            "checks": {
              "type": "array",
              "minItems": 7,
              "items": { "$ref": "#/$defs/check" }
            }
          }
        },
        "releaseHost": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason", "prerequisites"],
              "properties": {
                "status": { "const": "blocked" },
                "reason": { "type": "string", "minLength": 1 },
                "prerequisites": {
                  "type": "array",
                  "minItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "status", "description"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
                      "status": { "const": "required-external" },
                      "description": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "criticalSkipped", "checks"],
              "properties": {
                "status": { "const": "passed" },
                "criticalSkipped": { "const": 0 },
                "checks": {
                  "type": "array",
                  "minItems": 5,
                  "contains": {
                    "type": "object",
                    "required": ["name", "status", "evidenceKind"],
                    "properties": {
                      "name": { "const": "durable rollback baseline recovered exact bridge runtime and console image IDs" },
                      "status": { "const": "passed" },
                      "evidenceKind": { "const": "release-build" }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1,
                  "items": { "$ref": "#/$defs/check" }
                }
              }
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "sourceDigest", "sourceDigestDomain"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "sourceDigest": {
            "$ref": "#/$defs/digest",
            "description": "Digest of the domain this artifact actually depends on, NOT the whole tree."
          },
          "sourceDigestDomain": { "enum": ["runtime", "console", "harness", "full"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "candidateStatus": { "const": "release-ready" } }
      },
      "then": {
        "properties": {
          "gates": {
            "properties": { "releaseHost": { "properties": { "status": { "const": "passed" } } } }
          }
        }
      },
      "else": {
        "properties": {
          "gates": {
            "properties": { "releaseHost": { "properties": { "status": { "const": "blocked" } } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidenceKind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "evidenceKind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
      }
    }
  }
}
