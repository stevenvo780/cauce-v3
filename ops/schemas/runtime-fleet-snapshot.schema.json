{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/runtime-fleet-snapshot.schema.json",
  "title": "Desired fleet generation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "snapshotSha256", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "$ref": "#/$defs/digest" },
    "snapshotSha256": { "$ref": "#/$defs/digest" },
    "files": {
      "type": "object",
      "required": ["flota.json", "container-aliases.json", "generated/fleet.json", "schemas/alias-manifest.schema.json"],
      "propertyNames": {
        "pattern": "^(?:flota\\.json|container-aliases\\.json|generated/fleet\\.json|schemas/alias-manifest\\.schema\\.json|manifests/[a-z][a-z0-9-]{0,63}\\.yaml|bootstrap/container-aliases\\.json|bootstrap/manifests/[a-z][a-z0-9-]{0,63}\\.yaml)$"
      },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
