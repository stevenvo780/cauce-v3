{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/telegram-replay-inspect-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "evidenceSha256", "actorTenant", "actorAlias"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actorTenant": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "actorAlias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
  }
}
