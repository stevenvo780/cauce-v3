{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/telegram-replay-inspect.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "phase", "generatedAt", "id", "evidenceSha256", "items", "total"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "cauce-v3-telegram-replay-inspect" },
    "phase": { "const": "inspect" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "format": "uuid" },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "total": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunkIndex", "effectSha256", "state", "replayCount", "duplicateRisk"],
        "properties": {
          "chunkIndex": { "type": "integer", "minimum": 0 },
          "effectSha256": { "$ref": "#/$defs/sha256" },
          "state": { "enum": ["prepared", "ambiguous", "dead"] },
          "replayCount": { "type": "integer", "minimum": 0 },
          "duplicateRisk": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
