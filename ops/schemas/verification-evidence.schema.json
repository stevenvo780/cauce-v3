{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/verification-evidence.schema.json",
  "title": "Cauce V3 reproducible code verification",
  "description": "Bound to the FULL source domain, unlike runtime fault evidence. `pnpm lint | typecheck | build | test` really does exercise every domain: lint:console, typecheck:console and build:console run the console, the console vitest project runs under test:unit, tests/gateway-hardening/console-api-contract.test.ts reads apps/console sources, and ops:validate exercises the harness. Narrowing this artifact to the runtime domain would be the 'covers less' failure: evidence that does not prove what it claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "sourceDigest", "sourceDigestDomain", "timestamps", "summary", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "cauce-v3-verification-three-rounds" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "sourceDigestDomain": { "const": "full" },
    "timestamps": { "$ref": "#/$defs/timestamps" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "passed", "failed", "skipped", "criticalSkipped", "testRounds"],
      "properties": {
        "commands": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "const": 0 },
        "criticalSkipped": { "const": 0 },
        "testRounds": { "const": 3 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "critical", "status", "exitCode", "timestamps", "durationMs"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "critical": { "const": true },
          "status": { "enum": ["passed", "failed"] },
          "exitCode": { "type": "integer" },
          "timestamps": { "$ref": "#/$defs/timestamps" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
