[Unit]
Description=Cauce V3: CI local nocturno — gate completo + validate sobre un worktree desechable (la rama la fija el script, GitHub Actions prohibido por el dueño)

[Service]
Type=oneshot
WorkingDirectory=/datos/workspaces/zeus/cauce-v3
# Runs as root like the whole fleet (root-owned files in the tree broke the stev run at 17s).
# pnpm aborts purging node_modules without a TTY unless CI is set; NO_COLOR keeps journal output parseable.
Environment=CI=true
Environment=NO_COLOR=1
ExecStart=/usr/bin/bash -lc 'umask 022 && exec /datos/workspaces/zeus/cauce-v3/ops/scripts/ci-nocturno.sh'
StandardOutput=journal
StandardError=journal
# Six steps now, one of them a cold `pnpm install` on a throwaway worktree, and scripts/test-all.mjs
# already budgets 40 min for test:integration alone: one hour killed the run before ops:validate.
TimeoutStartSec=14400
