[Unit]
Description=Cauce V3: CI local nocturno — el gate completo + validate sobre main (GitHub Actions prohibido por el dueño)

[Service]
Type=oneshot
WorkingDirectory=/datos/workspaces/zeus/cauce-v3
# Runs as root like the whole fleet (root-owned files in the tree broke the stev run at 17s).
ExecStart=/usr/bin/bash -lc 'umask 022 && git pull --rebase --autostash origin main && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:pty && ops/scripts/validate.sh'
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600
