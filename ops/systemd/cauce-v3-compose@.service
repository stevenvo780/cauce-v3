[Unit]
Description=Cauce V3 Docker Compose stack (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/cauce-v3/ops.env
WorkingDirectory=/opt/cauce-v3/ops
ExecStart=/opt/cauce-v3/ops/scripts/systemd-stack.sh %i start
ExecReload=/opt/cauce-v3/ops/scripts/systemd-stack.sh %i reload
ExecStop=/opt/cauce-v3/ops/scripts/systemd-stack.sh %i stop
TimeoutStartSec=300
TimeoutStopSec=180
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/cauce-v3 /opt/cauce-v3/ops/artifacts /opt/cauce-v3/ops/backups
PrivateTmp=true

[Install]
WantedBy=multi-user.target
