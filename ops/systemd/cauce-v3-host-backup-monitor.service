[Unit]
Description=Cauce V3 backup staleness watchdog (fails loudly if the nightly backup did not succeed recently)
Documentation=file:/opt/cauce-v3/ops/runbooks/backup-restore.md
OnFailure=cauce-v3-backup-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cauce-v3-host-backup-monitor
