{
  "name": "cauce-v3",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "clean": "node --eval \"import('node:fs/promises').then(fs => Promise.all(['dist','ops/artifacts'].map(path => fs.rm(path,{recursive:true,force:true}))))\"",
    "prepare": "pnpm prepare:runtime",
    "prepare:runtime": "pnpm --filter @cauce/protocol build",
    "build:core": "pnpm prepare:runtime && tsc -p tsconfig.build.json",
    "build:adapter": "pnpm --filter @cauce/adapter-sdk build",
    "build:console": "pnpm --filter @cauce/console build",
    "build": "pnpm build:core && pnpm build:adapter && pnpm build:console",
    "lint:core": "eslint packages/protocol packages/store services tests vitest.config.ts --max-warnings 0",
    "lint:adapter": "eslint packages/adapter-sdk/src packages/adapter-sdk/test --max-warnings 0",
    "lint:console": "pnpm --filter @cauce/console lint",
    "lint": "pnpm lint:core && pnpm lint:adapter && pnpm lint:console",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:adapter": "pnpm --filter @cauce/adapter-sdk typecheck",
    "typecheck:console": "pnpm --filter @cauce/console typecheck",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:adapter && pnpm typecheck:console",
    "test": "pnpm test:unit && pnpm test:services && pnpm test:gateway-hardening && pnpm test:store-hardening && pnpm test:integration && pnpm test:e2e",
    "test:unit": "pnpm prepare:runtime && vitest run tests/unit && pnpm --filter @cauce/adapter-sdk test && pnpm --filter @cauce/console test",
    "test:services": "pnpm prepare:runtime && pnpm --filter @cauce/gateway test && pnpm --filter @cauce/dispatcher test && pnpm --filter @cauce/shadow-router test && pnpm --filter @cauce/telegram-bridge test",
    "test:gateway-hardening": "pnpm prepare:runtime && vitest run tests/gateway-hardening --testTimeout=120000",
    "test:store-hardening": "pnpm prepare:runtime && ./scripts/test.sh tests/store-hardening --testTimeout=180000",
    "test:integration": "pnpm prepare:runtime && ./scripts/test.sh tests/integration --testTimeout=120000",
    "test:e2e": "pnpm prepare:runtime && pnpm build:adapter && ./scripts/test.sh tests/e2e --testTimeout=180000",
    "test:fleet-release": "pnpm prepare:runtime && pnpm build:adapter && ./scripts/test.sh tests/fleet-release --testTimeout=120000 && python3 ops/scripts/validate-fleet-release-evidence.py",
    "verify:three-rounds": "node ops/scripts/verification-rounds.mjs",
    "qa:real": "node ops/harness/runner.mjs --live --artifact-dir ops/artifacts/real",
    "qa:contract": "node ops/harness/contract-runner.mjs --mock --artifact-dir ops/artifacts/mock",
    "qa:testcontainers": "./ops/scripts/run-testcontainers.sh",
    "qa:compose-authentic": "./ops/scripts/smoke-compose-authentic.sh",
    "qa:runtime-authentic": "./ops/scripts/smoke-runtime-authentic.sh",
    "qa:runtime-packaging": "./deploy/smoke-runtime-packaging.sh",
    "ops:validate": "./ops/scripts/validate.sh",
    "ops:manifests": "python3 ops/scripts/validate-manifests.py && python3 ops/scripts/generate-units.py && python3 ops/scripts/generate-container-units.py",
    "test:container-supervisor": "node ops/tests/container-supervisor.test.mjs",
    "test:container-cutover": "node ops/tests/container-cutover.test.mjs",
    "evidence:release-candidate": "python3 ops/scripts/release-candidate.py",
    "dev:gateway": "pnpm prepare:runtime && tsx services/gateway/src/main.ts",
    "dev:dispatcher": "pnpm prepare:runtime && tsx services/dispatcher/src/main.ts",
    "dev:relay-worker": "pnpm prepare:runtime && tsx services/relay-worker/src/main.ts",
    "dev:shadow-router": "pnpm prepare:runtime && tsx services/shadow-router/src/main.ts",
    "dev:telegram-bridge": "pnpm prepare:runtime && tsx services/telegram-bridge/src/main.ts",
    "migrate": "pnpm prepare:runtime && tsx packages/store/src/migrate-cli.ts"
  },
  "devDependencies": {
    "@cauce/adapter-sdk": "workspace:*",
    "@cauce/protocol": "workspace:*",
    "@cauce/store": "workspace:*",
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.31.0",
    "testcontainers": "^11.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
