{
  "name": "cauce-v3",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "clean": "node --eval \"import('node:fs/promises').then(fs => Promise.all(['dist','ops/artifacts'].map(path => fs.rm(path,{recursive:true,force:true}))))\"",
    "prepare": "pnpm prepare:runtime",
    "prepare:runtime": "node scripts/guardia-no-root.mjs && pnpm --filter @cauce/protocol build",
    "build:core": "pnpm prepare:runtime && tsc -p tsconfig.build.json",
    "build:adapter": "pnpm --filter @cauce/adapter-sdk build",
    "build:console": "pnpm --filter @cauce/console build",
    "build:mcp": "pnpm --filter @cauce/mcp-fleet-monitor build",
    "build": "pnpm build:core && pnpm build:adapter && pnpm build:mcp && pnpm build:console",
    "lint:core": "eslint packages/protocol packages/store services tests vitest.config.ts --max-warnings 0",
    "lint:adapter": "eslint packages/adapter-sdk/src packages/adapter-sdk/test --max-warnings 0",
    "lint:mcp": "eslint packages/mcp-fleet-monitor/src --max-warnings 0",
    "lint:console": "pnpm --filter @cauce/console lint",
    "lint": "pnpm lint:core && pnpm lint:adapter && pnpm lint:mcp && pnpm lint:console && pnpm lint:ops && pnpm lint:tooling && pnpm lint:py && pnpm lint:calidad",
    "lint:calidad": "node scripts/calidad.mjs",
    "lint:ops": "eslint ops/harness ops/patches ops/scripts ops/tests --max-warnings 0",
    "lint:tooling": "eslint scripts deploy --max-warnings 0",
    "lint:py": "ruff check --select E9,F ops scripts deploy",
    "lint:estricto": "eslint -c eslint.estricto.config.js packages services console tests",
    "lint:py:estricto": "ruff check ops scripts deploy",
    "grafo": "node scripts/grafo.mjs",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:adapter": "pnpm --filter @cauce/adapter-sdk typecheck",
    "typecheck:mcp": "pnpm --filter @cauce/mcp-fleet-monitor typecheck",
    "typecheck:console": "pnpm --filter @cauce/console typecheck",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:adapter && pnpm typecheck:mcp && pnpm typecheck:console",
    "test": "node scripts/test-all.mjs",
    "test:unit": "pnpm prepare:runtime && pnpm --no-bail --filter @cauce/adapter-sdk --filter @cauce/mcp-fleet-monitor --filter @cauce/console run test && vitest run tests/unit packages/protocol/test",
    "test:terminal-pty": "pnpm prepare:runtime && vitest run tests/terminal-pty",
    "test:pty": "python3 -m unittest discover -s ops/pty-agent",
    "test:services": "pnpm prepare:runtime && pnpm --no-bail --filter @cauce/gateway --filter @cauce/dispatcher --filter @cauce/telegram-bridge --filter @cauce/terminal-relay run test",
    "test:gateway-hardening": "pnpm prepare:runtime && vitest run tests/gateway-hardening --testTimeout=120000",
    "test:store-hardening": "pnpm prepare:runtime && ./scripts/test.sh tests/store-hardening packages/store/test --testTimeout=180000",
    "test:integration": "pnpm prepare:runtime && pnpm build:mcp && ./scripts/test.sh tests/integration --testTimeout=120000",
    "test:e2e": "pnpm prepare:runtime && pnpm build:adapter && ./scripts/test.sh tests/e2e --testTimeout=180000",
    "qa:real": "node ops/harness/runner.mjs --live --artifact-dir ops/artifacts/real",
    "qa:contract": "node ops/harness/contract-runner.mjs --mock --artifact-dir ops/artifacts/mock",
    "qa:testcontainers": "./ops/scripts/run-testcontainers.sh",
    "qa:runtime-packaging": "./deploy/smoke-runtime-packaging.sh",
    "ops:validate": "./ops/scripts/validate.sh",
    "ops:manifests": "python3 ops/scripts/validate-manifests.py && python3 ops/scripts/generate-units.py && python3 ops/scripts/generate-container-units.py --rootless --home /home/dev --output ops/generated/container-systemd/rootless",
    "test:container-supervisor": "node ops/tests/container-supervisor.test.mjs",
    "test:container-cutover": "node ops/tests/container-cutover.test.mjs",
    "dev:gateway": "pnpm prepare:runtime && tsx services/gateway/src/main.ts",
    "dev:dispatcher": "pnpm prepare:runtime && tsx services/dispatcher/src/main.ts",
    "dev:telegram-bridge": "pnpm prepare:runtime && tsx services/telegram-bridge/src/main.ts",
    "migrate:dev": "pnpm prepare:runtime && tsx packages/store/src/migrate-cli.ts",
    "console:user": "pnpm prepare:runtime && tsx services/gateway/src/console-user-cli.ts"
  },
  "devDependencies": {
    "@cauce/adapter-sdk": "workspace:*",
    "@cauce/protocol": "workspace:*",
    "@cauce/store": "workspace:*",
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "eslint": "^9.31.0",
    "testcontainers": "^11.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
