{
  "schema_version": 1,
  "harness": "agy",
  "operations": {
    "install": "runtime-package",
    "execute": "native-execution",
    "authenticate": "provider-login"
  },
  "context": {
    "native_document": "AGENTS.md",
    "max_bytes": 65536
  },
  "provider": {
    "authenticate_argv": [
      "/usr/local/bin/agy"
    ],
    "verify_argv": [
      "/usr/local/bin/agy",
      "models"
    ]
  }
}
