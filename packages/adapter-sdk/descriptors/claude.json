{
  "schema_version": 1,
  "harness": "claude",
  "operations": {
    "install": "runtime-package",
    "execute": "native-execution",
    "authenticate": "provider-login",
    "update": "provider-update",
    "quota": "quota-collector"
  },
  "context": {
    "native_document": "CLAUDE.md",
    "max_bytes": 65536
  },
  "provider": {
    "authenticate_argv": [
      "/usr/local/bin/claude",
      "auth",
      "login"
    ],
    "quota_argv": [
      "/usr/local/bin/node",
      "/usr/local/bin/leer-cuota.mjs"
    ],
    "update_package": "@anthropic-ai/claude-code",
    "fleet_module": null
  }
}
