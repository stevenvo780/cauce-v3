{
  "schema_version": 1,
  "harness": "codex",
  "operations": {
    "install": "runtime-package",
    "execute": "native-execution",
    "authenticate": "provider-login",
    "update": "provider-update",
    "quota": "quota-collector"
  },
  "context": {
    "native_document": "AGENTS.md",
    "max_bytes": 65536
  },
  "provider": {
    "authenticate_argv": [
      "/usr/local/bin/codex",
      "login",
      "--device-auth"
    ],
    "quota_argv": [
      "/usr/local/bin/codex-http-probe.py",
      "/home/node/.codex"
    ],
    "update_package": "@openai/codex",
    "fleet_module": null
  }
}
