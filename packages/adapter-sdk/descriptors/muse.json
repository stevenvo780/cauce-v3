{
  "schema_version": 1,
  "harness": "muse",
  "operations": {
    "install": "runtime-package",
    "execute": "native-execution",
    "authenticate": "provider-login",
    "update": "provider-update",
    "quota": "quota-collector"
  },
  "context": {
    "native_document": "AGENTS.md",
    "max_bytes": 65536
  },
  "provider": {
    "authenticate_argv": [
      "/usr/local/bin/muse",
      "login"
    ],
    "verify_argv": [
      "/usr/local/bin/verificar-muse.py"
    ],
    "quota_argv": [
      "/usr/local/bin/leer-cuota-muse"
    ],
    "update_argv": [
      "/usr/local/bin/actualizar-muse"
    ],
    "fleet_module": "fleet_provider_muse"
  }
}
