{
  "schema_version": 1,
  "harness": "muse",
  "adapter_executable": "cauce-adapter-muse",
  "harness_executable": "$CAUCE_MUSE_EXECUTABLE",
  "invocation": {
    "prompt_transport": "stdin",
    "fixed_args": ["serve", "--trust-workspace"],
    "output_dialect": "msp-session-view",
    "session_mapping": "generated durable UUIDv7; MSP session/start then session/resume",
    "session_scope": "authenticated tenant+actor+origin channel/session/conversation",
    "approval_mode": "denyUnmatched",
    "workspace_env": "CAUCE_MUSE_WORKSPACE",
    "config_home_env": "CAUCE_MUSE_CONFIG_HOME",
    "data_home_env": "CAUCE_MUSE_DATA_HOME",
    "model_env": "CAUCE_MUSE_MODEL",
    "reasoning_effort_env": "CAUCE_MUSE_REASONING_EFFORT"
  },
  "capabilities": {
    "protocol_version": "3.0",
    "harness": "muse",
    "structured_output": true,
    "stdin_prompt": true,
    "durable_inbox": true,
    "durable_outbox": true,
    "idempotent_delivery": true,
    "heartbeat": true,
    "cancellation": "process_group",
    "fencing_epoch": true,
    "origin_relay": true,
    "attempt_scoped_delivery": true,
    "event_id_correlation": true,
    "claim_token_correlation": true,
    "authenticated_session_scope": true,
    "routing_targets_v1": true,
    "renewable_delivery_claims_v1": true,
    "delegation_feedback_v1": true,
    "agent_identity_v1": true,
    "agent_profile_v1": true,
    "agent_profile_adoption_v1": true,
    "attachments_v1": true,
    "persistent_sessions": true
  }
}
