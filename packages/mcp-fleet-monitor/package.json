{
  "name": "@cauce/mcp-fleet-monitor",
  "version": "1.0.0",
  "description": "MCP server for fleet monitoring: read-only tools for alias state, deliveries, chains, and health",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
