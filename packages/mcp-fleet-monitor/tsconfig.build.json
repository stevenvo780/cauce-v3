{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.fixtures.ts",
    "**/*-test-fixtures.ts",
    "**/test-fixtures/**",
    "**/test-support/**"
  ]
}
