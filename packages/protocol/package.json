{
  "name": "@cauce/protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./fleet-operation": {
      "types": "./src/fleet-operation.ts",
      "import": "./dist/fleet-operation.js"
    },
    "./configuration": {
      "types": "./src/configuration.ts",
      "import": "./dist/configuration.js"
    },
    "./native-admin": {
      "types": "./src/native-admin.ts",
      "import": "./dist/native-admin.js"
    },
    "./harness-consumption": {
      "types": "./src/harness-consumption.ts",
      "import": "./dist/harness-consumption.js"
    },
    "./client-provenance": {
      "types": "./src/schemas/client-provenance.ts",
      "import": "./dist/schemas/client-provenance.js"
    },
    "./agent-preferences": {
      "types": "./src/schemas/agent-preferences.ts",
      "import": "./dist/schemas/agent-preferences.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "zod": "^4.0.10" },
  "devDependencies": { "typescript": "^5.8.3" }
}
