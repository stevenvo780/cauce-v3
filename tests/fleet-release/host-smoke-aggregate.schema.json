{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/host-smoke-aggregate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "sourceDigest", "sourceDigestDomain", "controlPlaneHost", "policy", "finishedAt", "fleet", "summary", "hosts", "violations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "cauce-v3-host-smoke-aggregate" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "sourceDigestDomain": { "const": "runtime" },
    "controlPlaneHost": { "type": "string", "minLength": 1 },
    "policy": { "const": "OpenClaw evidence is required only on hosts assigned OpenClaw manifests" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "harnessCounts", "openClawEvidenceHosts", "controlPlaneOpenClawRequired"],
      "properties": {
        "aliases": { "const": 12 },
        "harnessCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openclaw", "claude", "hermes", "codex", "opencode"],
          "properties": {
            "openclaw": { "const": 5 },
            "claude": { "const": 1 },
            "hermes": { "const": 1 },
            "codex": { "const": 5 },
            "opencode": { "const": 0 }
          }
        },
        "openClawEvidenceHosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "controlPlaneOpenClawRequired": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "passed", "failed", "violations"],
      "properties": {
        "hosts": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "role", "aliases", "requiredHarnesses", "openClawRequired", "status", "violations"],
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "role": { "enum": ["control-plane", "adapter-host"] },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "uniqueItems": true },
          "requiredHarnesses": { "type": "array", "items": { "$ref": "#/$defs/harness" }, "uniqueItems": true },
          "openClawRequired": { "type": "boolean" },
          "status": { "enum": ["passed", "failed"] },
          "violations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "violations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "harness": { "enum": ["openclaw", "claude", "hermes", "codex", "opencode"] }
  }
}
