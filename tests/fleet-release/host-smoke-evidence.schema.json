{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cauce.invalid/schemas/host-smoke-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "sourceDigest", "host", "scope", "startedAt", "finishedAt", "manifests", "summary", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "cauce-v3-host-harness-smoke" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "scope": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "harness", "path", "sha256"],
        "properties": {
          "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "harness": { "$ref": "#/$defs/harness" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "passed", "failed"],
      "properties": {
        "checks": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["harness", "status", "evidenceClass", "durationMs"],
        "properties": {
          "harness": { "$ref": "#/$defs/harness" },
          "status": { "enum": ["passed", "failed"] },
          "evidenceClass": { "enum": ["harness-authentic", "harness-double"] },
          "executable": { "type": "string" },
          "binarySha256": { "$ref": "#/$defs/sha256" },
          "version": { "$ref": "#/$defs/probe" },
          "help": { "$ref": "#/$defs/probe" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "error": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "harness": { "enum": ["openclaw", "claude", "hermes", "codex", "opencode"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
