{
  "contract": "cauce-v3/pty-wire/v1",
  "frozen": true,
  "note": "Golden interoperability vectors for the Cauce V3 PTY channel. The gateway (TypeScript), the terminal-relay (TypeScript) and the pty-agent (Python 3 stdlib) must all reproduce these byte for byte. Do not 'recompute a better value': a mismatch is a protocol divergence, not a stale fixture.",
  "master_key_b64": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
  "hkdf": {
    "hash": "sha256",
    "salt_utf8": "cauce-v3/pty-ticket/v1",
    "info_template": "pty:<tenant>:<alias>",
    "length": 32
  },
  "framing": {
    "header": "[tag:1][length:4 big-endian uint32][payload]",
    "max_payload": 65536,
    "session_id_bytes": 36,
    "tags": {
      "AGENT_HELLO": 1, "HELLO_ACK": 2, "OPEN": 16, "OPEN_OK": 17, "OPEN_ERR": 18,
      "STDIN": 32, "STDOUT": 33, "RESIZE": 34, "CLOSE": 48, "CLOSED": 49,
      "PING": 64, "PONG": 65
    }
  },
  "ws_close_codes": {
    "protocol_error": 4400,
    "ticket_invalid": 4401,
    "revoked": 4403,
    "agent_offline": 4404,
    "idle_timeout": 4408,
    "session_conflict": 4409,
    "output_flood": 4413,
    "ttl_expired": 4423,
    "internal_error": 1011
  },
  "keys": {
    "Steven:jarvis": "33ab99cc766ee43031f9c22b8db78aeae5b04bc0ebedddfe8539330af7233efa",
    "Steven:kant": "c13362c6964d27b97b5af6d39b1f296b45256ada814babf03d49f7b115f49f3d",
    "Miguel:kratos": "38343b3ec054f31888da2867c237bc2d7743054dd24a7839f32c2f61409b37b5"
  },
  "cases": [
    {
      "name": "hkdf/steven-jarvis-golden",
      "kind": "derive_alias_key",
      "must_fail": false,
      "input": { "master_key_b64": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=", "tenant": "Steven", "alias": "jarvis" },
      "expected": { "alias_key_hex": "33ab99cc766ee43031f9c22b8db78aeae5b04bc0ebedddfe8539330af7233efa" }
    },
    {
      "name": "hkdf/steven-kant",
      "kind": "derive_alias_key",
      "must_fail": false,
      "input": { "master_key_b64": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=", "tenant": "Steven", "alias": "kant" },
      "expected": { "alias_key_hex": "c13362c6964d27b97b5af6d39b1f296b45256ada814babf03d49f7b115f49f3d" }
    },
    {
      "name": "hkdf/miguel-kratos-is-a-different-key",
      "kind": "derive_alias_key",
      "must_fail": false,
      "input": { "master_key_b64": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=", "tenant": "Miguel", "alias": "kratos" },
      "expected": { "alias_key_hex": "38343b3ec054f31888da2867c237bc2d7743054dd24a7839f32c2f61409b37b5" }
    },
    {
      "name": "hkdf/master-key-must-be-32-bytes",
      "kind": "derive_alias_key",
      "must_fail": true,
      "input": { "master_key_b64": "AAECAwQFBgcICQoLDA0ODw==", "tenant": "Steven", "alias": "jarvis" },
      "expected": { "reason": "bad_master_key" }
    },
    {
      "name": "ticket/canonical-payload-key-order",
      "kind": "canonical_payload",
      "must_fail": false,
      "input": {
        "payload": {
          "v": 1,
          "sid": "11111111-2222-3333-4444-555555555555",
          "op": "unattributed:console-basic-auth",
          "sub": "Steven:kant",
          "tgt": { "tenant": "Steven", "alias": "jarvis", "container": "claw", "generation": "gen-1", "image": "sha256:deadbeef", "uid": 1000, "user": "claw" },
          "mode": "shell",
          "iat": 1750000000,
          "exp": 1750000030
        }
      },
      "expected": {
        "payload_json": "{\"v\":1,\"sid\":\"11111111-2222-3333-4444-555555555555\",\"op\":\"unattributed:console-basic-auth\",\"sub\":\"Steven:kant\",\"tgt\":{\"tenant\":\"Steven\",\"alias\":\"jarvis\",\"container\":\"claw\",\"generation\":\"gen-1\",\"image\":\"sha256:deadbeef\",\"uid\":1000,\"user\":\"claw\"},\"mode\":\"shell\",\"iat\":1750000000,\"exp\":1750000030}"
      }
    },
    {
      "name": "ticket/canonical-payload-rejects-unknown-key",
      "kind": "canonical_payload",
      "must_fail": true,
      "input": {
        "payload": {
          "v": 1,
          "sid": "11111111-2222-3333-4444-555555555555",
          "op": "unattributed:console-basic-auth",
          "sub": "Steven:kant",
          "tgt": { "tenant": "Steven", "alias": "jarvis", "container": "claw", "generation": "gen-1", "image": "sha256:deadbeef", "uid": 1000, "user": "claw" },
          "mode": "shell",
          "iat": 1750000000,
          "exp": 1750000030,
          "scope": "admin"
        }
      },
      "expected": { "reason": "unknown_payload_key" }
    },
    {
