      }
    },
    {
      "name": "ticket/mint-is-key-bound-same-payload-other-alias-key",
      "kind": "mint_ticket",
      "must_fail": false,
      "input": {
        "alias_key_hex": "c13362c6964d27b97b5af6d39b1f296b45256ada814babf03d49f7b115f49f3d",
        "payload": {
          "v": 1,
          "sid": "11111111-2222-3333-4444-555555555555",
          "op": "unattributed:console-basic-auth",
          "sub": "Steven:kant",
          "tgt": { "tenant": "Steven", "alias": "jarvis", "container": "claw", "generation": "gen-1", "image": "sha256:deadbeef", "uid": 1000, "user": "claw" },
          "mode": "shell",
          "iat": 1750000000,
          "exp": 1750000030
        }
      },
      "expected": {
        "ticket": "v1..JYEJFp4RFVLLBtmjTXMVAuto6w6WGKk2HMNMCX7xUIo"
      }
    },
    {
      "name": "ticket/verify-golden-inside-the-window",
      "kind": "verify_ticket",
      "must_fail": false,
      "input": {
        "alias_key_hex": "33ab99cc766ee43031f9c22b8db78aeae5b04bc0ebedddfe8539330af7233efa",
        "ticket": "v1..034UhsCFtCkD-mxdU51meZwH44SLyjrD1PT26ikM3iY",
        "options": { "now": 1750000015, "session_id": "11111111-2222-3333-4444-555555555555", "tenant": "Steven", "alias": "jarvis", "container_id": "claw", "generation": "gen-1", "modes": ["shell", "readonly"] }
      },
      "expected": { "ok": true, "sid": "11111111-2222-3333-4444-555555555555", "alias": "jarvis", "uid": 1000, "user": "claw", "mode": "shell" }
    },
    {
      "name": "ticket/verify-exactly-at-exp-is-still-valid",
      "kind": "verify_ticket",
      "must_fail": false,
      "input": {
        "alias_key_hex": "33ab99cc766ee43031f9c22b8db78aeae5b04bc0ebedddfe8539330af7233efa",
        "ticket": "v1..034UhsCFtCkD-mxdU51meZwH44SLyjrD1PT26ikM3iY",
        "options": { "now": 1750000030, "alias": "jarvis" }
      },
      "expected": { "ok": true, "sid": "11111111-2222-3333-4444-555555555555", "alias": "jarvis", "uid": 1000, "user": "claw", "mode": "shell" }
