        "payload": {
          "v": 1,
          "sid": "11111111-2222-3333-4444-555555555555",
          "op": "unattributed:console-basic-auth",
          "sub": "Steven:kant",
          "tgt": { "tenant": "Steven", "alias": "jarvis", "container": "claw", "generation": "gen-1", "image": "sha256:deadbeef", "uid": 1000, "user": "claw" },
