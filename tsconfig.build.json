{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false
  },
  "exclude": [
    "tests",
    "**/*.test.ts",
    "**/*.fixtures.ts",
    "**/*-test-fixtures.ts",
    "**/test-fixtures/**"
  ]
}
